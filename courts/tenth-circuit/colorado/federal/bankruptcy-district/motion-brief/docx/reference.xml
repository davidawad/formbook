<!-- The Bankr. D. Colo. motion's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face of the
     typst template ({font}, Times New Roman; no Local Bankruptcy Rule names a face, size or spacing, COB-FORM-002) at
     12 pt (size 24 half points, footnotes included; the D.C.COLO.LCivR 10.1 proxy, README); Body Text in exact 24 pt
     line boxes (typst pitch-double, the proxy's double spacing) with a half-inch first-line indent; the court title,
     caption, title, heading, quotation, footnote and signature lines in 13.8 pt boxes (typst pitch-single), 7 pt
     between footnotes (typst note-gap); letter page with a 1.5-inch top margin and 1-inch margins elsewhere (the
     proxy) and a centered 11 pt page number at the bottom, 731 twips above the page foot (where LibreOffice sets its
     baseline as typst does, footer-descent 30 %: an 11 pt number in a 13.8 pt line box). Added: Body Text Note (a
     paragraph that anchors a footnote, without widow control: typst moves such a paragraph's last line on alone with
     its note), Body Text Last (the last paragraph, kept whole with the signature block a double line below it), and
     Footnote Text that may split where typst splits a note. The markdown is read as CommonMark with footnotes, as
     cmarker reads it. docx/cob-motion-brief.lua writes every other paragraph's own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" pandoc-from="commonmark+smart+footnotes+yaml_metadata_block" size="24" body="480" single="276" indent="720" heading="276" heading-before="276" heading-after="276" quote="276" note="276" note-after="140" footer="731">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextLast"><w:name w:val="Body Text Last"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:after="480"/></w:pPr></w:style>
<w:style w:type="paragraph" w:styleId="FootnoteText"><w:name w:val="Footnote Text"/><w:basedOn w:val="Normal"/><w:next w:val="FootnoteText"/><w:uiPriority w:val="9"/><w:unhideWhenUsed/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="140" w:line="276" w:lineRule="exact"/></w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
