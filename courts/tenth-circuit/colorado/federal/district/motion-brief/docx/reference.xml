<?xml version="1.0" encoding="UTF-8"?>
<!-- The D. Colo. motion's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face of the typst
     template ({font}, Liberation Sans, Arial's metrics, the audited exemplar's face; D.C.COLO.LCivR 10.1(d) names
     none) at 12 pt (size 24 half points, LCivR 10.1(d): not less than 12-point, footnotes included); Body Text in
     exact 24 pt line boxes (typst pitch-double, LCivR 10.1(e) double spaced) with a half-inch first-line indent; the
     court title, caption, heading, quotation, footnote and signature lines in 13.8 pt boxes (typst pitch-single),
     7 pt between footnotes (typst note-gap). Added: Body Text First (the body's first paragraph, a double line below
     the caption), Body Text Note (a paragraph that anchors a footnote, without widow control: typst moves such a
     paragraph's last line on alone with its note), Body Text Keep (the last paragraph, kept whole with the signature
     block), and Footnote Text that may split where typst splits a note. Letter page (LCivR 10.1(b)) with a 1 1/2
     inch top margin and 1 inch left, right and bottom margins (LCivR 10.1(c)), and a centered page number at the
     bottom, its line 36 pt above the page foot (720 twips: where typst sets it, footer-descent 30 %).
     docx/cod-motion-brief.lua writes every other paragraph's own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="276" indent="720" heading="276" heading-before="276" heading-after="276" quote="276" note="276" note-after="140" footer="720">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextFirst"><w:name w:val="Body Text First"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:spacing w:before="480"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextKeep"><w:name w:val="Body Text Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<w:style w:type="paragraph" w:styleId="FootnoteText"><w:name w:val="Footnote Text"/><w:basedOn w:val="Normal"/><w:next w:val="FootnoteText"/><w:uiPriority w:val="9"/><w:unhideWhenUsed/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="140" w:line="276" w:lineRule="exact"/></w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
<w:sectPr><w:footerReference w:type="default" r:id="rIdFooter1"/><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="2160" w:right="1440" w:bottom="1440" w:left="1440" w:header="720" w:footer="720" w:gutter="0"/></w:sectPr>
</reference>
