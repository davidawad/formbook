// Motion to dismiss with its memorandum, for the U.S. District Court for the District of Colorado (cod), on the
// generic FRCP brief with D. Colo.'s local rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`,
// fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`).
// Content-agnostic: no case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LCivR 10.1(d): not less than 12-point font; the rule names no face: Liberation Sans, Arial's metrics, the audited
// exemplar's face (data/exemplar-fonts.json; docs/FONTS.md). Vendored in /fonts.
#let font-family = "Liberation Sans"

// Footnote marks always synthesized (raised, 58 %), as LaTeX and Word set them: Liberation Sans has superscript glyphs
// for some digits (4, 5), which typst would take instead, a few points narrower.
#let cod-motion-brief(meta, body) = {
  set super(typographic: false)
  xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
}
