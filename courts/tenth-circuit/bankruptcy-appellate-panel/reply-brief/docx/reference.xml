<?xml version="1.0" encoding="UTF-8"?>
<!-- The bap10 brief's Word styles; fb render builds docx/reference.docx from pandoc's default reference with them
     (tools/fb/src/docxref.rs), matching typst/bap10-reply-brief.typ: Liberation Serif 14 pt everywhere (the typst
     face, vendored in fonts/; footnotes included, L.R. 8015-1(b)); body lines exact at 628 twips (31.4 pt, the typst
     body pitch of 2.245 em: double spacing, FRBP 8015(a)(4)) with a 0.5 in first-line indent; headings, block
     quotations, footnotes, cover and front matter single spaced; section headings 16 pt bold capitals, centered;
     letter paper, 1 in margins. The footers and the last section are fb render's (rIdFtrNone, rIdFtrPage;
     docx/bap10.lua writes FORMBOOK_FINAL). -->
