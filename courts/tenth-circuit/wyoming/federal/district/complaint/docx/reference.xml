<?xml version="1.0" encoding="UTF-8"?>
<!-- The D. Wyo. complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md,
     "Cross-engine gate") in the face of the typst template ({font}, Times New Roman; LR 10.1(a) names no face) at
     12 pt (size 24 half points; LR 10.1(a): not less than 12 point); Body Text in exact 24 pt line boxes (480 twips:
     typst pitch-body, double spacing, LR 10.1(a)) with a half-inch first-line indent; single lines in 13.8 pt boxes
     (276 twips: typst pitch-single). Letter page with one-inch margins (LR 10.1(a)), the page number centred at 12 pt
     on every page in a single-pitch line whose box ends 0.5 in above the page edge (typst footer-distance).
     docx/wyd.lua writes every paragraph's own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="276" indent="720" heading="480" heading-before="240" heading-after="0" footer="720">
<footer id="rIdFooter1"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:jc w:val="center"/></w:pPr><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:r><w:t>1</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r></w:p></footer>
</reference>
