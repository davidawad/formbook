// Memorandum in support of a dispositive motion, for the U.S. District Court for the District of Wyoming (wyd), on the
// generic FRCP brief with D. Wyo.'s local rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`,
// fb-595.17.20), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`).
// Content-agnostic: no case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LR 10.1(a): type not less than 12 point; no face named: Times New Roman, the house standard (docs/FONTS.md; the
// exemplar's Century Schoolbook is that filer's style). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let wyd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
