<?xml version="1.0" encoding="UTF-8"?>
<!-- The D. Utah motion's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md,
     "Cross-engine gate") in the face of the typst template ({font}, Times New Roman; DUCivR 10-1(3) names no face) at
     12 pt (size 24 half points, DUCivR 10-1(3)); Body Text in exact 24 pt line boxes (480 twips: typst pitch-body,
     double spacing, DUCivR 10-1(4)) with a half-inch first-line indent; single lines in 13.8 pt boxes (276 twips: typst
     pitch-single); footnotes at 12 pt (DUCivR 10-1(3): footnotes included) single-spaced in 13.8 pt boxes, 6 pt after
     each (typst note-gap), kept whole. Styles added: Body Text Noted, Body Text without widow control, for a paragraph
     that holds a footnote mark; Body Text Keep, such a paragraph in the conclusion, kept with the signature block (typst:
     one unbreakable block). docx/utd-motion-brief.lua writes the section (letter page, top margin 1 1/2 in and the others 1 in,
     DUCivR 10-1(1)) and the page-number footer (centred at 12 pt on every page, DUCivR 10-1(5), in a single-pitch line
     whose box ends 0.5 in above the page edge, typst footer-distance), since its passes replace the last section; it
     writes the cover, the motion, the tables, the headings, the
     lists and the signature with their own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="276" indent="720" heading="480" heading-before="0" heading-after="0" note="276" note-size="24" note-after="120" footer="720">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNoted"><w:name w:val="Body Text Noted"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextKeep"><w:name w:val="Body Text Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
</reference>
