// Motion and supporting memorandum for the U.S. District Court for the District of Utah (utd), on the generic FRCP
// brief with D. Utah's local rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`, fb-595.17,
// fb-595.92), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`).
// Content-agnostic: no case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// DUCivR 10-1(3) names no face; Times New Roman, the house standard (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let utd-motion-brief(meta, body) = {
  // DUCivR 7-1(a)(1)(B): the memorandum, after the motion, opens with its heading
  assert(body.match(regex("(?m)^# +MEMORANDUM")) != none,
    message: "utd-motion-brief: the body needs a `# MEMORANDUM OF LAW` heading (DUCivR 7-1(a)(1)(B))")
  xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
}
