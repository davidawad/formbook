// Memorandum in support of a motion, for the U.S. District Court for the District of Kansas (ksd), on the generic FRCP
// brief with D. Kan.'s local rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`,
// fb-595.17.19), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`).
// Content-agnostic: no case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// D. Kan. R. 5.1(a): "Times New Roman or similar", no less than 12-point. Vendored in /fonts (Liberation Serif, its
// metric twin, the fallback; docs/FONTS.md).
#let font-family = ("Times New Roman", "Liberation Serif")

#let ksd-motion-brief(meta, body) = {
  // D. Kan. R. 7.1(a)(3): a concise statement of the facts (a level-1 heading naming the facts or background); the
  // conclusion (7.1(a)(1), the relief) is checked by the layout in every engine (checks.sections).
  assert(body.match(regex("(?im)^#\\s+.*(FACTS|BACKGROUND)")) != none, message:
    "ksd-motion-brief: D. Kan. R. 7.1(a)(3) needs a concise statement of the facts (a level 1 heading naming the facts or background)")
  // D. Kan. R. 5.1(f): each person served with their name, address, capacity and manner of service, and the date.
  if "service" in meta {
    for r in meta.service.recipients {
      assert("name" in r and "address" in r and "capacity" in r and "manner" in r, message:
        "ksd-motion-brief: D. Kan. R. 5.1(f) needs each recipient's name, address, capacity and manner of service")
    }
    assert("date" in meta.service, message: "ksd-motion-brief: D. Kan. R. 5.1(f)(4) needs the date of service")
  }
  xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
}
