// Motion to dismiss and brief in support, for the U.S. District Court for the Western District of Oklahoma, on the
// generic FRCP brief with W.D. Okla.'s local rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`,
// fb-595.17.19), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`).
// Content-agnostic: no case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LCvR7.1(d): 13-point type or larger; the rule names no face: Times New Roman, the house standard and the exemplar's
// face (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let okd-motion-brief(meta, body) = {
  // LCvR7.1(k): a motion and its brief in one document says so in its title.
  assert(lower(meta.brief_title).contains("brief"), message:
    "okd-motion-brief: LCvR7.1(k): a motion and brief in one document is so identified in its title (the word \"brief\")")
  xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
}
