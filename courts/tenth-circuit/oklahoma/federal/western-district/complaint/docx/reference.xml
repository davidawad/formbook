<!-- The W.D. Okla. complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md,
     "Cross-engine gate") in the face of the typst template ({font}, Times New Roman; no W.D. Okla. rule names a face,
     LCvR7.1(d)) at 13 pt (size 26 half points: LCvR7.1(d), print style not less than 13 point, footnotes included);
     Body Text in exact 29.9 pt line boxes (598 twips: typst pitch-body, double spacing of the face at 13 pt,
     LCvR5.2(a)) with a half-inch first-line indent; single lines in 14.95 pt boxes (299 twips: typst pitch-single).
     Letter page with one-inch margins (LCvR7.1(d)), the page number centred at 13 pt on every page in a single-pitch
     line whose box ends 0.5 in above the page edge (typst footer-distance). docx/okwd-complaint.lua writes every
     paragraph's own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="26" body="598" single="299" indent="720" heading="299" heading-before="299" heading-after="0" footer="720">
<footer id="rIdFooter1"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="299" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:jc w:val="center"/></w:pPr><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:r><w:t>1</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r></w:p></footer>
</reference>
