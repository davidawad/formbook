// A motion with its brief in support, for the U.S. Bankruptcy Court for the Western District of Oklahoma (okwb), on
// the generic FRCP brief with the court's Local Bankruptcy Rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and
// docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced
// breaks. Rule IDs (OKWB-...) refer to ../../rules.md. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// OKWB-FONT-001: LR 9004-1(A) asks for printing "in no less than 12-point font (including footnotes)" and names no
// face; Times New Roman, the house face (docs/FONTS.md; Liberation Serif its metric twin), as all three exemplars set
// it. Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let okwb-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
