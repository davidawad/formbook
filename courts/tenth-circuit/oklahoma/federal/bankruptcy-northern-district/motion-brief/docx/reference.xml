<?xml version="1.0" encoding="UTF-8"?>
<!-- The Bankr. N.D. Okla. motion with memorandum's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs)
     in the face of the typst template ({font}, Times New Roman) at 12 pt (size 24 half points, LBR 9004-1(A)); Body
     Text in exact 24 pt line boxes (480 twips, double spacing) with a half-inch first-line indent; single lines in
     14.3 pt boxes (286 twips: typst 0.495em leading + 0.695em line box); block quotations single-spaced, 0.5 in in on
     both sides; footnotes at 12 pt (note-size 24) in 14.3 pt boxes, 6 pt between notes; letter page with 1-inch
     margins (LBR 9004-1(A)) and centered 12 pt page number footer.
     docx/oknb-motion-brief.lua builds the cover, LBR 9013-1(B) notice box, numbered headings, tables, signature
     block and certificate of service. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" pandoc-from="commonmark+smart+yaml_metadata_block" size="24" body="480" single="286" indent="720" heading="480" heading-before="0" heading-after="0" quote="240" note="286" note-size="24" note-after="120" footer="653">
<w:docDefaults><w:rPrDefault><w:rPr><w:rFonts w:ascii="{font}" w:hAnsi="{font}" w:eastAsia="{font}" w:cs="{font}"/><w:kern w:val="2"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:val="en-US" w:eastAsia="en-US" w:bidi="ar-SA"/></w:rPr></w:rPrDefault><w:pPrDefault><w:pPr><w:widowControl/><w:spacing w:after="0"/></w:pPr></w:pPrDefault></w:docDefaults>
<w:style w:type="paragraph" w:styleId="BlockText"><w:name w:val="Block Text"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:uiPriority w:val="99"/><w:unhideWhenUsed/><w:qFormat/><w:pPr><w:spacing w:before="240" w:after="120" w:line="286" w:lineRule="exact"/><w:ind w:firstLine="0" w:left="720" w:right="720"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyFlush"><w:name w:val="Body Flush"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:ind w:left="0" w:firstLine="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="ListAlpha"><w:name w:val="List Alpha"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1296"/></w:tabs><w:ind w:left="1296" w:hanging="576"/></w:pPr></w:style>
</reference>
