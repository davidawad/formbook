// Motion with brief in support (one filed document), for the U.S. District Court for the Northern District of Oklahoma
// (oknd), on the generic FRCP brief with N.D. Okla.'s local rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17.20), set by the shared document model (lib/typst/xdoc.typ; latex/ and
// docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced breaks.
// See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LGnR2-4(a): print style, footnotes included, not smaller than 12 point; no face named: Times New Roman, the house
// standard and the exemplar's face (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let oknd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
