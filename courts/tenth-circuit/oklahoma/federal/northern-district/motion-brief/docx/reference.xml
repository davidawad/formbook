<?xml version="1.0" encoding="UTF-8"?>
<!-- The N.D. Okla. motion and brief's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs;
     docs/EVAL-LOOP.md, "Cross-engine gate") in the face of the typst template ({font}, Times New Roman; LGnR2-4(a)
     names no face) at 12 pt (size 24 half points, LGnR2-4(a): not smaller than 12 point); Body Text in 27.6 pt line
     boxes (552 twips: typst pitch-body, the face's double spacing, twice its 13.8 pt single line; LGnR2-4(a) asks for
     double spacing and bars "Exactly 24 pt") with a half-inch first-line indent (and Body Text Keep, the same kept
     with the signature block); single lines in 13.8 pt boxes (276 twips: typst pitch-single); Footnote Text at 12 pt
     ("including footnotes", LGnR2-4(a)) in 13.8 pt boxes (276 twips: typst pitch-note) with 6 pt after each note
     (typst note-gap). Letter page with one-inch margins (LGnR2-4(a)), the page number centred at 12 pt on every page
     in a single-pitch line whose box ends 0.5 in above the page edge (typst footer-distance).
     docx/oknd-motion-brief.lua writes every other paragraph's own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="552" single="276" indent="720" heading="276" heading-before="276" heading-after="276" note="276" note-size="24" note-after="120" footer="720">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextKeep"><w:name w:val="Body Text Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<footer id="rIdFooter1"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:jc w:val="center"/></w:pPr><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:r><w:t>1</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r></w:p></footer>
</reference>
