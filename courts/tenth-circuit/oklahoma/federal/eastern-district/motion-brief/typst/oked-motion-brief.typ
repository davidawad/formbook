// Motion to dismiss and brief in support, for the U.S. District Court for the Eastern District of Oklahoma (oked), on
// the generic FRCP brief with E.D. Okla.'s local rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17.19), set by the shared document model (lib/typst/xdoc.typ; latex/ and
// docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced
// breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LCvR 5.2(a): print style not smaller than 12-point; no typeface is named: Times New Roman, the house standard and the
// exemplar's face (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let oked-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
