<?xml version="1.0" encoding="UTF-8"?>
<!-- The E.D. Okla. motion and brief's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs;
     docs/EVAL-LOOP.md, "Cross-engine gate") in the face of the typst template ({font}, Times New Roman; LCvR 5.2(a)
     names no face) at 12 pt (size 24 half points; LCvR 5.2(a): not smaller than 12 point); Body Text in exact 24 pt
     line boxes (480 twips: typst pitch-body, double spacing; LCvR 5.2(a) asks for at least 1.5) with a half-inch
     first-line indent (and Body Text Keep, the same kept with the signature block); single lines in 13.8 pt boxes
     (276 twips: typst pitch-single); Footnote Text at 12 pt (LCvR 5.2(a): footnotes included) in 13.8 pt boxes with
     6 pt after each note (typst note-gap). Letter page with one-inch margins (LCvR 5.2(a)), the page number centred
     at 12 pt in a single-pitch line whose box ends 0.5 in above the page edge (typst footer-distance). docx/oked.lua
     writes every other paragraph's own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="276" indent="720" heading="276" heading-before="240" heading-after="0" note="276" note-size="24" note-after="120" footer="720">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextKeep"><w:name w:val="Body Text Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<footer id="rIdFooter1"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:jc w:val="center"/></w:pPr><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:r><w:t>1</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r></w:p></footer>
</reference>
