<?xml version="1.0" encoding="UTF-8"?>
<!-- The Bankr. D.N.M. adversary complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the
     face of the typst template ({font}, Times New Roman; FRBP 9004(a) and the NM LBR name no face, size or spacing,
     NMB-FORM-002) at 12 pt (size 24 half points); Body Text in exact 24 pt line boxes (typst pitch-double, double
     spacing) with a half-inch first-line indent; headings at the body pitch with no space of their own; the court,
     caption, title, quotation and signature lines in 15 pt boxes (typst pitch-single), quotations 0.75 in in on both
     sides; footnotes at 10 pt (note-size 20) in 11.5 pt boxes (typst pitch-note), 7 pt between notes (typst
     note-gap); letter page with 1-inch margins. Added: Body Text Note (a paragraph that anchors a footnote, without
     widow control: typst moves such a paragraph's last line on alone with its note), Body Text Keep (the prayer, kept
     whole with the signature block), Sub Item (a lettered sub-item: the letter half an inch in, the text hanging
     0.4 in after it) and a Footnote Text that splits where typst splits a note. docx/nmb-adversary-complaint.lua
     writes the other paragraphs with their own spacing, and the footer (the short title and "Page X of Y", 10 pt, its
     line 36 pt above the page foot: 720 twips, where typst sets it) and the section. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" pandoc-from="commonmark+smart+yaml_metadata_block" size="24" body="480" single="300" indent="720" heading="480" heading-before="0" heading-after="0" quote="300" note="230" note-size="20" note-after="140" footer="720">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextKeep"><w:name w:val="Body Text Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="SubItem"><w:name w:val="Sub Item"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1296"/></w:tabs><w:ind w:left="1296" w:hanging="576"/></w:pPr></w:style>
<w:style w:type="paragraph" w:styleId="FootnoteText"><w:name w:val="Footnote Text"/><w:basedOn w:val="Normal"/><w:next w:val="FootnoteText"/><w:uiPriority w:val="9"/><w:unhideWhenUsed/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="140" w:line="230" w:lineRule="exact"/></w:pPr><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr></w:style>
</reference>
