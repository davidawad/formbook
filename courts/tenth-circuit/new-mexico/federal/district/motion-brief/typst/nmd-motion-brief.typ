// Motion with its supporting brief, for the U.S. District Court for the District of New Mexico (nmd), on the generic
// FRCP brief with D.N.M.'s local rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`,
// fb-595.17.19), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`).
// Content-agnostic: no case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LR-Civ. 10.1: typewritten, at least 12 pitch; the rule names no face: Times New Roman, the house standard and the
// exemplar's face (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let nmd-motion-brief(meta, body) = {
  // LR-Civ. 7.1(b): a motion, response or reply must include a certificate of service on each party.
  assert("service" in meta and meta.service.at("served", default: ()).len() > 0, message:
    "nmd-motion-brief: D.N.M.LR-Civ. 7.1(b): a motion must include a certificate of service (frontmatter `service` with `served`)")
  xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
}
