<?xml version="1.0" encoding="UTF-8"?>
<!-- The BAP 1st Cir. brief's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the typst
     template's face at 14 pt (size 28 half points), Body Text and List Item in 31.4 pt line boxes with a half-inch
     indent (typst pitch-double, BAP-FORM-004), Block Text and footnotes in 20 pt boxes (pitch-single), exact line
     spacing; plus one style of its own, "BAP First": a body paragraph that does not follow another paragraph (after
     a heading, a list or a quotation), which typst does not indent. bap1.lua writes the cover, headings, tables,
     signature blocks and statements as paragraphs with their own spacing; fb render (tools/fb/src/docxpass.rs)
     writes the sections' footers. The same file is in each doc-type folder. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="28" body="628" single="400" indent="720">
  <w:style w:type="paragraph" w:customStyle="1" w:styleId="BAPFirst"><w:name w:val="BAP First"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:ind w:firstLine="0"/></w:pPr></w:style>
</reference>
