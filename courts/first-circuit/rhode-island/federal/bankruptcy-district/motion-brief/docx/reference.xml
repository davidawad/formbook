<?xml version="1.0" encoding="UTF-8"?>
<!-- The D.R.I. bankruptcy motion with memorandum's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in
     the face of the typst template ({font}, Times New Roman) at 12 pt (size 24 half points; LBR 9013-1(b) and 1005-1(b): at least
     11 point); Body Text in exact 24 pt line boxes (typst pitch-double; LBR 1005-1(b): double spaced) with a
     half-inch indent, and the headings in them; single lines in 13.8 pt boxes (typst pitch-single); letter page with
     1-inch margins (LBR 1005-1(b): 8 1/2 x 11). The footer (rIdFtrNum) is the typst one: the page number centered at
     11 pt in a 12.65 pt line box, the line 37.75 pt above the page foot (755 twips: where typst sets it,
     footer-descent 30 %); footnotes 10 pt in 11.5 pt boxes, 7 pt apart (typst pitch-note, note-gap; LBR 9013-1(b): at least 10 point). docx/rib-motion-brief.lua writes every other paragraph's own spacing. Twips: 20 x pt.
     One style of its own: "Body Text Note", Body Text without widow control, for a paragraph that carries a footnote
     mark (typst lets the line with the mark move on alone when its note does not fit). -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="276" indent="720" heading="480" heading-before="0" heading-after="0" note="230" note-size="20" note-after="140" footer="755">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<footer id="rIdFtrNum"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="253" w:lineRule="exact"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:rPr><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r><w:r><w:rPr><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:fldChar w:fldCharType="separate"/></w:r><w:r><w:rPr><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t>1</w:t></w:r><w:r><w:rPr><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:fldChar w:fldCharType="end"/></w:r></w:p></footer>
<w:sectPr><w:footerReference w:type="default" r:id="rIdFtrNum"/><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="720" w:footer="755" w:gutter="0"/></w:sectPr>
</reference>
