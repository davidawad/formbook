<?xml version="1.0" encoding="UTF-8"?>
<!-- The D.N.H. bankruptcy motion's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face of
     the typst template ({font}, Times New Roman) at 12 pt (size 24 half points; no NH rule sets a size); Body Text in
     exact 27.6 pt line boxes (typst pitch-double, double-spaced) with a half-inch first-line indent; single lines in
     13.8 pt boxes (typst pitch-single); Block Text (quotations) single-spaced, half an inch in on both sides, 12 pt
     above and below (typst cap-gap); footnotes 10 pt in 11.5 pt boxes, 5 pt apart (typst pitch-note, note-gap);
     letter page with 1-inch margins and a centered page number, its line 36.6 pt above the page foot (732 twips:
     where typst sets it, footer-descent 30 %). docx/nhb.lua writes every other paragraph's own spacing.
     Twips: 20 x pt.
     Two styles of its own: "Body Text Note", Body Text without widow control, for a paragraph that carries a
     footnote mark (typst lets the line with the mark move on alone when its note does not fit; Word's widow control
     would move the line before it too); "Body Last", the last paragraph, kept whole and with the signature block
     (typst: a sticky, unbreakable block). -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="552" single="276" indent="720" heading="552" heading-before="0" heading-after="0" quote="240" note="230" note-size="20" note-after="100" footer="732">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyLast"><w:name w:val="Body Last"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
</reference>
