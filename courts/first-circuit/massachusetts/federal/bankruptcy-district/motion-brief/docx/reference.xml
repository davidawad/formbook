<?xml version="1.0" encoding="UTF-8"?>
<!-- The D. Mass. bankruptcy motion's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face of
     the typst template ({font}, Times New Roman) at 12 pt (size 24 half points; MLBR Appendix 8(c): not less than
     12-point); Body Text in exact 24 pt line boxes (typst pitch-double; Appendix 8(a): double-spaced) with a half-inch
     first-line indent, and the headings in them; single lines in 13.8 pt boxes (typst pitch-single); footnotes 10 pt
     (Appendix 8(c)) in 11.5 pt boxes, 7 pt apart (typst pitch-note, note-gap). Added: Numbered Paragraph (Body Text
     with a tab stop at 1 in: the number in the half-inch box after the indent, typst body-par()), Lettered Item (the
     label at 0.5 in, the text hanging at 1 in), Service Entry (a served party: single lines, flush left, never split,
     a single line above it; "First" without it, after the heading; typst service-par()) and the "Note" variants of
     Body Text and Numbered Paragraph without widow control, for a paragraph that carries a footnote mark (typst lets
     the line with the mark move on alone when its note does not fit; Word's widow control would move the line before
     it too). Letter page with 1-inch margins (Appendix 8(a)); the page number centered in a 13.8 pt footer line
     36.6 pt above the page foot (732 twips: where typst sets it, footer-descent 30 %), on every page but the first
     (Appendix 8(b): an empty first-page footer); footnotes numbered through the document. docx/mab.lua writes every
     other paragraph's own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="276" indent="720" heading="480" heading-before="0" heading-after="0" note="230" note-size="20" note-after="140" footer="732">
<w:style w:type="paragraph" w:styleId="FootnoteText"><w:name w:val="footnote text"/><w:basedOn w:val="Normal"/><w:next w:val="FootnoteText"/><w:uiPriority w:val="9"/><w:unhideWhenUsed/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="140" w:line="230" w:lineRule="exact"/></w:pPr><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="NumberedParagraph"><w:name w:val="Numbered Paragraph"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:firstLine="720"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="NumberedParagraphNote"><w:name w:val="Numbered Paragraph Note"/><w:basedOn w:val="NumberedParagraph"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="LetteredItem"><w:name w:val="Lettered Item"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:left="1440" w:hanging="720"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="ServiceEntry"><w:name w:val="Service Entry"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepLines/><w:spacing w:before="276" w:after="0" w:line="276" w:lineRule="exact"/><w:ind w:firstLine="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="ServiceEntryFirst"><w:name w:val="Service Entry First"/><w:basedOn w:val="ServiceEntry"/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="exact"/></w:pPr></w:style>
<footer id="rIdMabPage"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="exact"/><w:jc w:val="center"/></w:pPr><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:r><w:t>2</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r></w:p></footer>
<footer id="rIdMabFirst"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="exact"/></w:pPr></w:p></footer>
<w:sectPr><w:footerReference w:type="default" r:id="rIdMabPage"/><w:footerReference w:type="first" r:id="rIdMabFirst"/><w:footnotePr><w:numRestart w:val="continuous"/></w:footnotePr><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="720" w:footer="732" w:gutter="0"/><w:titlePg/></w:sectPr>
</reference>
