<?xml version="1.0" encoding="UTF-8"?>
<!-- The D. Mass. memorandum's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face of the
     typst template ({font}, Times New Roman, MAD-FORM-002) at 12 pt (size 24 half points, MAD-FORM-004); Body Text in
     exact 24 pt line boxes (typst pitch-double, L.R. 5.1(a)(2) double-spaced) with a half-inch first-line indent, and
     the headings in them with no space of their own; single lines and the footer in 13.8 pt boxes (typst
     pitch-single); footnotes at 12 pt in 13.8 pt boxes, 7 pt apart (typst note-size, pitch-single, note-gap; L.R.
     5.1(a)(2): single-spaced); letter page with 1-inch margins and a centered page number (MAD-FORM-005), its line
     36.6 pt above the page foot (732 twips: where typst sets it, footer-descent 30 %). docx/motion-brief.lua writes
     every other paragraph's own spacing. Twips: 20 x pt.
     Styles of its own: headings 2 and 3 bold at the left, hanging half an inch (typst: hanging-indent para-indent);
     "Body Text Note", Body Text without widow control, for a paragraph that carries a footnote mark (typst lets the
     line with the mark move on alone when its note does not fit; Word's widow control would move the line before it
     too). -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="276" indent="720" heading="480" heading-before="0" heading-after="0" quote="276" note="276" note-size="24" note-after="140" footer="732">
<w:style w:type="paragraph" w:styleId="Heading2"><w:name w:val="heading 2"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:uiPriority w:val="9"/><w:unhideWhenUsed/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:left="720" w:hanging="720"/><w:jc w:val="left"/><w:outlineLvl w:val="1"/></w:pPr><w:rPr><w:rFonts w:ascii="{font}" w:hAnsi="{font}" w:eastAsia="{font}" w:cs="{font}"/><w:b/><w:bCs/><w:color w:val="000000"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
<w:style w:type="paragraph" w:styleId="Heading3"><w:name w:val="heading 3"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:uiPriority w:val="9"/><w:unhideWhenUsed/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:left="720" w:hanging="720"/><w:jc w:val="left"/><w:outlineLvl w:val="2"/></w:pPr><w:rPr><w:rFonts w:ascii="{font}" w:hAnsi="{font}" w:eastAsia="{font}" w:cs="{font}"/><w:b/><w:bCs/><w:color w:val="000000"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
</reference>
