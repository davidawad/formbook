<w:sectPr><w:footerReference w:type="default" r:id="rIdFtrDash"/><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="720" w:footer="732" w:gutter="0"/></w:sectPr>
</reference>
