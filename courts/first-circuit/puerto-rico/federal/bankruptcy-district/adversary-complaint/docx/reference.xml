<?xml version="1.0" encoding="UTF-8"?>
<!-- The D.P.R. bankruptcy adversary complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in
     the face of the typst template ({font}, Times New Roman, the house standard; no rule names a face, ../rules.md Finding 3) at 12 pt
     (size 24 half points; L.Cv.R. 7(e) via LBR 1001-1(b)); Body Text in exact 24 pt line boxes (typst pitch-double,
     double spacing) with a half-inch first-line indent, and the headings in them; single lines in 13.8 pt boxes
     (typst pitch-single). Added: Numbered Paragraph (Body Text with a tab stop at 1 in: the number in the half-inch
     box after the indent, typst body-chunks()) and Lettered Item (the letter at 0.5 in, the text hanging at 1 in).
     Letter page with 1-inch margins; the page number centered at the foot of every page in a 13.8 pt line, 36.6 pt
     above the page foot (732 twips: where typst sets it, footer-descent 30 %). docx/prb-complaint.lua writes every
     other paragraph's own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="276" indent="720" heading="480" heading-before="0" heading-after="0" footer="732">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="NumberedParagraph"><w:name w:val="Numbered Paragraph"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:firstLine="720"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="LetteredItem"><w:name w:val="Lettered Item"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:left="1440" w:hanging="720"/></w:pPr></w:style>
</reference>
