<?xml version="1.0" encoding="UTF-8"?>
<!-- The D.P.R. bankruptcy motion brief's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face
     of the typst template ({font}, Times New Roman; no rule names a face, ../rules.md Finding 3) at 12 pt (size 24
     half points; L.Cv.R. 7(e) via LBR 1001-1(b)); Body Text in exact 24 pt line boxes (typst pitch-double, double
     spacing) with a half-inch first-line indent, and the headings in them; single lines in 13.8 pt boxes (typst
     pitch-single); Block Text (the quotations) single lines half an inch in on both sides, 12 pt above and below
     (typst quote-gap); footnotes at the text size in 13.8 pt boxes, 7 pt apart (typst note-gap); letter page with
     1-inch margins; the page number centered at the foot of every page in a 13.8 pt line, 36.6 pt above the page
     foot (732 twips: where typst sets it, footer-descent 30 %). docx/prb-motion-brief.lua writes every other
     paragraph's own spacing. Twips: 20 x pt.
     Footnote Text is the recipe's without keepLines: a long note splits across a page as typst's does (DEF-CONT-001
     and XENG-002 on p6-7 of the first sample, footnote 4). One style of its own: "Body Text Note", Body Text without widow control, for a paragraph that carries a footnote
     mark (typst lets the line with the mark move on alone when its note does not fit; Word's widow control would
     move the line before it too). -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="276" indent="720" heading="480" heading-before="0" heading-after="0" quote="240" note="276" note-after="140" footer="732">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:styleId="FootnoteText"><w:name w:val="Footnote Text"/><w:basedOn w:val="Normal"/><w:next w:val="FootnoteText"/><w:uiPriority w:val="9"/><w:unhideWhenUsed/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="140" w:line="276" w:lineRule="exact"/></w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
</reference>
