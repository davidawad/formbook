// U.S. District Court, Western District of Washington: a motion to dismiss with its memorandum, on the generic FRCP
// brief with W.D. Wash.'s local rules overlaid and pleading paper (typst/layout.yaml:
// `base: /lib/layouts/frcp-motion-brief.yaml`, fb-595.17, fb-595.96), set by the shared document model
// (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text,
// measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LCR 10(e)(1) (WAWD-FORM-002): a proportionally spaced font, no face named: Times New Roman, the exemplar's face
// (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let wawd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
