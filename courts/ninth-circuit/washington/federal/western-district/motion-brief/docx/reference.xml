<?xml version="1.0" encoding="UTF-8"?>
<!-- The W.D. Wash. motion's Word styles and pleading paper; fb render builds docx/reference.docx from the
     cross-engine recipe (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md, "Cross-engine gate") with them. In the face
     of the typst template ({font}, Times New Roman; LCR 10(e)(1): proportionally spaced) at 12 pt (size 24 half
     points; LCR 10(e)(1): 12 point or larger); Body Text in exact 24 pt line boxes (480 twips, typst pitch-body;
     LCR 10(e)(1): double spaced or exactly 24 points) with a half-inch first-line indent; single lines exactly 12 pt
     (240, typst pitch-single: half a numbered line); headings on the body pitch with no space of their own. Added
     here, as the typst template sets them: "List Item Hanging" (a list item's number half an inch in, the text hanging
     0.9 in from the margin; typst list-indent, list-box), "heading 2" (bold at the margin, the lines after the first
     hanging half an inch; typst heading-hang) and "heading 3" (bold italic at the margin).
     docx/motion-brief.lua writes the numbered paper (LCR 10(e)(5), a header), the bottom notation from the
     frontmatter (LCR 10(e)(3)) and the section: letter, top and bottom margins 1 in (the 27 numbered lines fill the
     9 in between), left 1.5 in, right 1 in, footer 0.2 in. pandoc reads the sample as CommonMark, as cmarker does in
     typst (a Westlaw star page "*2" stays literal). Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="240" indent="720" heading="480" heading-before="0" heading-after="0" footer="288" pandoc-from="commonmark_x+smart">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="ListItemHanging"><w:name w:val="List Item Hanging"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1296"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:left="1296" w:hanging="576"/></w:pPr></w:style>
<w:style w:type="paragraph" w:styleId="Heading2"><w:name w:val="heading 2"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:left="720" w:hanging="720"/><w:outlineLvl w:val="1"/></w:pPr><w:rPr><w:b/><w:bCs/><w:color w:val="000000"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
<w:style w:type="paragraph" w:styleId="Heading3"><w:name w:val="heading 3"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:outlineLvl w:val="2"/></w:pPr><w:rPr><w:b/><w:bCs/><w:i/><w:iCs/><w:color w:val="000000"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
</reference>
