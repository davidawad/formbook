// Motion with memorandum for the U.S. District Court for the Eastern District of Washington (waed), on the generic FRCP
// brief with E.D. Wash.'s local rules overlaid and pleading paper (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17, fb-595.96), set by the shared document model (lib/typst/xdoc.typ;
// latex/ and docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or
// forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LCivR 10(d): a serif face of 14 points or more, or a monospaced one: Liberation Mono, the metric twin of the
// exemplar's Courier New (data/exemplar-fonts.json, docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Liberation Mono",)

#let waed-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
