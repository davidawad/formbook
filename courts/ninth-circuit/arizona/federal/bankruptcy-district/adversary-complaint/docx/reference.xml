<?xml version="1.0" encoding="UTF-8"?>
<!-- The Bankr. D. Ariz. adversary complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the
     face of the typst template ({font}, Times New Roman) at 13 pt (size 26 half points, LRBP 9004-1(g): a proportional
     font no smaller than 13 point); Body Text in exact 24 pt line boxes (typst pitch, the numbered lines, LRBP
     9004-1(g) double spacing) with a half-inch indent, and the headings in them; single lines in 16 pt boxes (typst
     pitch-single); footnotes at 12 pt in 13.8 pt lines (LRBP 9004-1(g): footnotes may be 12 point). Allegation: the
     number half an inch in, the text at the tab an inch in (typst number-box); Relief Item: the label half an inch
     in, the text hanging an inch in; their Keep variants hold the last block with the signature block. The page, its
     pleading numbers, rules and footer are not here: the footer names the paper, so docx/arb-complaint.lua writes the
     footer and the section (left margin 1.5 in, right 1 in, 27 numbered lines from the 1-inch top margin).
     Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="26" body="480" single="320" indent="720" heading="480" heading-before="0" heading-after="0" note="276" note-size="24" note-after="0">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Allegation"><w:name w:val="Allegation"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:left="0" w:firstLine="720"/><w:jc w:val="left"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="AllegationKeep"><w:name w:val="Allegation Keep"/><w:basedOn w:val="Allegation"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="ReliefItem"><w:name w:val="Relief Item"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:left="1440" w:hanging="720"/><w:jc w:val="left"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="ReliefItemKeep"><w:name w:val="Relief Item Keep"/><w:basedOn w:val="ReliefItem"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
</reference>
