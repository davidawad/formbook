<?xml version="1.0" encoding="UTF-8"?>
<!-- The Bankr. D. Ariz. motion's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face of the
     typst template ({font}, Times New Roman) at 13 pt (size 26 half points, LRBP 9004-1(g): a proportional font no
     smaller than 13 point); Body Text in exact 24 pt line boxes (typst pitch, the numbered lines, LRBP 9004-1(g)
     double spacing) with a half-inch indent, and the headings and list items in them; single lines in 16 pt boxes
     (typst pitch-single). pandoc reads the sample with markdown+smart-fancy_lists ("a." and "i." paragraphs stay
     paragraphs, as in typst's CommonMark). Styles of its own:
     - Body Text Note: Body Text without widow control, for a paragraph that carries a footnote mark (typst lets its
       line move on alone when the note does not fit); Body Text Keep: the last paragraph, kept with the signature;
     - Block Quote: the quotations on the numbered lines, half an inch in on both sides (typst quote-indent);
     - Footnote Text: 12 pt (LRBP 9004-1(g)) on the numbered lines (24 pt boxes, typst footnote entries), no space
       between notes, and without keepLines, so a note splits across a page as typst's does;
     - Compact and Table: the table cells, 12 pt in 16 pt lines, 4 pt in from the sides, 5.9 pt above the text (typst
       cell-top 6.4 pt, less the 0.5 pt rule LibreOffice adds above each row) and 9.6 pt below it (typst cell-bottom),
       thin rules, no header formatting (docx/arb-motion.lua writes a table with w:cantSplit rows itself unless a
       cell holds a footnote).
     The page, its pleading numbers, rules and footer are not here: the footer names the paper, so
     docx/arb-motion.lua writes the footer and the section (left margin 1.5 in, right 1 in, 27 numbered lines from the
     1-inch top margin); this section only gives pandoc the text width for the table columns. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="26" body="480" single="320" indent="720" heading="480" heading-before="0" heading-after="0" note="480" note-size="24" note-after="0" pandoc-from="markdown+smart-fancy_lists">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextKeep"><w:name w:val="Body Text Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BlockQuote"><w:name w:val="Block Quote"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:left="720" w:right="720" w:firstLine="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:styleId="FootnoteText"><w:name w:val="Footnote Text"/><w:basedOn w:val="Normal"/><w:next w:val="FootnoteText"/><w:uiPriority w:val="9"/><w:unhideWhenUsed/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/></w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Compact"><w:name w:val="Compact"/><w:basedOn w:val="Normal"/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="0" w:line="320" w:lineRule="exact"/><w:ind w:left="0" w:firstLine="0"/><w:jc w:val="left"/></w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
<w:style w:type="table" w:styleId="Table"><w:name w:val="Table"/><w:basedOn w:val="TableNormal"/><w:uiPriority w:val="59"/><w:qFormat/><w:tblPr><w:tblInd w:w="0" w:type="dxa"/><w:tblBorders><w:top w:val="single" w:sz="4" w:space="0" w:color="000000"/><w:left w:val="single" w:sz="4" w:space="0" w:color="000000"/><w:bottom w:val="single" w:sz="4" w:space="0" w:color="000000"/><w:right w:val="single" w:sz="4" w:space="0" w:color="000000"/><w:insideH w:val="single" w:sz="4" w:space="0" w:color="000000"/><w:insideV w:val="single" w:sz="4" w:space="0" w:color="000000"/></w:tblBorders><w:tblCellMar><w:top w:w="118" w:type="dxa"/><w:left w:w="80" w:type="dxa"/><w:bottom w:w="192" w:type="dxa"/><w:right w:w="80" w:type="dxa"/></w:tblCellMar></w:tblPr></w:style>
<w:sectPr><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="2160" w:header="720" w:footer="720" w:gutter="0"/></w:sectPr>
</reference>
