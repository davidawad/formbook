// Motion with memorandum for the U.S. District Court for the District of Arizona (azd), on the generic FRCP brief with
// D. Ariz.'s local rules overlaid and pleading paper (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`,
// fb-595.17, fb-595.96), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb
// engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LRCiv 7.1(b)(1): a proportional font of at least 13 point, no face named: Times New Roman, the house face
// (docs/FONTS.md) and the exemplar's. Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let azd-motion(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
