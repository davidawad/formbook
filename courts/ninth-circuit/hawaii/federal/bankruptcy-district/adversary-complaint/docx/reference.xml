<?xml version="1.0" encoding="UTF-8"?>
<!-- The D. Haw. bankruptcy adversary complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in
     the face of the typst template ({font}, Times New Roman; the local rules name no face, HIB-ADV-FONT-001) at 12 pt
     (size 24 half points; HIB-ADV-FORM-002); Body Text in exact 27.6 pt line boxes (typst pitch-double, LBR
     9004-1(b)(2) double spacing) with a half-inch first-line indent; single lines in 13.8 pt boxes (typst
     pitch-single); Block Text (quotations) single lines half an inch in on both sides, a single line above and below;
     pandoc reads the sample as CommonMark, as typst's cmarker reads it ("(a) the Lease" is text, not a list).
     Footnote Text at the text size in 13.8 pt boxes, 7 pt apart (typst note-gap), without keepLines, so a long note
     splits across a page as typst's does; "Body Text Note", Body Text without widow control, for a paragraph that
     carries a footnote mark; "Body Text Keep", the last paragraph kept with the signature block. Letter page, 1-inch
     margins (LBR 9004-1(b)(3)); the page number centered in a 13.8 pt line 36.6 pt above the page foot (732 twips:
     where typst sets it, footer-descent 30 %), none on the first page (titlePg). docx/hib-adversary-complaint.lua
     writes the cover, caption, headings and signature with their own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" pandoc-from="commonmark+smart+footnotes+yaml_metadata_block" size="24" body="552" single="276" indent="720" heading="552" heading-before="0" heading-after="0" quote="276" note="276" note-after="140" footer="732">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextKeep"><w:name w:val="Body Text Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<w:style w:type="paragraph" w:styleId="FootnoteText"><w:name w:val="Footnote Text"/><w:basedOn w:val="Normal"/><w:next w:val="FootnoteText"/><w:uiPriority w:val="9"/><w:unhideWhenUsed/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="140" w:line="276" w:lineRule="exact"/></w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
<footer id="rIdFooter1"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:jc w:val="center"/></w:pPr><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:r><w:t>2</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r></w:p></footer>
<footer id="rIdFooterFirst"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="exact"/></w:pPr></w:p></footer>
<w:sectPr><w:footerReference w:type="default" r:id="rIdFooter1"/><w:footerReference w:type="first" r:id="rIdFooterFirst"/><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="720" w:footer="732" w:gutter="0"/><w:titlePg/></w:sectPr>
</reference>
