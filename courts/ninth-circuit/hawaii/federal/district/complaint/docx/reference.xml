<!-- The D. Haw. complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face of the typst
     template ({font}, Times New Roman) at 14 pt (size 28 half points; LR 10.2(a)(2) fixes 14 pt for memoranda, the
     exemplar's complaint is 14 pt); Body Text in exact 32.2 pt line boxes (typst pitch-double, LR 10.2(a)(4) double
     spacing) with a half-inch indent, and the headings in them; single lines (counsel_for, court title, caption,
     headings, signature, footer) in 16.1 pt boxes (typst pitch-single); letter page with 1-inch margins (LR 10.1,
     10.2(a)(1)) and a centered "- n -" page number, its line 34.3 pt above the page foot (686 twips: where typst sets
     it, footer-descent 30 %). docx/hid.lua writes every paragraph's own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="28" body="644" single="322" indent="720" heading="644" heading-before="0" heading-after="0" footer="686">
<footer id="rIdFooter1"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="322" w:lineRule="exact"/><w:jc w:val="center"/></w:pPr><w:r><w:t xml:space="preserve">- </w:t></w:r><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:r><w:t>1</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r><w:r><w:t xml:space="preserve"> -</w:t></w:r></w:p></footer>
</reference>
