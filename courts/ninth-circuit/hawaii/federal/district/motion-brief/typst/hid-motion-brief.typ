// Motion with its memorandum in support for the U.S. District Court for the District of Hawaii (hid), on the generic
// FRCP brief with D. Haw.'s local rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`,
// fb-595.17, fb-595.92), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb
// engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LR 10.2(a)(2): "All memoranda, including footnotes, shall utilize 14-point Times New Roman plain style". Vendored in
// /fonts; Liberation Serif is its metric twin.
#let font-family = ("Times New Roman", "Liberation Serif")

#let hid-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
