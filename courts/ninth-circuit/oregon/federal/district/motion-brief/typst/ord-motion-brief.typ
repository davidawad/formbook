// Motion with memorandum for the U.S. District Court for the District of Oregon (ord), on the generic FRCP brief with
// D. Or.'s local rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`, fb-595.17, fb-595.92),
// set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`).
// Content-agnostic: no case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LR 10-1(c) (ORD-FORM-003): no smaller than 12 point and no face named; Times New Roman, the house standard and the
// face of both filed exemplars (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let ord-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
