// Brief in support of a motion, for the U.S. District Court for the District of Montana (mtd), on the generic FRCP
// brief with D. Mont.'s local rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`,
// fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`).
// Content-agnostic: no case-specific text, measured coordinates or forced breaks. Rule IDs (MTD-...) refer to
// ../../rules.md. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// MTD-FORM-002: L.R. 1.5(a)(2) sets 14-point type and names no face; Times New Roman, the house face (docs/FONTS.md;
// Liberation Serif its metric twin), which the certificate of compliance names. Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let mtd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
