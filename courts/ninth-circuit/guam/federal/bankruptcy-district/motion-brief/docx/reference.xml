<?xml version="1.0" encoding="UTF-8"?>
<!-- The gub motion with memorandum's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face of
     the typst template ({font}, Times New Roman; GNLR 5.1 names no face or size) at 12 pt (size 24 half points, the
     exemplar's); Body Text in exact 27.6 pt line boxes (typst pitch-double; GNLR 5.1(a): double-spaced, Word's double
     as the exemplar is spaced) with a half-inch first-line indent; the headings in them with no space of their own;
     footnotes at 11 pt (size 22) in exact 12.65 pt boxes (typst pitch-note), 7 pt after each (typst note-gap); letter
     page with 1-inch margins and a centered page number (GNLR 5.1(a)), its line 36.75 pt above the page foot (735
     twips: where typst sets it, footer-descent 30 %). Two styles are added: Body Continue, the paragraph that goes on
     after a block quotation (no first-line indent), and Body Keep, the last paragraph before the signature block,
     kept with it. docx/gub-motion-brief.lua writes the cover, heading, quotation and signature paragraphs' own
     spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" pandoc-from="commonmark+smart+footnotes+yaml_metadata_block" size="24" body="552" single="276" indent="720" heading="552" heading-before="0" heading-after="0" note="253" note-size="22" note-after="140" quote="276" footer="735">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyContinue"><w:name w:val="Body Continue"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="0" w:line="552" w:lineRule="exact"/><w:ind w:firstLine="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyKeep"><w:name w:val="Body Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="0" w:after="0" w:line="552" w:lineRule="exact"/></w:pPr></w:style>
</reference>
