// Memorandum in support of a motion, for the United States District Court of Guam (gud), on the generic FRCP brief
// with the court's local rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`, fb-595.17),
// set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`).
// Content-agnostic: no case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// GNLR 5.1 sets no typeface; Times New Roman, the house face (docs/FONTS.md; Liberation Serif its metric twin), the
// exemplar's. Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let gud-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
