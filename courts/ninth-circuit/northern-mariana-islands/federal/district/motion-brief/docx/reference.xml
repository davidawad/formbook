<?xml version="1.0" encoding="UTF-8"?>
<!-- The nmid motion with memorandum, Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md,
     "Cross-engine gate") in the face of the typst template ({font}, Times New Roman; LR 5.2.a: a serif font) at 12 pt
     (size 24 half points; LR 5.2.a: 12-point type or larger, footnotes included); Body Text in exact 24 pt line boxes
     (480 twips, typst pitch; LR 5.2.a: double spacing, the pitch of the 25 numbered lines) with a half-inch first-line
     indent (typst para-indent); single lines in 12 pt boxes (240 twips, typst pitch-single, half a numbered line: every line on a
     numbered line or halfway between two); footnotes at 12 pt in the same single lines, no space between two (typst
     note-gap). Added here, as the typst template sets them: "Body Text Keep" (the last
     paragraph, kept whole with the signature block; typst: one unbreakable block), "Body Text Note" (a paragraph that
     anchors a footnote, without widow control: typst moves its last line on alone when the note does not fit), "Item"
     (a lettered item: the label half an inch in, the text 0.4 in after it). docx/nmid-motion-brief.lua writes the cover,
     the headings, the tables, the signature block, the footer (page number, title, case number, and the numbered lines
     1 to 25 in a text box anchored to the page) and the section (letter page; margins top 1.5 in, bottom 84 pt, left
     1 in, right 0.5 in, LR 5.2.a); the pleading rules as lines in the footer, anchored to the page. Twips: 20 x pt. pandoc-from: CommonMark with
     smart punctuation and footnotes, as typst's cmarker reads the body. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="240" indent="720" note="240" note-after="0" footer="576" pandoc-from="commonmark+smart+footnotes+yaml_metadata_block">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextKeep"><w:name w:val="Body Text Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Item"><w:name w:val="Item"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:left="1296" w:hanging="576"/></w:pPr></w:style>
<w:style w:type="paragraph" w:styleId="FootnoteText"><w:name w:val="Footnote Text"/><w:basedOn w:val="Normal"/><w:next w:val="FootnoteText"/><w:uiPriority w:val="9"/><w:unhideWhenUsed/><w:qFormat/><w:pPr><w:widowControl/><w:spacing w:before="0" w:after="0" w:line="240" w:lineRule="exact"/></w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
</reference>
