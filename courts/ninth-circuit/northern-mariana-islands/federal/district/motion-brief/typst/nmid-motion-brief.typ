// U.S. District Court for the Northern Mariana Islands: memorandum in support of a motion to dismiss, on the generic
// FRCP brief with D.N.M.I.'s local rules overlaid and pleading paper (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17, fb-595.96), set by the shared document model (lib/typst/xdoc.typ;
// latex/ and docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or
// forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LR 5.2.a: 12-point type or larger in a serif font, no face named: Times New Roman, the house face (docs/FONTS.md).
// Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let nmid-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
