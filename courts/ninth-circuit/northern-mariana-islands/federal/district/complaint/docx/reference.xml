<?xml version="1.0" encoding="UTF-8"?>
<!-- The nmid complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md,
     "Cross-engine gate") in the face of the typst template ({font}) at 12 pt (size 24 half points; D.N.M.I. LR 5.2.a:
     12-point type or larger in a serif font); Body Text in exact 24 pt line boxes (typst pitch, LR 5.2.a double
     spacing: the numbered lines) with a half-inch first-line indent (typst para-indent); single lines in 12 pt
     boxes (typst pitch-single). Replaced here, as the typst template sets them: the three heading levels at the type
     size on the body pitch with no space of their own (level 1 centred bold, the filter types it in capitals; 2
     centred bold; 3 bold italic). The page (letter, LR 5.2.a margins: 1.5 in top, 1 in left, 0.5 in right, the
     bottom what 25 numbered lines leave), the line numbers, the pleading rules and the footer with the paper's
     title and case number are the section and footer docx/nmid-complaint.lua writes (FORMBOOK_FINAL,
     FORMBOOK_FOOTERS). Cover, caption and signature carry their own spacing (docx/nmid-complaint.lua). Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" pandoc-from="markdown+smart-fancy_lists" size="24" body="480" single="240" indent="720">
<w:style w:type="paragraph" w:styleId="Heading1"><w:name w:val="heading 1"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:jc w:val="center"/><w:outlineLvl w:val="0"/></w:pPr><w:rPr><w:b/><w:bCs/><w:color w:val="000000"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
<w:style w:type="paragraph" w:styleId="Heading2"><w:name w:val="heading 2"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:jc w:val="center"/><w:outlineLvl w:val="1"/></w:pPr><w:rPr><w:b/><w:bCs/><w:color w:val="000000"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
<w:style w:type="paragraph" w:styleId="Heading3"><w:name w:val="heading 3"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:jc w:val="left"/><w:outlineLvl w:val="2"/></w:pPr><w:rPr><w:b/><w:bCs/><w:i/><w:iCs/><w:color w:val="000000"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
</reference>
