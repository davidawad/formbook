// Memorandum in support of a motion for the U.S. District Court for the District of Alaska (akd), on the generic FRCP
// brief with D. Alaska's local rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`,
// fb-595.17, fb-595.92), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb
// engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// L.Civ.R. 7.5(a)(1)(D): at least 13-point, proportionally spaced, no face named; Times New Roman, the house standard
// and the exemplar's face (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let akd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
