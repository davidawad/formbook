<?xml version="1.0" encoding="UTF-8"?>
<!-- The D. Alaska complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face of the
     typst template ({font}, Times New Roman; L.R. 7.5(a)(1)(D) asks for a proportional face) at 13 pt (size 26 half
     points, L.R. 7.5(a)(1)(D)); Body Text in exact 30 pt line boxes (typst pitch-double, L.R. 7.5(a)(1)(A) double
     spacing) with a half-inch indent, and the headings in them; single lines in 15 pt boxes (typst pitch-single);
     Block Text (quotations) single lines half an inch in on both sides, 15 pt above and below (typst half-gap);
     footnotes at the text size in 15 pt boxes, 7 pt apart (typst note-gap); letter page with 1-inch margins.
     docx/akd-complaint.lua writes every other paragraph's own spacing, and the footer with the case name and number
     and the last section (fb render's $FORMBOOK_FOOTERS, $FORMBOOK_FINAL). Twips: 20 x pt.
     Styles of its own: "Allegation", Body Text with a tab an inch in (the numbered paragraph: the number in a
     half-inch box after the first-line indent, typst number-box); "Allegation Note", the same without widow control,
     for a paragraph that carries a footnote mark (typst lets the line with the mark move on alone when its note does
     not fit); "Allegation Keep", kept with the next paragraph (the last paragraph, kept with the signature block).
     Footnote Text is the recipe's without keepLines: a long note splits across a page as typst's does. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="26" body="600" single="300" indent="720" heading="600" heading-before="0" heading-after="0" quote="300" note="300" note-after="140" footer="420">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Allegation"><w:name w:val="Allegation"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="600" w:lineRule="exact"/><w:ind w:left="0" w:firstLine="720"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="AllegationNote"><w:name w:val="Allegation Note"/><w:basedOn w:val="Allegation"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="AllegationKeep"><w:name w:val="Allegation Keep"/><w:basedOn w:val="Allegation"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<w:style w:type="paragraph" w:styleId="FootnoteText"><w:name w:val="Footnote Text"/><w:basedOn w:val="Normal"/><w:next w:val="FootnoteText"/><w:uiPriority w:val="9"/><w:unhideWhenUsed/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="140" w:line="300" w:lineRule="exact"/></w:pPr><w:rPr><w:sz w:val="26"/><w:szCs w:val="26"/></w:rPr></w:style>
</reference>
