// A motion, or a memorandum in support of one, for the U.S. Bankruptcy Court for the District of Alaska (akb), on the
// generic FRCP brief with the District of Alaska Local Bankruptcy Rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and
// docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced
// breaks. Rule IDs (AKB-...) refer to ../../rules.md. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// AKB-FORM-003: LBR 9004-1(a)(7) asks for 12-point type and names no face; Times New Roman, the house face
// (docs/FONTS.md; Liberation Serif its metric twin). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let akb-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
