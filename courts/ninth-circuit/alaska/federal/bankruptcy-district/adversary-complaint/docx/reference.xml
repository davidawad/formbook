<!-- The D. Alaska bankruptcy adversary complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs)
     in the face of the typst template ({font}, Times New Roman; LBR 9004-1(a)(7) names no typeface) at 12 pt (size 24
     half points, LBR 9004-1(a)(7)); Body Text in exact 24 pt line boxes (typst pitch-double, LBR 9004-1(a)(4) double
     spacing) with a half-inch indent, and the headings in them; single lines in 13.8 pt boxes (typst pitch-single);
     letter page with 1-inch margins (LBR 9004-1(a)(1)-(2)). The footer (rIdFooter1) is the typst one (LBR
     9004-1(a)(5)): the page number centered at 12 pt in a 13.8 pt line box, the line 36.6 pt above the page foot
     (732 twips: where typst sets it, footer-descent 30 %). docx/akb.lua writes every paragraph's own spacing.
     Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="276" indent="720" heading="480" heading-before="240" heading-after="0" footer="732">
<footer id="rIdFooter1"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="exact"/><w:jc w:val="center"/></w:pPr><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:r><w:t>1</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r></w:p></footer>
</reference>
