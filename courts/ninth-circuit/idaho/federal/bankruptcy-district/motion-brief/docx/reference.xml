<?xml version="1.0" encoding="UTF-8"?>
<!-- The D. Idaho bankruptcy motion's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face of
     the typst template ({font}, Times New Roman; LBR 5005-1(c)(2) asks 12 to 14 point type and names no face; size
     24 half points); Body Text in exact 27.6 pt line boxes (552 twips, typst pitch-double: both filers double space)
     with a half-inch first-line indent, the headings in them with no space of their own; the counsel block, caption,
     notice legend, quotations, signature and footnotes in 13.8 pt boxes (276 twips, typst pitch-single); footnotes
     12 pt (LBR 5005-1(c)(2) floor) with the half-inch indent before the mark, 7 pt apart (note-after 140). "Body Text
     Note": a body paragraph pandoc writes because it carries a footnote (no widow control, as typst sets the
     note's line; a tab at 1 in for the paragraph number). Letter page with 1-inch margins (LBR 5005-1(c)(1)) and a
     centered page number, its line 36.75 pt above the page foot (735 twips: where typst sets it, footer-descent
     30 %). docx/idb.lua writes every other paragraph's own spacing. Twips: 20 x pt. pandoc reads the sample without
     fancy lists and definition lists, so "(a)" in a quotation and a ": " paragraph stay text, as typst reads them. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="552" single="276" indent="720" heading="552" heading-before="0" heading-after="0" quote="276" note="276" note-size="24" note-after="140" footer="735" pandoc-from="markdown+smart-fancy_lists-definition_lists">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="552" w:lineRule="exact"/><w:ind w:left="0" w:firstLine="720"/><w:jc w:val="left"/></w:pPr></w:style>
<w:style w:type="paragraph" w:styleId="FootnoteText"><w:name w:val="Footnote Text"/><w:basedOn w:val="Normal"/><w:next w:val="FootnoteText"/><w:uiPriority w:val="9"/><w:unhideWhenUsed/><w:qFormat/><w:pPr><w:keepLines/><w:spacing w:before="140" w:after="0" w:line="276" w:lineRule="exact"/><w:ind w:left="0" w:firstLine="720"/><w:jc w:val="left"/></w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
</reference>
