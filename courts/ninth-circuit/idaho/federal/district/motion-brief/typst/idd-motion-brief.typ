// Memorandum in support of a motion, for the U.S. District Court for the District of Idaho (idd), on the generic FRCP
// brief with D. Idaho's local rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`,
// fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`).
// Content-agnostic: no case-specific text, measured coordinates or forced breaks. Rule IDs (IDD-...) refer to
// ../../rules.md. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// IDD-FORM-001: LR 5.2(a) and 7.1(a)(2) name no face; Times New Roman, the house face (docs/FONTS.md; Liberation Serif
// its metric twin), as the exemplars of two filers. Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let idd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
