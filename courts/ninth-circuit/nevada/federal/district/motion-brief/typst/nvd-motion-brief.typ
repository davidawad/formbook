// Motion to dismiss with memorandum of points and authorities for the U.S. District Court for the District of Nevada
// (nvd), on the generic FRCP brief with D. Nev.'s local rules overlaid and pleading paper (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17, fb-595.96), set by the shared document model (lib/typst/xdoc.typ;
// latex/ and docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or
// forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LR IA 10-1(a)(3) names no face, only the size (12 pt or larger): Times New Roman, the house face (docs/FONTS.md) and
// the filed exemplar's. Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let nvd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
