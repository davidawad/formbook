// U.S. District Court, Southern District of California: memorandum of points and authorities in support of a motion,
// on the generic FRCP brief with S.D. Cal.'s local rules overlaid and pleading paper (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17, fb-595.96), set by the shared document model (lib/typst/xdoc.typ;
// latex/ and docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or
// forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// CivLR 5.1: a proportional font "such as Times New Roman" at 14 point; no face required: Times New Roman, the house
// face (docs/FONTS.md) and the exemplar's. Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let casd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
