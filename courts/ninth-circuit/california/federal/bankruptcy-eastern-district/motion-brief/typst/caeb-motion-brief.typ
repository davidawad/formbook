// U.S. Bankruptcy Court, Eastern District of California: memorandum of points and authorities in support of a motion,
// a document of its own (LBR 9004-2(c)(1), 9014-1(d)(4)), on the generic FRCP brief with caeb's local rules overlaid
// and pleading paper (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`, fb-595.17, fb-595.96), set by
// the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`). Content-agnostic: no
// case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LBR 9004-2(a)(4) (CAEB-MB-FORM-002): "Arial, Courier, Times, Times New Roman, and Helvetica, or their equivalent":
// Times New Roman, named there and the exemplars' face (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let caeb-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
