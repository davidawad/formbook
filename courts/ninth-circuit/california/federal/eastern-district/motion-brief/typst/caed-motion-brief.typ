// Motion with notice and memorandum for the U.S. District Court for the Eastern District of California (caed), on the
// generic FRCP brief with E.D. Cal.'s local rules overlaid and pleading paper (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17, fb-595.96), set by the shared document model (lib/typst/xdoc.typ;
// latex/ and docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or
// forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// No E.D. Cal. rule names a face: Times New Roman, the house face (docs/FONTS.md) and the exemplar's. Vendored in
// /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let caed-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
