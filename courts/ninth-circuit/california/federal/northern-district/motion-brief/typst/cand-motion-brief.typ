// U.S. District Court, Northern District of California: motion (notice of motion and memorandum of points and
// authorities), on the generic FRCP brief with N.D. Cal.'s local rules overlaid and pleading paper (typst/layout.yaml:
// `base: /lib/layouts/frcp-motion-brief.yaml`, fb-595.17, fb-595.96), set by the shared document model
// (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text,
// measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// Civil L.R. 3-4(c)(2)(A)-(B) (CAND-FORM-002): a standard proportionally spaced font such as Times New Roman, 12 point
// or larger: Times New Roman, the rule's example and the exemplar's face (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let cand-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
