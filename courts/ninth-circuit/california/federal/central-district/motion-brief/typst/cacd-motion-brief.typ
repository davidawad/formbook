// U.S. District Court, Central District of California: notice of motion and motion, with the memorandum of points and
// authorities, on the generic FRCP brief with C.D. Cal.'s local rules overlaid and pleading paper (typst/layout.yaml:
// `base: /lib/layouts/frcp-motion-brief.yaml`, fb-595.17, fb-595.96), set by the shared document model
// (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text,
// measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// L.R. 11-3.1.1: a standard proportional font of 14 point or larger, no face named: Times New Roman, the house face
// (docs/FONTS.md) and the exemplar's. Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let cacd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
