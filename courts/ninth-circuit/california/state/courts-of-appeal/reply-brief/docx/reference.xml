<?xml version="1.0" encoding="UTF-8"?>
<!-- The California Court of Appeal reply brief's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs;
     docs/EVAL-LOOP.md, "Cross-engine gate") in the face of the typst template ({font}, Times New Roman; Rule 8.74(b)(1)
     and 8.204(b)(2) prefer Century Schoolbook and require no face, rules.md CALCTAPP-FORM-002) at 13 pt (size 26 half
     points, Rule 8.204(b)(4), footnotes included: note-size 26); Body Text in exact 22.5 pt line boxes (450 twips:
     typst pitch-body, 1.5 spacing, Rule 8.74(b)(2)) with a half-inch first-line indent; single lines in 15 pt boxes
     (300 twips: typst pitch-single) for headings, quotations and footnotes (Rule 8.204(b)(5)); headings 15 pt above
     and 7.5 pt below (typst head-above, head-below), quotations 7.5 pt (quote-gap); footnotes 7 pt apart (note-gap);
     Footnote Text replaced: not kept whole (typst splits a note that does not fit; kept whole, LibreOffice kept its
     anchor line and moved the note on, where typst moved the line with it) and 1 twip in from the right margin
     (LibreOffice decides a line in whole twips and kept a word on a note line 0.06 pt past the measure where typst
     wraps it). Styles added: Body Text Note and Block Text Note, Body Text and Block Text (a quotation's paragraph,
     7.5 pt above and below, 0.5 in in on both sides) without widow control, for a paragraph that holds a footnote
     mark (typst may leave its last line alone); Body Text Keep, such a paragraph kept with the signature block (typst:
     one unbreakable block). docx/calctapp.lua writes the section (letter page, 1 1/2 in left and right, 1 in top and
     bottom, Rule 8.204(b)(6)) and the page-number footer (centred, none on the cover, Rule 8.74(a)(2), in a single
     line whose box ends 0.5 in above the page edge, typst footer-distance), since its passes replace the last
     section; it writes the cover, the tables, the headings, the quotations, the signature, the certificate and the
     proof of service with their own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="26" body="450" single="300" indent="720" heading="300" heading-before="300" heading-after="150" quote="150" note="300" note-size="26" note-after="140" footer="720">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextKeep"><w:name w:val="Body Text Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BlockTextNote"><w:name w:val="Block Text Note"/><w:basedOn w:val="BlockText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:styleId="FootnoteText"><w:name w:val="Footnote Text"/><w:basedOn w:val="Normal"/><w:next w:val="FootnoteText"/><w:uiPriority w:val="9"/><w:unhideWhenUsed/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="140" w:line="300" w:lineRule="exact"/><w:ind w:right="1"/></w:pPr><w:rPr><w:sz w:val="26"/><w:szCs w:val="26"/></w:rPr></w:style>
</reference>
