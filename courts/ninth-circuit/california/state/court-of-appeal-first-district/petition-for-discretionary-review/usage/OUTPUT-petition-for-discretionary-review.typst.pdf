<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?><x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="xmp-writer"><rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"><rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/"  xmlns:xmp="http://ns.adobe.com/xap/1.0/"  xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/"  xmlns:xmpTPg="http://ns.adobe.com/xap/1.0/t/pg/"  xmlns:pdf="http://ns.adobe.com/pdf/1.3/" ><dc:title><rdf:Alt><rdf:li xml:lang="x-default">APPELLANTSâ€™ PETITION FOR REHEARING, No. A144214</rdf:li></rdf:Alt></dc:title><dc:creator><rdf:Seq><rdf:li>Dario Navarro</rdf:li></rdf:Seq></dc:creator><xmp:CreatorTool>Typst 0.15.1</xmp:CreatorTool><dc:language><rdf:Bag><rdf:li>en-US</rdf:li></rdf:Bag></dc:language><xmp:ModifyDate>2026-01-01T00:00:00+00:00</xmp:ModifyDate><xmp:CreateDate>2026-01-01T00:00:00+00:00</xmp:CreateDate><xmpTPg:NPages>24</xmpTPg:NPages><dc:format>application/pdf</dc:format><xmpMM:InstanceID>CWV9ZuNdToZNQQaMqelpVQ==</xmpMM:InstanceID><xmpMM:DocumentID>rtD+RMlc1gZYf66ZEpfJqA==</xmpMM:DocumentID><xmpMM:RenditionClass>proof</xmpMM:RenditionClass><pdf:PDFVersion>1.7</pdf:PDFVersion></rdf:Description></rdf:RDF></x:xmpmeta><?xpacket end="r"?>
