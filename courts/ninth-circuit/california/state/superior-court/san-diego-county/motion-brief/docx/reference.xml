<?xml version="1.0" encoding="UTF-8"?>
<!-- The San Diego County Superior Court motion's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs)
     in the face of the typst template ({font}, Times New Roman; CRC 2.105) at 12 pt (CRC 2.104: not smaller than 12
     points, footnotes included; size 24 half points); Body Text in exact 24 pt line boxes (typst pitch, CRC 2.108(1)
     double spacing on numbered lines) with a half-inch first-line indent (and Body Text Keep, the same kept with the
     signature block), the headings in them with no space of their own; single lines of 12 pt (typst pitch-single);
     Footnote Text at 12 pt in 13.8 pt boxes (typst pitch-note; CRC 2.108(3) single spacing) with 6 pt after each note
     (typst note-gap). The pages (letter, 1 in top, 1.5 in left, 0.5 in right, 28 numbered lines), the sections, the
     pleading rules and the footer with the line numbers are written by docx/calsuperct-sandiego-motion-brief.lua
     (FORMBOOK_FINAL, FORMBOOK_FOOTERS). Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="240" indent="720" heading="480" heading-before="0" heading-after="0" note="480" note-size="24" note-after="0" footer="360">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextKeep"><w:name w:val="Body Text Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
</reference>
