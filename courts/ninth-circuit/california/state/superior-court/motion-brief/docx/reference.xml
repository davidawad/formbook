<?xml version="1.0" encoding="UTF-8"?>
<!-- The California Superior Court motion brief's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs;
     docs/EVAL-LOOP.md, "Cross-engine gate") in the face of the typst template ({font}, Times New Roman; CRC 2.105) at
     12 pt (CRC 2.104: not smaller than 12 points; size 24 half points); Body Text in exact 24 pt line boxes (480
     twips: typst pitch, CRC 2.108(1) double spacing on the numbered lines) with a half-inch first-line indent, and
     Body Text Note, the same without widow control, for a paragraph that anchors a footnote; the headings in body
     line boxes with no space of their own; single lines and Footnote Text in exact 12 pt boxes (240 twips: typst
     pitch-single; CRC 2.108(3) single-spaced footnotes), 6 pt after a note (typst note-gap). The page (letter, 1 in
     top, 1.5 in left, 1/2 in right, CRC 2.107; 28 numbered lines), the pleading rules and the footer with the line
     numbers, the page number and the paper's title (CRC 2.108-2.110) are written by docx/calsuperct.lua
     (FORMBOOK_FINAL, FORMBOOK_FOOTERS). Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="240" indent="720" heading="480" heading-before="0" heading-after="0" note="240" note-size="24" note-after="120">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
</reference>
