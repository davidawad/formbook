<?xml version="1.0" encoding="UTF-8"?>
<!-- The D.C. Circuit opening brief's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face of
     the typst template (TeX Gyre Schola) at 14 pt (FRAP 32(a)(5)(A); size 28 half points); Body Text and List Item in
     25 pt line boxes (typst pitch-body) with a half-inch indent; quotations, footnotes and the heading styles in 21 pt
     boxes (typst pitch-single), quotations 10 pt above and below, 3 pt after each footnote (cadc.lua sets every
     heading's own size and spacing; the styles give the outline levels). Page setup and footers come from cadc.lua's
     sections and fb render. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="28" body="500" single="420" indent="720" quote="200" note-after="60"/>
