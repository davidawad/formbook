// Memorandum of points and authorities supporting a motion, for the U.S. District Court for the District of Columbia
// (dcd), on the generic FRCP brief with D.D.C.'s local rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and
// docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced breaks.
// See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LCvR 5.1(d): 12-point type; the rule names no face: Times New Roman, the house standard and the face of both
// exemplars (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let dcd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
