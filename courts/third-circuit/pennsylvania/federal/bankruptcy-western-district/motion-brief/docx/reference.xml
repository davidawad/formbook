<?xml version="1.0" encoding="UTF-8"?>
<!-- The pawb brief's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md,
     "Cross-engine gate") in the face of the typst template ({font}, Times New Roman; LBR 5005-13(b)(4) names no face
     and asks for 12 point or larger, footnotes included) at 12 pt (size 24 half points); Body Text in exact 24 pt
     line boxes (480 twips, typst pitch-body; double spacing as the exemplar) with a half-inch first-line indent (typst
     para-indent); single lines and footnotes in 13.8 pt boxes (276 twips, typst pitch-single), 7 pt after a footnote
     (typst note-gap), a footnote kept whole; Block Text 12 pt above and below (typst quote-gap), half an inch in on
     each side (typst quote-indent). Added here: "Body Text Keep", the last paragraph, kept with the signature block
     (typst sets them in one unbreakable block). docx/pawb-motion-brief.lua writes the court title, the caption, the
     title, the headings, the signature block, the footer (the page number, centred, its line box ending 0.5 in above
     the edge: typst footer-descent) and the section (letter, 1 in margins). Twips: 20 x pt.
     pandoc-from: CommonMark with smart punctuation and footnotes, as typst's cmarker reads the body. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" pandoc-from="commonmark+smart+footnotes+yaml_metadata_block" size="24" body="480" single="276" indent="720" heading="480" heading-before="0" heading-after="0" quote="240" note-after="140" footer="720">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextKeep"><w:name w:val="Body Text Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
</reference>
