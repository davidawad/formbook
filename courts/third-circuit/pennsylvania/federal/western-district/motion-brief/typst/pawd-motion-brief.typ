// Memorandum of law in support of a motion for the U.S. District Court for the Western District of Pennsylvania
// (pawd), on the generic FRCP brief with W.D. Pa.'s local rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and
// docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced
// breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LCvR 5.1.B sets the size (12 point) and names no face: Times New Roman, the house standard and the exemplar's face
// (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let pawd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
