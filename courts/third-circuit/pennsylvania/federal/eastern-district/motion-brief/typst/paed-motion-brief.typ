// The motion packet for the U.S. District Court for the Eastern District of Pennsylvania (paed): the proposed order,
// the motion with its certificate of service and the memorandum of law, on the generic FRCP brief with E.D. Pa.'s local
// rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`, its papers before the memorandum as
// `lead`, fb-595.17, fb-595.92), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by
// `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// The local rules name no face; Times New Roman, the exemplar's and the house standard (docs/FONTS.md). Vendored in
// /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let paed-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
