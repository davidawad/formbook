<?xml version="1.0" encoding="UTF-8"?>
<!-- The D.N.J. motion brief's Word styles; fb render builds docx/reference.docx from pandoc's default reference
     with them (tools/fb/src/docxref.rs). Restyled to match typst/njd-motion-brief.typ: Times New Roman 14 pt (the
     typst face, L.Civ.R. 7.2(d)), exact 28.3 pt (double) line spacing, 0.5 in first-line indent, 12 pt page
     number, hanging-indent headings (I., A., 1., a.), single-spaced front matter styles. The contents and
     authorities rows keep a page column (right indent) with the dot tab inside the margin. The sections and
     footers are fb render's (rIdFtrNone, rIdFtrPage; docx/njd.lua writes FORMBOOK_FINAL). -->
