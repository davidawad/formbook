// Memorandum of law in support of a motion for the U.S. District Court for the District of New Jersey (njd), on the
// generic FRCP brief with D.N.J.'s local rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`,
// fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`).
// Content-agnostic: no case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// L.Civ.R. 7.2(d): "an equivalent 14-point proportional font (such as Times New Roman 14)": Times New Roman, vendored
// in /fonts (docs/FONTS.md).
#let font-family = ("Times New Roman", "Liberation Serif")

#let njd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
