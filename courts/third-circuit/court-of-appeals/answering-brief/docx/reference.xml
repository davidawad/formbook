<?xml version="1.0" encoding="UTF-8"?>
<!-- The Word styles: the shared style recipe of the cross-engine layout model
     (tools/fb/src/docxxengine.rs): TeX Gyre Schola 14 pt (the typst template's font); Body Text and List Item in
     31.8 pt line boxes (typst pitch-double, FRAP 32(a)(4)) with a half-inch indent; quotations, footnotes and the heading
     styles in 20.4 pt boxes (typst pitch-single), quotations 14 pt above and below, 7 pt after each footnote (ca3.lua sets
     every heading's own spacing; the styles give the outline levels). Page setup and footers come from ca3.lua's sections
     and fb render. One style is added: Body Text Noted, Body Text without widow control, for a paragraph that holds a
     footnote (typst moves the line with the reference to the next page with its note, even when that leaves a widow). -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="28" body="636" single="408" indent="720" quote="280" note-after="140">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNoted"><w:name w:val="Body Text Noted"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
</reference>
