<?xml version="1.0" encoding="UTF-8"?>
<!-- The D. Del. complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md,
     "Cross-engine gate") in the face of the typst template ({font}, Times New Roman; LR 5.1.1(a) names no face) at
     12 pt (size 24 half points; LR 5.1.1(a): at least 12 point for all printed matter, footnotes too); Body Text in
     exact 27.6 pt line boxes (552 twips, typst pitch-body; LR 5.1.1(a): double spacing as typical word processing
     software sets it, 2 x 1.15 x 12 pt) with a half-inch first-line indent (typst para-indent); single lines and
     footnotes in 13.8 pt boxes (276 twips, typst pitch-single), 7 pt after a footnote (typst note-gap). Added here,
     as the typst template sets them: "Numbered Paragraph" (an allegation, Fed. R. Civ. P. 10(b): the number at the
     indent, a tab to the text 1 in in; typst num-box) and "List Letter" (a prayer item: the letter half an inch in,
     the text hanging at 1 in; typst list-indent, list-box). docx/ded-complaint.lua writes the court title, the
     caption, the title, the headings, the signature block, the footer (the page number, centred, its line box ending
     0.5 in above the edge: typst footer-descent) and the section (letter, 1 in margins, LR 5.1.1(a)). Twips: 20 x pt.
     pandoc-from: CommonMark with smart punctuation, as typst's cmarker reads the body. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" pandoc-from="commonmark+smart+footnotes+yaml_metadata_block" size="24" body="552" single="276" indent="720" heading="552" heading-before="0" heading-after="0" note-after="140" footer="720">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="NumberedParagraph"><w:name w:val="Numbered Paragraph"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="552" w:lineRule="exact"/><w:ind w:firstLine="720"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="ListLetter"><w:name w:val="List Letter"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="552" w:lineRule="exact"/><w:ind w:left="1440" w:hanging="720"/></w:pPr></w:style>
</reference>
