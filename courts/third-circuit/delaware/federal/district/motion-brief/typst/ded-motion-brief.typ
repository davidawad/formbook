// Opening brief in support of a motion for the U.S. District Court for the District of Delaware (ded), on the generic
// FRCP brief with D. Del.'s local rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`,
// fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`).
// Content-agnostic: no case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LR 5.1.1(a) and 7.1.3(a)(2) set the size (12 point) and name no face: Times New Roman, the house standard and the
// exemplar's face (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let ded-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
