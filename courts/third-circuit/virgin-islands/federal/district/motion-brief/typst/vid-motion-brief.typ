// Memorandum of law in support of a motion for the District Court of the Virgin Islands (vid), on the generic FRCP
// brief with the court's local rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`,
// fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`).
// Content-agnostic: no case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LRCi 5.1(a) names no face (VI-FONT-001): Times New Roman, the exemplar's face and the house standard, with
// Liberation Serif its metric-compatible substitute (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let vid-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
