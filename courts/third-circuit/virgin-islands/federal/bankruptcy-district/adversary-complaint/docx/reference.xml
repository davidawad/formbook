<?xml version="1.0" encoding="UTF-8"?>
<!-- The vib adversary complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md,
     "Cross-engine gate") in the face of the typst template ({font}, Times New Roman; LBR 5005-1(B) asks for no
     smaller than 12 Courier or an equivalent and names no face) at 12 pt (size 24 half points), footnotes too; Body
     Text in exact 24 pt line boxes (480 twips, typst pitch-body; VIB-AC-SPACING double spaced) with a half-inch
     first-line indent (typst para-indent); single lines and footnotes in 13.8 pt boxes (276 twips, typst
     pitch-single), 7 pt after a footnote (typst note-gap). Added here, as the typst template sets them: "Numbered
     Paragraph" (VIB-AC-NUMBER: the number at the indent, a tab to the text 1 in in; typst number-box) and the "Keep"
     variants of it and of Body Text (the last paragraph, kept whole with the signature: typst one unbreakable
     block). docx/vib-adversary-complaint.lua writes the court header, the caption, the title, the headings, the
     signature block, the footer (the short title and "Page n of N", its last line box ending 0.3 in above the edge:
     typst footer-height) and the section (letter, 1 in margins). Twips: 20 x pt. pandoc-from: CommonMark with smart
     punctuation and footnotes, as typst's cmarker reads the body. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" pandoc-from="commonmark+smart+footnotes+yaml_metadata_block" size="24" body="480" single="276" indent="720" heading="480" heading-before="0" heading-after="0" note-after="140" footer="432">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="NumberedParagraph"><w:name w:val="Numbered Paragraph"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:firstLine="720"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="NumberedParagraphKeep"><w:name w:val="Numbered Paragraph Keep"/><w:basedOn w:val="NumberedParagraph"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextKeep"><w:name w:val="Body Text Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
</reference>
