<?xml version="1.0" encoding="UTF-8"?>
<!-- The vib motion brief's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md,
     "Cross-engine gate") in the face of the typst template ({font}, Times New Roman; LBR 5005-1(B) asks for no
     smaller than 12 Courier or an equivalent and names no face) at 12 pt (size 24 half points), footnotes too; Body
     Text in exact 24 pt line boxes (480 twips, typst pitch-body; VIB-MB-SPACING double spaced) with a half-inch
     first-line indent (typst para-indent); single lines and footnotes in 13.8 pt boxes (276 twips, typst
     pitch-single), 7 pt after a footnote (typst note-gap). Added here: "Body Text Keep" (the last paragraph, kept whole
     with the signature: typst one unbreakable block) and "Body Text Note", Body Text without widow control for a
     paragraph that carries a footnote mark (typst lets the line with the mark move on alone when its note does not
     fit; Word's widow control would move the line before it too), and Footnote Text without the recipe's keepLines
     (typst splits a note over a page end; LibreOffice would move the note and its line whole).
     docx/vib-motion-brief.lua writes the cover, the contents, the headings, the signature block, the footer (the
     short title and "Page n of N", its last line box ending 0.3 in above the edge: typst footer-height) and the
     section (letter, 1 in margins). Twips: 20 x pt.
     pandoc-from: CommonMark with smart punctuation and footnotes, as typst's cmarker reads the body. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" pandoc-from="commonmark+smart+footnotes+yaml_metadata_block" size="24" body="480" single="276" indent="720" heading="276" heading-before="240" heading-after="240" note-after="140" footer="432">
<w:style w:type="paragraph" w:styleId="FootnoteText"><w:name w:val="Footnote Text"/><w:basedOn w:val="Normal"/><w:next w:val="FootnoteText"/><w:uiPriority w:val="9"/><w:unhideWhenUsed/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="140" w:line="276" w:lineRule="exact"/></w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextKeep"><w:name w:val="Body Text Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
</reference>
