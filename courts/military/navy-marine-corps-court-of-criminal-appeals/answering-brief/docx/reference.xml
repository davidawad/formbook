<?xml version="1.0" encoding="UTF-8"?>
<!-- The NMCCA brief's Word styles; fb render builds docx/reference.docx from pandoc's default reference with them
     (tools/fb/src/docxref.rs), on the cross-engine layout model of ../typst/nmcca-*.typ (lib/typst/xengine.typ,
     lib/docx/xengine.lua): EB Garamond 14 pt everywhere, footnotes included (the typst face, vendored in fonts/;
     NMCCA-FORM-001); exact line spacing at the typst pitches: body 672 twips (33.6 pt, double, NMCCA-FORM-002),
     single-spaced blocks (cover, headings, index, quotations, footnotes, signature) 336 twips (16.8 pt); first-line
     indent 0.5 in for a paragraph that follows a paragraph (First Paragraph: none); list items with the number in a
     0.5 in box; block quotations indented 0.5 in both sides, 224 twips above and below; footnotes 140 twips apart
     (typst footnote.entry gap 7 pt). Hanging indents carry no firstLine attribute (LibreOffice lets w:firstLine="0"
     cancel w:hanging). The footers (rIdFtrNone, rIdFtrPage) and every section's page setup are fb render's and the
     filter's (docx/nmcca.lua writes the section breaks and FORMBOOK_FINAL). -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" styles="merge" theme-font="EB Garamond" strip-theme-fonts="true">
  <w:docDefaults>
    <w:rPrDefault>
      <w:rPr>
        <w:rFonts w:ascii="EB Garamond" w:hAnsi="EB Garamond" w:eastAsia="EB Garamond" w:cs="EB Garamond"/>
        <w:sz w:val="28"/>
        <w:szCs w:val="28"/>
        <w:lang w:val="en-US" w:eastAsia="en-US" w:bidi="ar-SA"/>
      </w:rPr>
    </w:rPrDefault>
    <w:pPrDefault>
      <w:pPr>
        <w:widowControl w:val="0"/>
        <w:spacing w:before="0" w:after="0" w:line="336" w:lineRule="exact"/>
      </w:pPr>
    </w:pPrDefault>
  </w:docDefaults>
  <w:style w:type="paragraph" w:default="1" w:styleId="Normal">
    <w:name w:val="Normal"/>
    <w:qFormat/>
    <w:pPr>
      <w:widowControl w:val="0"/>
      <w:spacing w:before="0" w:after="0" w:line="336" w:lineRule="exact"/>
    </w:pPr>
    <w:rPr>
      <w:rFonts w:ascii="EB Garamond" w:hAnsi="EB Garamond" w:eastAsia="EB Garamond" w:cs="EB Garamond"/>
      <w:sz w:val="28"/>
      <w:szCs w:val="28"/>
    </w:rPr>
  </w:style>
  <w:style w:type="paragraph" w:styleId="BodyText">
    <w:name w:val="Body Text"/>
    <w:basedOn w:val="Normal"/>
    <w:qFormat/>
    <w:pPr>
      <w:spacing w:before="0" w:after="0" w:line="672" w:lineRule="exact"/>
      <w:ind w:firstLine="720"/>
    </w:pPr>
  </w:style>
  <w:style w:type="paragraph" w:customStyle="1" w:styleId="FirstParagraph">
    <w:name w:val="First Paragraph"/>
    <w:basedOn w:val="Normal"/>
    <w:next w:val="BodyText"/>
    <w:qFormat/>
    <w:pPr>
      <w:spacing w:before="0" w:after="0" w:line="672" w:lineRule="exact"/>
    </w:pPr>
  </w:style>
  <w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyKeep">
    <w:name w:val="Body Keep"/>
    <w:basedOn w:val="BodyText"/>
    <w:qFormat/>
    <w:pPr>
      <w:keepNext/>
      <w:keepLines/>
    </w:pPr>
  </w:style>
  <w:style w:type="paragraph" w:customStyle="1" w:styleId="FirstKeep">
    <w:name w:val="First Keep"/>
    <w:basedOn w:val="FirstParagraph"/>
    <w:qFormat/>
    <w:pPr>
      <w:keepNext/>
      <w:keepLines/>
    </w:pPr>
  </w:style>
  <w:style w:type="paragraph" w:customStyle="1" w:styleId="Compact">
    <w:name w:val="Compact"/>
    <w:basedOn w:val="FirstParagraph"/>
    <w:qFormat/>
  </w:style>
  <w:style w:type="paragraph" w:customStyle="1" w:styleId="ListItem">
    <w:name w:val="List Item"/>
    <w:basedOn w:val="Normal"/>
    <w:qFormat/>
    <w:pPr>
      <w:spacing w:before="0" w:after="0" w:line="672" w:lineRule="exact"/>
      <w:ind w:left="720" w:hanging="720"/>
    </w:pPr>
  </w:style>
  <w:style w:type="paragraph" w:styleId="BlockText">
    <w:name w:val="Block Text"/>
    <w:basedOn w:val="Normal"/>
    <w:next w:val="BodyText"/>
    <w:qFormat/>
    <w:pPr>
      <w:spacing w:before="224" w:after="224" w:line="336" w:lineRule="exact"/>
      <w:ind w:left="720" w:right="720"/>
    </w:pPr>
  </w:style>
  <w:style w:type="paragraph" w:styleId="FootnoteText">
    <w:name w:val="footnote text"/>
    <w:basedOn w:val="Normal"/>
    <w:qFormat/>
    <w:pPr>
      <w:spacing w:before="0" w:after="140" w:line="336" w:lineRule="exact"/>
    </w:pPr>
    <w:rPr>
      <w:sz w:val="28"/>
      <w:szCs w:val="28"/>
    </w:rPr>
  </w:style>
  <w:style w:type="character" w:styleId="FootnoteReference">
    <w:name w:val="footnote reference"/>
    <w:rPr>
      <w:vertAlign w:val="superscript"/>
    </w:rPr>
  </w:style>
  <w:style w:type="character" w:styleId="Hyperlink">
    <w:name w:val="Hyperlink"/>
    <w:rPr>
      <w:color w:val="000000"/>
    </w:rPr>
  </w:style>
  <w:style w:type="paragraph" w:styleId="Heading1">
    <w:name w:val="heading 1"/>
    <w:basedOn w:val="Normal"/>
    <w:next w:val="FirstParagraph"/>
    <w:qFormat/>
    <w:pPr>
      <w:keepNext/>
      <w:keepLines/>
      <w:spacing w:before="392" w:after="0" w:line="336" w:lineRule="exact"/>
      <w:jc w:val="center"/>
      <w:outlineLvl w:val="0"/>
    </w:pPr>
    <w:rPr>
      <w:b/>
      <w:bCs/>
      <w:color w:val="000000"/>
      <w:sz w:val="28"/>
      <w:szCs w:val="28"/>
    </w:rPr>
  </w:style>
  <w:style w:type="paragraph" w:styleId="Heading2">
    <w:name w:val="heading 2"/>
    <w:basedOn w:val="Normal"/>
    <w:next w:val="FirstParagraph"/>
    <w:qFormat/>
    <w:pPr>
      <w:keepNext/>
      <w:keepLines/>
      <w:spacing w:before="308" w:after="0" w:line="336" w:lineRule="exact"/>
      <w:outlineLvl w:val="1"/>
    </w:pPr>
    <w:rPr>
      <w:b/>
      <w:bCs/>
      <w:color w:val="000000"/>
      <w:sz w:val="28"/>
      <w:szCs w:val="28"/>
    </w:rPr>
  </w:style>
  <w:style w:type="paragraph" w:styleId="Heading3">
    <w:name w:val="heading 3"/>
    <w:basedOn w:val="Heading2"/>
    <w:next w:val="FirstParagraph"/>
    <w:qFormat/>
    <w:pPr>
      <w:outlineLvl w:val="2"/>
    </w:pPr>
  </w:style>
  <w:style w:type="paragraph" w:styleId="Heading4">
    <w:name w:val="heading 4"/>
    <w:basedOn w:val="Heading2"/>
    <w:next w:val="FirstParagraph"/>
    <w:qFormat/>
    <w:pPr>
      <w:outlineLvl w:val="3"/>
    </w:pPr>
  </w:style>
  <w:style w:type="paragraph" w:styleId="Heading5">
    <w:name w:val="heading 5"/>
    <w:basedOn w:val="Heading2"/>
    <w:next w:val="FirstParagraph"/>
    <w:qFormat/>
    <w:pPr>
      <w:outlineLvl w:val="4"/>
    </w:pPr>
  </w:style>
</reference>
