// Memorandum supporting a motion, for the U.S. District Court for the Western District of Louisiana (lawd), on the
// generic FRCP brief with W.D. La.'s local rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`,
// fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`).
// Content-agnostic: no case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// No W.D. La. rule names a face or size (LR 7.1, 7.8, 10.1): Times New Roman 12 pt, the house standard (docs/FONTS.md).
// Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")
// LR 10.1: the caption names the division, one of the court's five.
#let divisions = ("ALEXANDRIA", "LAFAYETTE", "LAKE CHARLES", "MONROE", "SHREVEPORT")

#let lawd-motion-brief(meta, body) = {
  assert(upper(meta.division) in divisions, message: "lawd-motion-brief: division must be one of the five W.D. La. divisions")
  xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
}
