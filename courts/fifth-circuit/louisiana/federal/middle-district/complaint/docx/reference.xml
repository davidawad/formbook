<?xml version="1.0" encoding="UTF-8"?>
<!-- The lamd complaint Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md,
     "Cross-engine gate") in the face of the typst template ({font}, Times New Roman) at 12 pt (size 24 half points;
     LR 10(a)(1): no smaller than standard 12-point); Body Text in exact 24 pt line boxes (typst pitch-body, LR 10(a)(1)
     double spacing) with a half-inch first-line indent (typst para-indent); single lines in 13.8 pt boxes (typst
     pitch-single); letter page, 1 in margins (LR 10(a)(1)). Added or replaced here, as the typst template sets them:
     "Numbered Paragraph" (FRCP 10(b): the number, a tab 1 in from the margin, the text; typst number-box) and
     "Lamd List" (the label half an inch in, the text hanging 1 in from the margin; typst label-box). The footer: the
     page number centred in a 13.8 pt line box whose foot is 0.6 in above the bottom edge (footer="864"; LR 10(a)(1):
     no less than 1/2 inch from the bottom; typst footer-descent 15 pt). Headings, caption and signature carry their
     own spacing (docx/lamd-complaint.lua). Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="276" indent="720" heading="480" heading-before="0" heading-after="0" footer="864">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="NumberedParagraph"><w:name w:val="Numbered Paragraph"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:firstLine="720"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="LamdList"><w:name w:val="Lamd List"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:left="1440" w:hanging="720"/></w:pPr></w:style>
<footer id="rIdFooter1"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="exact"/><w:jc w:val="center"/></w:pPr><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:r><w:t>1</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r></w:p></footer>
</reference>
