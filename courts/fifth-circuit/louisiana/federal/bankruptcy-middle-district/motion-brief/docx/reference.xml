<?xml version="1.0" encoding="UTF-8"?>
<!-- The lamb motion-brief Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md,
     "Cross-engine gate") in the face of the typst template ({font}) at 12 pt (size 24 half points; LR 5005-2(b),
     12-point font, footnotes too); Body Text in exact 24 pt line boxes (480 twips, typst pitch-body; LR 5005-2(b) and
     9013-2, double-spaced) with a half-inch first-line indent (typst para-indent); single lines in 15.65 pt boxes
     (313 twips, typst pitch-single); footnotes at 12 pt in single lines, 4 pt apart (typst note-gap); Block Text
     single-spaced, half an inch in on both sides, 6 pt above and below (typst quote-indent, quote-space); List Item
     hanging half an inch (typst list-indent); letter page (LR 5005-2(a)), 1 in margins and a centred page-number
     footer (LR 9013-2: paginated). Added or replaced here, as the typst template sets them: "Conclusion" (Body Text
     kept with the signature block after it; typst sticky), the "Note" variants of Body Text and Conclusion (no widow
     control, for a paragraph that anchors a footnote), the three heading levels single-spaced, 11 pt above and 6 pt
     below (typst heading-above, heading-below; printed as the filter writes them, no style capitals; h1 centred bold,
     h2 bold, h3 bold italic), Footnote Text (the recipe's, without keepLines: typst splits a long note across pages),
     Block Text with contextual spacing (its paragraphs follow each other, as typst sets one quotation). Caption, title,
     notice, table and signature carry their own spacing (docx/lamb-motion-brief.lua). Twips: 20 x pt.
     pandoc-from: CommonMark with smart punctuation, footnotes and pipe tables, so pandoc pairs quotation marks as
     typst's cmarker does (an unbalanced quotation mark in the sample, p12, was paired the other way by markdown+smart). -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="313" indent="720" quote="120" note="313" note-after="80" pandoc-from="commonmark+smart+footnotes+pipe_tables+yaml_metadata_block">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Conclusion"><w:name w:val="Conclusion"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="ConclusionNote"><w:name w:val="Conclusion Note"/><w:basedOn w:val="Conclusion"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:styleId="Heading1"><w:name w:val="heading 1"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="220" w:after="120" w:line="313" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:jc w:val="center"/><w:outlineLvl w:val="0"/></w:pPr><w:rPr><w:b/><w:bCs/><w:color w:val="000000"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
<w:style w:type="paragraph" w:styleId="Heading2"><w:name w:val="heading 2"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="220" w:after="120" w:line="313" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:outlineLvl w:val="1"/></w:pPr><w:rPr><w:b/><w:bCs/><w:color w:val="000000"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
<w:style w:type="paragraph" w:styleId="Heading3"><w:name w:val="heading 3"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="220" w:after="120" w:line="313" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:outlineLvl w:val="2"/></w:pPr><w:rPr><w:b/><w:bCs/><w:i/><w:iCs/><w:color w:val="000000"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
<w:style w:type="paragraph" w:styleId="FootnoteText"><w:name w:val="Footnote Text"/><w:basedOn w:val="Normal"/><w:next w:val="FootnoteText"/><w:uiPriority w:val="9"/><w:unhideWhenUsed/><w:qFormat/><w:pPr><w:widowControl/><w:spacing w:before="0" w:after="80" w:line="313" w:lineRule="exact"/></w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
<w:style w:type="paragraph" w:styleId="BlockText"><w:name w:val="Block Text"/><w:basedOn w:val="BodyText"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:contextualSpacing/><w:spacing w:before="120" w:after="120" w:line="313" w:lineRule="exact"/><w:ind w:left="720" w:right="720" w:firstLine="0"/></w:pPr></w:style>
</reference>
