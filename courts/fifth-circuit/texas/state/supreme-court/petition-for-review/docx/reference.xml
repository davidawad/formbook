<!-- The Supreme Court of Texas brief's Word styles (the petition for review and the brief on the merits share them):
     the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face of the typst template ({font}, Times New Roman,
     the face of the filed exemplars) at 14 pt (size 28 half points; TRAP 9.4(e), at least 14-point text); Body Text
     in exact 32.2 pt line boxes (644 twips: typst pitch-double, Word's double line at 14 pt; TRAP 9.4(d) double
     spacing) with a half-inch first-line indent (typst para-indent); single lines 16.1 pt (322 twips: typst
     pitch-single) for the cover, headings, quotations, tables, signature and footer; List Item the label in a
     half-inch box; footnotes 12 pt (size 24; TRAP 9.4(e)) in 13.8 pt boxes (276 twips: typst pitch-note), 7 pt after
     each (140 twips: typst note-gap), kept whole on one page. Overridden or added here: Heading 1 (centered, bold,
     no capitals of its own), Heading 2 (bold, flush left) and Heading 3 (bold italic, half an inch in), single lines
     12.9 pt above and 3.2 pt below (258 and 64 twips: typst heading-above, heading-below, which keep a heading on
     the text's double-spaced grid), kept with the next paragraph (typst sticky); Block Text single-spaced, 1 in in
     from both margins, 16.1 pt above, below and between its paragraphs (typst quote-indent, pitch-single); "Body
     Text Note" (Body Text without widow control, for a paragraph that anchors a footnote: typst may move such a
     paragraph's last line on alone); "Body Keep" (the prayer's last paragraph, kept with the signature block: typst
     sets them in one unbreakable block); "Identity" (the identities of parties and counsel, single-spaced, 8 pt
     apart: typst gap). Letter paper with 1-inch margins; the page number in a 16.1 pt line whose foot is 34.3 pt
     above the page edge (686 twips: where typst sets it, footer-descent 30 %). The filter (docx/tex-*.lua) writes
     the cover, headings, tables, signature and sections with their own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="28" body="644" single="322" indent="720" list="720" heading="322" heading-before="258" heading-after="64" quote="322" note="276" note-size="24" note-after="140" footer="686">
<w:style w:type="paragraph" w:styleId="Heading1"><w:name w:val="heading 1"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="258" w:after="64" w:line="322" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:jc w:val="center"/><w:outlineLvl w:val="0"/></w:pPr><w:rPr><w:b/><w:bCs/><w:color w:val="000000"/></w:rPr></w:style>
<w:style w:type="paragraph" w:styleId="Heading2"><w:name w:val="heading 2"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="258" w:after="64" w:line="322" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:outlineLvl w:val="1"/></w:pPr><w:rPr><w:b/><w:bCs/><w:color w:val="000000"/></w:rPr></w:style>
<w:style w:type="paragraph" w:styleId="Heading3"><w:name w:val="heading 3"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="258" w:after="64" w:line="322" w:lineRule="exact"/><w:ind w:left="720" w:firstLine="0"/><w:outlineLvl w:val="2"/></w:pPr><w:rPr><w:b/><w:bCs/><w:i/><w:iCs/><w:color w:val="000000"/></w:rPr></w:style>
<w:style w:type="paragraph" w:styleId="BlockText"><w:name w:val="Block Text"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:spacing w:before="322" w:after="322" w:line="322" w:lineRule="exact"/><w:ind w:left="1440" w:right="1440" w:firstLine="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyKeep"><w:name w:val="Body Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Identity"><w:name w:val="Identity"/><w:basedOn w:val="Normal"/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="160" w:line="322" w:lineRule="exact"/><w:ind w:firstLine="0"/></w:pPr></w:style>
<footer id="rIdFooter1"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="322" w:lineRule="exact"/><w:jc w:val="center"/></w:pPr><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:r><w:t>1</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r></w:p></footer>
</reference>
