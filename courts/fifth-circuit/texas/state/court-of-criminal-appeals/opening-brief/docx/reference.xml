<?xml version="1.0" encoding="UTF-8"?>
<!-- The Court of Criminal Appeals of Texas brief on the merits: Word styles. The cross-engine recipe
     (tools/fb/src/docxxengine.rs) in the face of the typst template ({font}, Times New Roman; TRAP 9.4(e) asks for a
     conventional typeface, docs/FONTS.md rule 6) at 14 pt (size 28 half points; TRAP 9.4(e)); Body Text in exact
     32.2 pt line boxes (644 twips: typst pitch-body, TRAP 9.4(d) double spacing) with a half-inch first-line indent on
     every paragraph (typst para-indent); single lines 16.1 pt (322 twips: typst pitch-single); List Item the label in
     a half-inch box; footnotes 12 pt (note-size 24; TRAP 9.4(e)) in 13.8 pt boxes (276 twips: typst pitch-note), 7 pt
     after each (140 twips: typst note-gap). Added here, all single lines (322 twips) with typst's spaces:
     "Head 1" (centered bold capitals, a body line above, 644 twips, a single line below, 322: typst head-above, gap),
     "Head 1 Top" (the same opening a section: Word keeps the space above a paragraph after a section break, typst
     drops it at the top of a page) and "Head 1 Break" (the same opening a page: the front matter's identity,
     contents and index each start a page); "Head 2" (bold) and "Head 3" (italic), a single line above and below; all
     headings kept with the next paragraph (typst sticky); "Single Block" (identity, signature and certificate blocks:
     a single line above and below, lines kept together; typst unbreakable) and "Single Block Keep" (one followed by
     another in the body: kept with it, typst sticky); "Body Text Note" (Body Text without widow control, for a
     paragraph that anchors a footnote: typst may move its last line on alone). Contents and index rows, the cover
     and the section breaks are written by docx/texcrimapp-opening-brief.lua. The page number sits in a 16.1 pt
     footer line written by the filter (sections in $FORMBOOK_FOOTERS / $FORMBOOK_FINAL, w:footer 686 twips: 1 in
     margin - typst footer-descent 21.6 pt - 16.1 pt). Twips: 20 x pt. Markdown is read with smart punctuation off
     (pandoc-from, as the typst template reads it), so the dots that mark a contents entry stay dots. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" pandoc-from="markdown-smart" size="28" body="644" single="322" indent="720" list="720" heading="322" heading-before="644" heading-after="322" quote="322" note="276" note-size="24" note-after="140" footer="686">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Head1"><w:name w:val="Head 1"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="644" w:after="322" w:line="322" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:jc w:val="center"/><w:outlineLvl w:val="0"/></w:pPr><w:rPr><w:b/><w:bCs/><w:caps/></w:rPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Head1Top"><w:name w:val="Head 1 Top"/><w:basedOn w:val="Head1"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="322" w:line="322" w:lineRule="exact"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Head1Break"><w:name w:val="Head 1 Break"/><w:basedOn w:val="Head1Top"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:pageBreakBefore/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Head2"><w:name w:val="Head 2"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="322" w:after="322" w:line="322" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:jc w:val="left"/><w:outlineLvl w:val="1"/></w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Head3"><w:name w:val="Head 3"/><w:basedOn w:val="Head2"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:outlineLvl w:val="2"/></w:pPr><w:rPr><w:b w:val="0"/><w:bCs w:val="0"/><w:i/><w:iCs/></w:rPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="SingleBlock"><w:name w:val="Single Block"/><w:basedOn w:val="Normal"/><w:qFormat/><w:pPr><w:keepLines/><w:spacing w:before="322" w:after="322" w:line="322" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:jc w:val="left"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="SingleBlockKeep"><w:name w:val="Single Block Keep"/><w:basedOn w:val="SingleBlock"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
</reference>
