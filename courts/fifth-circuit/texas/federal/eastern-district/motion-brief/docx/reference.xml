<?xml version="1.0" encoding="UTF-8"?>
<!-- The E.D. Tex. motion's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face of the typst
     template ({font}, Times New Roman) at 12 pt (CV-10(a)(5): no smaller than 12-point, footnotes and page number
     too; size 24 half points); Body Text in exact 27.6 pt line boxes (typst pitch-double, CV-10(a)(5) double spaced)
     with a half-inch first-line indent, and the headings in them; the court title, caption, title, quotation (Block
     Text, a single line above and below, half an inch in from both margins), signature and footnote lines in 13.8 pt
     boxes (typst pitch-single), 6 pt after each footnote (typst note-gap); letter page with 1-inch margins and a
     centered page number, its line 36.75 pt above the page foot (735 twips: where typst sets it, footer-descent
     30 %). Added: First Paragraph without the indent (typst indents a paragraph only after a paragraph), Lettered
     Item (the letter half an inch in, the text hanging a further half inch), Block Text First, Middle and Last
     (a quotation of several paragraphs: no space between them, as in typst), and Noted variants without widow
     control for a paragraph that holds a footnote (typst moves the line with the reference on with its note, even
     when that leaves a widow). docx/txed-motion-brief.lua writes the cover, headings, signature and certificate of
     service with their own spacing. The body is read without fancy_lists, as typst's CommonMark reads it ("(617)
     535-4000" or "a. ..." is text, not a list). Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="552" single="276" indent="720" heading="552" heading-before="0" heading-after="0" quote="276" note-after="120" footer="735" pandoc-from="markdown-fancy_lists">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="FirstParagraph"><w:name w:val="First Paragraph"/><w:basedOn w:val="BodyText"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:ind w:firstLine="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="FirstParagraphNoted"><w:name w:val="First Paragraph Noted"/><w:basedOn w:val="FirstParagraph"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNoted"><w:name w:val="Body Text Noted"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BlockTextFirst"><w:name w:val="Block Text First"/><w:basedOn w:val="BlockText"/><w:qFormat/><w:pPr><w:spacing w:after="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BlockTextMiddle"><w:name w:val="Block Text Middle"/><w:basedOn w:val="BlockText"/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BlockTextLast"><w:name w:val="Block Text Last"/><w:basedOn w:val="BlockText"/><w:qFormat/><w:pPr><w:spacing w:before="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="LetteredItem"><w:name w:val="Lettered Item"/><w:basedOn w:val="Normal"/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="0" w:line="552" w:lineRule="exact"/><w:ind w:left="1440" w:hanging="720"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="LetteredItemNoted"><w:name w:val="Lettered Item Noted"/><w:basedOn w:val="LetteredItem"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
</reference>
