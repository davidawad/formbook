// Motion to dismiss with memorandum, for the U.S. District Court for the Eastern District of Texas (txed), on the
// generic FRCP brief with E.D. Tex.'s local rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`,
// fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`).
// Content-agnostic: no case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// CV-10(a)(5): "a font no smaller than 12-point type"; the rule names no face: Times New Roman 12 pt, the house
// standard and the exemplars' face (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let txed-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
