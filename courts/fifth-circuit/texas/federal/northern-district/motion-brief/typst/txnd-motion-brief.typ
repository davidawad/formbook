// Brief in support of a motion, for the U.S. District Court for the Northern District of Texas (txnd), on the generic
// FRCP brief with N.D. Tex.'s local rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`,
// fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`).
// Content-agnostic: no case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LR 7.2: "12-point or larger"; the rule names no face: Times New Roman 12 pt, the house standard and the exemplars'
// face (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let txnd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
