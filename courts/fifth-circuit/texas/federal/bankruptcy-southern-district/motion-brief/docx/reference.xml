<?xml version="1.0" encoding="UTF-8"?>
<!-- The S.D. Tex. bankruptcy motion's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face
     of the typst template ({font}, Times New Roman) at 12 pt (no size in the S.D. Tex. rules; size 24 half points);
     Body Text in exact 24 pt line boxes (typst pitch-double, LR10.2 double spacing) with a half-inch indent, and the
     headings in them (level 1 as written, not in capitals, as typst sets it); the debtor footnote at 10 pt (typst
     note-size; 20 half points) in 11.5 pt boxes (typst pitch-note), 6 pt after it (typst note-gap); Caption Line, the
     caption's debtor line that carries the footnote, in a 13.8 pt box (typst pitch-single), as the caption, title,
     notice, signature and footer lines the filter writes; letter page (LR10.2) with 1-inch margins and a centered page
     number, its line 36.75 pt above the page foot (735 twips: where typst sets it, footer-descent 30 %).
     docx/motion.lua writes every other paragraph's own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="276" indent="720" heading="480" heading-before="0" heading-after="0" note="230" note-size="20" note-after="120" footer="735">
<w:style w:type="paragraph" w:styleId="Heading1"><w:name w:val="heading 1"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:uiPriority w:val="9"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:jc w:val="center"/><w:outlineLvl w:val="0"/></w:pPr><w:rPr><w:rFonts w:ascii="{font}" w:hAnsi="{font}" w:eastAsia="{font}" w:cs="{font}"/><w:b/><w:bCs/><w:color w:val="000000"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="CaptionLine"><w:name w:val="Caption Line"/><w:basedOn w:val="Normal"/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="exact"/><w:ind w:left="0" w:firstLine="0"/><w:jc w:val="left"/></w:pPr></w:style>
</reference>
