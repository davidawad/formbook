// Motion to dismiss with its brief, for the U.S. District Court for the Southern District of Texas (txsd), on the
// generic FRCP brief with S.D. Tex.'s rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`,
// fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`).
// Content-agnostic: no case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// No face is named by S.D. Tex. LR10.2 or the judges' procedures retrieved: Times New Roman, the house standard and
// the exemplar's face (docs/FONTS.md), at the 13 points of layout.yaml. Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let txsd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
