// Memorandum brief supporting a motion, for the U.S. District Court for the Southern District of Mississippi (mssd), on
// the generic FRCP brief with the local rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`,
// fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`).
// Content-agnostic: no case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// L.U.Civ.R. 7(b)(5)(B): a proportionally spaced face with serifs: Times New Roman, the house standard and the
// exemplar's face (data/exemplar-fonts.json, docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

// L.U.Civ.R. 11(a): the signer's name, bar number, firm, address, telephone, fax and e-mail. The template refuses to
// render without them.
#let required-signature-keys = ("signer", "bar_no", "firm", "address", "telephone", "fax", "email")

#let mssd-motion-brief(meta, body) = {
  for k in required-signature-keys {
    assert(k in meta.signature, message: "mssd-motion-brief: signature." + k + " is required (L.U.Civ.R. 11(a))")
  }
  xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
}
