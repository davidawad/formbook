<?xml version="1.0" encoding="UTF-8"?>
<!-- The S.D. Miss. memorandum brief's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face
     of the typst template ({font}, Times New Roman: L.U.Civ.R. 7(b)(5)(B) asks for a proportional serif face, and the
     exemplar is set in it) at 12 pt (7(b)(5)(B): text 12-point or larger; size 24 half points); Body Text in exact
     27.6 pt line boxes (typst pitch-double, 7(b)(5)(A) double spacing) with a half-inch indent; headings, caption,
     signature and footer lines in 13.8 pt boxes (typst pitch-single), 13.8 pt above and below a heading (typst
     heading-space); footnotes at 11 pt (7(b)(5)(B): 11-point or larger; size 22) in 12.65 pt boxes (typst
     pitch-note), 7 pt after each (typst note-gap); letter page with 1-inch margins (7(b)(5)(A)) and a centered page
     number, its line 36.75 pt above the page foot (735 twips: where typst sets it, footer-descent 30 %). Two styles are
     added: Body Text Noted, a body paragraph that anchors a footnote, without widow control (typst: no widow or
     orphan costs for it), so a line stays on the page of its note in both engines; Body Keep, the last paragraph,
     kept whole and with the signature block (typst: one unbreakable block).
     docx/mssd-motion-brief.lua writes the other paragraphs' own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="552" single="276" indent="720" heading="276" heading-before="276" heading-after="276" note="253" note-size="22" note-after="140" footer="735">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNoted"><w:name w:val="Body Text Noted"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyKeep"><w:name w:val="Body Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
</reference>
