<?xml version="1.0" encoding="UTF-8"?>
<!-- The Bankr. S.D. Miss. adversary complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in
     the face of the typst template ({font}, Times New Roman) at 12 pt (Miss. Bankr. L.R. 5005-1(a)(2)(G): no smaller
     than 12 point, footnotes and footer too; size 24 half points); Body Text and the headings in exact 27.6 pt line
     boxes (typst pitch-double: 5005-1(a)(2)(G) double-spaced, Word's double) with a half-inch first-line indent;
     footnotes, caption, table and signature lines in 13.8 pt boxes (typst pitch-single; footnotes may be
     single-spaced), 7 pt after each footnote (typst note-gap); letter page (5005-1(a)(2)(G): 8 1/2 by 11) with 1-inch
     margins and a centered page number, its line 36.75 pt above the page foot (735 twips: where typst sets it,
     footer-descent 30 %). Added styles, the paragraphs pandoc writes with their footnotes: Numbered (the number at
     the half inch, a tab to the inch: typst numbered), Lettered (the letter at the half inch, the text hanging at the
     inch: typst lettered), and the Keep variants of them and of Body Text for the last block before the signature
     (kept with it). The markdown is read as CommonMark with smart punctuation, footnotes and pipe tables
     (pandoc-from), as typst's cmarker reads it. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" pandoc-from="commonmark+smart+yaml_metadata_block+footnotes+pipe_tables" size="24" body="552" single="276" indent="720" heading="552" heading-before="0" heading-after="0" note-after="140" footer="735">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyKeep"><w:name w:val="Body Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Numbered"><w:name w:val="Numbered"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:ind w:left="0" w:firstLine="720"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="NumberedKeep"><w:name w:val="Numbered Keep"/><w:basedOn w:val="Numbered"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Lettered"><w:name w:val="Lettered"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:ind w:left="1440" w:hanging="720"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="LetteredKeep"><w:name w:val="Lettered Keep"/><w:basedOn w:val="Lettered"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="NumberedNote"><w:name w:val="Numbered Note"/><w:basedOn w:val="Numbered"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="LetteredNote"><w:name w:val="Lettered Note"/><w:basedOn w:val="Lettered"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
</reference>
