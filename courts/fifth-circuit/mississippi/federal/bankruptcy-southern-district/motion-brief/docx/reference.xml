<?xml version="1.0" encoding="UTF-8"?>
<!-- The Bankr. S.D. Miss. memorandum brief's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the
     face of the typst template ({font}, Times New Roman) at 12 pt (Miss. Bankr. L.R. 5005-1(a)(2)(G): no smaller
     than 12 point, footnotes and footer too; size 24 half points); Body Text and the headings in exact 27.6 pt line
     boxes (typst pitch-double: 5005-1(a)(2)(G) double-spaced, Word's double) with a half-inch first-line indent;
     quotations, footnotes, caption, address and signature lines in 13.8 pt boxes (typst pitch-single; quotations and
     footnotes may be single-spaced), 7 pt after each footnote (typst note-gap); letter page (5005-1(a)(2)(G): 8 1/2
     by 11) with 1-inch margins and a centered page number, its line 36.75 pt above the page foot (735 twips: where
     typst sets it, footer-descent 30 %). Added styles, the paragraphs pandoc writes with their footnotes: Quote (0.75
     in left, 0.5 in right, a blank single line after it: typst block-quote), Body Keep (the last paragraph before the
     signature, kept with it) and the Note variants (a paragraph that anchors a footnote: no widow control, as typst
     sets it). The markdown is read as CommonMark with smart punctuation and footnotes (pandoc-from), as typst's
     cmarker reads it ("b. The ..." and "(1) the ..." stay text). Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" pandoc-from="commonmark+smart+yaml_metadata_block+footnotes" size="24" body="552" single="276" indent="720" heading="552" heading-before="0" heading-after="0" note-after="140" footer="735">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyKeep"><w:name w:val="Body Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Quote"><w:name w:val="Quote"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="276" w:line="276" w:lineRule="exact"/><w:ind w:left="1080" w:right="720" w:firstLine="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="QuoteNote"><w:name w:val="Quote Note"/><w:basedOn w:val="Quote"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
</reference>
