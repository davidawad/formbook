<?xml version="1.0" encoding="UTF-8"?>
<!-- The Bankr. N.D. Miss. adversary complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in
     the face of the typst template ({font}, TeX Gyre Termes: data/exemplar-fonts.json audits the filed exemplar as
     Type 1 Times, metric-exact Termes) at 12 pt (size 24 half points); Body Text and the headings in exact 27.6 pt
     line boxes (typst pitch-double: Word's double, as the exemplar is spaced) with a half-inch first-line indent;
     caption, title and signature lines in 13.8 pt boxes (typst pitch-single); ligatures off (w14:ligatures in
     docDefaults: Termes has fi/fl ligatures, which LibreOffice would form and typst does not set); letter page with
     1-inch margins and a centered page number, its line 36.75 pt above the page foot (735 twips: where typst sets
     it, footer-descent 30 %). docx/msnb-adversary-complaint.lua writes every paragraph with its own spacing and
     indents. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" mc:Ignorable="w14" base="xengine" size="24" body="552" single="276" indent="720" heading="552" heading-before="0" heading-after="0" footer="735">
<w:docDefaults>
    <w:rPrDefault>
      <w:rPr>
        <w:rFonts w:ascii="{font}" w:hAnsi="{font}" w:eastAsia="{font}" w:cs="{font}"/>
        <w:sz w:val="24"/>
        <w:szCs w:val="24"/>
        <w:lang w:val="en-US" w:eastAsia="zh-CN" w:bidi="ar-SA"/>
      <w14:ligatures w14:val="none"/></w:rPr>
    </w:rPrDefault>
    <w:pPrDefault>
      <w:pPr>
        <w:widowControl/>
        <w:spacing w:after="0"/>
      </w:pPr>
    </w:pPrDefault>
  </w:docDefaults>
</reference>
