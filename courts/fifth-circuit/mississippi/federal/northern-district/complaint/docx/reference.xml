<?xml version="1.0" encoding="UTF-8"?>
<!-- The msnd complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face of the typst
     template ({font}, Times New Roman) at 12 pt (size 24 half points; L.U.Civ.R. 7(b)(5)(B), the court's only
     typeface rule, applied for consistency); Body Text in exact 27.6 pt line boxes (typst pitch-double, Word's
     double, as the exemplar is spaced) with a half-inch first-line indent; the headings in them with no space of
     their own; footnotes at 11 pt (size 22) in exact 12.65 pt boxes (typst pitch-note), 7 pt after each (typst
     note-gap); letter page with 1-inch margins (L.U.Civ.R. 7(b)(5)(A)) and a centered page number, its line 36.75 pt
     above the page foot (735 twips: where typst sets it, footer-descent 30 %). Two styles are added: Body Number, a
     numbered paragraph (Fed. R. Civ. P. 10(b)): the number at the indent, a tab to 0.9 in (typst number-box); and
     Body Keep, the last paragraph before the signature block, kept with it and a double line above it (typst
     signature-block above). docx/msnd-complaint.lua writes the cover, prayer and signature paragraphs' own spacing.
     Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" pandoc-from="commonmark+smart+footnotes+yaml_metadata_block" size="24" body="552" single="276" indent="720" heading="552" heading-before="0" heading-after="0" note="253" note-size="22" note-after="140" footer="735">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyNumber"><w:name w:val="Body Number"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1296"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="552" w:lineRule="exact"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyKeep"><w:name w:val="Body Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:tabs><w:tab w:val="left" w:pos="1296"/></w:tabs><w:spacing w:before="0" w:after="552" w:line="552" w:lineRule="exact"/></w:pPr></w:style>
</reference>
