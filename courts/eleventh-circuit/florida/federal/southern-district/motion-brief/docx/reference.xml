<?xml version="1.0" encoding="UTF-8"?>
<!-- The S.D. Fla. motion's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face of the
     typst template ({font}, Times New Roman) at 12 pt, footnotes too (L.R. 5.1(a)(4); size 24 half points); Body
     Text in exact 27.6 pt line boxes (typst pitch-double; L.R. 5.1(a)(4): at least 1 1/2 spaces, double as in the
     exemplar) with a half-inch first-line indent; headings, the caption, the signature block and the footnotes in
     13.8 pt boxes (typst pitch-single; L.R. 5.1(a)(4) lets footnotes be single-spaced), a heading a single line from
     the text on either side, footnotes 7 pt apart (typst note-gap); letter page with 1-inch margins
     (L.R. 5.1(a)(3), (4)) and the page number centered at the bottom (L.R. 5.1(a)(4)), its line 36.75 pt above the
     page foot (735 twips: where typst sets it, footer-descent 30 %). docx/flsd.lua writes every paragraph's own
     spacing. Twips: 20 x pt.
     One style of its own: "Body Text Note", Body Text without widow control, for a paragraph that carries a footnote
     mark (typst keeps a paragraph's last two lines together by their height alone; when the line's footnote does
     not fit, that line moves on and the one before stays behind; with widow control off Word does the same). -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="552" single="276" indent="720" heading="276" heading-before="276" heading-after="276" note-after="140" footer="735">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
</reference>
