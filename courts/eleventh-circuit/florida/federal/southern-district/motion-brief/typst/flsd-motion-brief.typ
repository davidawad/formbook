// Motion with its incorporated memorandum of law, for the U.S. District Court for the Southern District of Florida
// (flsd), on the generic FRCP brief with S.D. Fla.'s local rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and
// docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced breaks.
// Rule IDs (FLSD-...) refer to ../../rules.md. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// FLSD-FORM-003: L.R. 5.1(a)(4) sets 12-point type and names no face; Times New Roman, the house face (docs/FONTS.md;
// Liberation Serif its metric twin), as in the exemplar. Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let flsd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
