// Motion with its incorporated memorandum, for the U.S. District Court for the Northern District of Florida (flnd), on
// the generic FRCP brief with N.D. Fla.'s local rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and
// docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced breaks.
// See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// Loc. R. 5.1(C) names no face ("at least 14-point font"): Times New Roman, the house standard and the exemplar's
// (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let flnd-motion-brief(meta, body) = {
  // Loc. R. 7.1(F): the memorandum includes a certificate of its word count; Loc. R. 5.1(F): a certificate of service.
  assert(body.match(regex("(?im)^#\\s+CERTIFICATE OF COMPLIANCE")) != none, message:
    "flnd-motion-brief: N.D. Fla. Loc. R. 7.1(F) needs a certificate of the word count (a level 1 heading CERTIFICATE OF COMPLIANCE ...)")
  xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
}
