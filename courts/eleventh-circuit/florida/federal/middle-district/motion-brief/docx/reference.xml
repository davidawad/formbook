<!-- The M.D. Fla. motion brief's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face of the
     typst template ({font}, Times New Roman) at 14 pt (LR 1.08(a)-(b): Times New Roman at least 14-point; size 28
     half points); Body Text in exact 32.2 pt line boxes (typst pitch-double, LR 1.08(a) double-spaced) with a
     half-inch indent, and the headings in them; the caption, quotation, signature and footer lines in 16.1 pt boxes (typst
     pitch-single); letter page with 1-inch margins (LR 1.08(a)) and a centered page number from page two (titlePg:
     LR 1.08(a) needs none on page one), its line 34.3 pt above the page foot (686 twips: where typst sets it,
     footer-descent 30 %). Heading 1 without the recipe's capitals: typst prints a heading as written.
     docx/flmd-motion-brief.lua writes every paragraph's own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="28" body="644" single="322" indent="720" heading="644" heading-before="0" heading-after="0" footer="686" pandoc-from="markdown+smart-definition_lists">
<w:style w:type="paragraph" w:styleId="Heading1"><w:name w:val="heading 1"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:uiPriority w:val="9"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="0" w:after="0" w:line="644" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:jc w:val="center"/><w:outlineLvl w:val="0"/></w:pPr><w:rPr><w:rFonts w:ascii="{font}" w:hAnsi="{font}" w:eastAsia="{font}" w:cs="{font}"/><w:b/><w:bCs/><w:color w:val="000000"/><w:sz w:val="28"/><w:szCs w:val="28"/></w:rPr></w:style>
<w:sectPr><w:footerReference w:type="default" r:id="rIdFooter1"/><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="720" w:footer="686" w:gutter="0"/><w:titlePg/></w:sectPr>
</reference>
