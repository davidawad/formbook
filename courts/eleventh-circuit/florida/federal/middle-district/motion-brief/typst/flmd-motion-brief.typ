// Motion with its incorporated legal memorandum, for the U.S. District Court for the Middle District of Florida (flmd),
// on the generic FRCP brief with M.D. Fla.'s local rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and
// docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced breaks.
// Rule IDs (FLMD-...) refer to ../../rules.md. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// FLMD-FORM-004: LR 1.08(b) allows Times New Roman at 14 point (the house face, docs/FONTS.md; Liberation Serif its
// metric twin). The filed exemplar sets Book Antiqua, LR 1.08(a). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let flmd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
