<?xml version="1.0" encoding="UTF-8"?>
<!-- The S.D. Fla. Bankruptcy motion brief's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the
     face of the typst template ({font}, Times New Roman) at 12 pt (L.R. 9004-1(a)(3); size 24 half points); Body Text
     in exact 24 pt line boxes (typst pitch-double, L.R. 9004-1(a)(4) double spacing) with a half-inch first-line
     indent; the caption, title, headings, quotations, signature and certificates single-spaced in 13.8 pt boxes
     (typst pitch-single); Block Text 0.5 in in on both sides, 12 pt (240 twips) above and below; footnotes 10 pt
     (L.R. 9004-1(a)(3); size 20) in 11.5 pt boxes (typst pitch-note), 7 pt apart; one style of its own, "Lettered"
     (a "(i) ..." parenthetical: Body Text 0.5 in in, no first-line indent). Letter page with 1-inch margins
     (L.R. 9004-1(a)(2)) and a centered page number, its line 36.75 pt above the page foot (735 twips: where typst
     sets it, footer-descent 30 %). docx/flsb-motion-brief.lua writes every paragraph's own spacing; pandoc writes
     a paragraph with a footnote in these styles. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="276" indent="720" heading="276" heading-before="240" heading-after="240" quote="240" note="230" note-size="20" note-after="140" footer="735" pandoc-from="markdown+smart-fancy_lists">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Lettered">
    <w:name w:val="Lettered"/>
    <w:basedOn w:val="BodyText"/>
    <w:qFormat/>
    <w:pPr>
      <w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/>
      <w:ind w:left="720" w:firstLine="0"/>
    </w:pPr>
  </w:style>
</reference>
