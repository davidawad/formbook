<?xml version="1.0" encoding="UTF-8"?>
<!-- The M.D. Fla. adversary complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face
     of the typst template ({font}, Times New Roman, Style Guide II.A) at 12 pt (size 24 half points); Body Text in
     exact 27.6 pt line boxes (typst pitch-double) with a half-inch first-line indent, and the headings in them;
     footnotes 12 pt in 13.8 pt boxes (typst pitch-single), 7 pt apart (typst note-gap). Added: Numbered Paragraph
     (Body Text with a tab stop at 1 in: the number in the half-inch box after the indent, typst body-par()) and
     Lettered Item (the letter at 0.5 in, the text hanging at 1 in). Letter page with 1-inch margins; the page number
     centered in a 13.8 pt footer line 36.6 pt above the page foot (732 twips: where typst sets it, footer-descent
     30 %), on every page but the first (Style Guide II.A: an empty first-page footer); footnotes numbered through the
     document. docx/flmb-pleading.lua writes every other paragraph's own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="552" single="276" indent="720" heading="552" heading-before="0" heading-after="0" note="276" note-after="140" footer="732">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="NumberedParagraph"><w:name w:val="Numbered Paragraph"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="552" w:lineRule="exact"/><w:ind w:firstLine="720"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="LetteredItem"><w:name w:val="Lettered Item"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="552" w:lineRule="exact"/><w:ind w:left="1440" w:hanging="720"/></w:pPr></w:style>
<footer id="rIdFlmbPage"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="exact"/><w:jc w:val="center"/></w:pPr><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:r><w:t>1</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r></w:p></footer>
<footer id="rIdFlmbFirst"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="exact"/></w:pPr></w:p></footer>
<w:sectPr><w:footerReference w:type="default" r:id="rIdFlmbPage"/><w:footerReference w:type="first" r:id="rIdFlmbFirst"/><w:footnotePr><w:numRestart w:val="continuous"/></w:footnotePr><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="720" w:footer="732" w:gutter="0"/><w:titlePg/></w:sectPr>
</reference>
