<?xml version="1.0" encoding="UTF-8"?>
<!-- The M.D. Fla. Bankruptcy motion's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face
     of the typst template ({font}, Times New Roman, Style Guide II.A) at 12 pt (size 24 half points); Body Text in
     exact 27.6 pt line boxes (552 twips, typst pitch-body: double spacing, two single lines, Local Rule 7001-1(k)(2)) with a half-inch
     first-line indent; headings, caption, title, signature and footnotes in 13.8 pt boxes (276 twips, typst
     pitch-single), footnotes 7 pt apart (140); "Numbered Paragraph" puts the text after the number at a tab 1 in
     from the margin (typst number-box), "Conclusion Item" hangs half an inch after a number half an inch in (typst
     list-box), its last item kept with the signature block. Letter page with 1-inch margins (Local Rule 5005-1(d));
     the page number centered on every page but the first (Style Guide II.A; titlePg, an empty first-page footer),
     its line 36.75 pt above the page foot (735 twips: where typst sets it, footer-descent 30 %).
     docx/flmb-motion-brief.lua writes every other paragraph's own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="552" single="276" indent="720" heading="276" heading-before="552" heading-after="0" note="276" note-after="140" footer="735">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="NumberedParagraph"><w:name w:val="Numbered Paragraph"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="552" w:lineRule="exact"/><w:ind w:firstLine="720"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="ConclusionItem"><w:name w:val="Conclusion Item"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="552" w:lineRule="exact"/><w:ind w:left="1440" w:hanging="720"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="ConclusionItemLast"><w:name w:val="Conclusion Item Last"/><w:basedOn w:val="ConclusionItem"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<footer id="rIdFooterFirst"><w:p><w:pPr><w:jc w:val="center"/></w:pPr></w:p></footer>
<w:sectPr><w:footerReference w:type="default" r:id="rIdFooter1"/><w:footerReference w:type="first" r:id="rIdFooterFirst"/><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="720" w:footer="735" w:gutter="0"/><w:titlePg/></w:sectPr>
</reference>
