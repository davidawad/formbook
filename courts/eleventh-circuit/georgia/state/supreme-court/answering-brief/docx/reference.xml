<?xml version="1.0" encoding="UTF-8"?>
<!-- The Georgia Supreme Court brief's Word styles (answering, opening and reply briefs share them): the shared style
     recipe of the cross-engine layout model (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md, "Cross-engine gate") in
     the face of the typst template ({font}: TeX Gyre Schola, the vendored Century Schoolbook; SCt R 16(1), 16(2)) at
     13 pt (size 26 half points; SCt R 16(2)). Body Text in exact 31.2 pt line boxes (624 twips: typst pitch-body,
     double spacing, SCt R 16(4)) with a half-inch first-line indent (typst indent); single lines 15.6 pt (312 twips:
     typst pitch-single, 1.2 x 13 pt, the rule's floor); Block Text (quotations) single-spaced, half an inch in on both
     sides, half a single line (156 twips: typst half) around a quotation and between its paragraphs; List Item with
     the label in a half-inch box; footnotes 11 pt (size 22; SCt R 16(2)) in 13.2 pt boxes (264 twips: typst
     pitch-note), 6.6 pt after each (132 twips: typst note-gap), kept whole on one page. Replaced here: Heading 1
     (centered, bold, 15.6 pt above and 7.8 pt below, no capitals: the sample's headings are typed as filed), Heading 2
     (bold, 7.8 pt above) and Heading 3 (bold italic, 7.8 pt above), all at 13 pt in single lines and kept with the
     next paragraph (typst sticky), and "Heading 1 Top", "Heading 2 Top" and "Heading 3 Top" (each heading style without the space above, for the heading that opens
     the body after a section break: Word keeps the space there, typst drops it at the top of a page). Added: "First Paragraph" without the indent (typst indents a paragraph only after a paragraph), "Body
     Text Note" and "First Paragraph Note" (without widow control, for a paragraph that anchors a footnote: typst may
     move such a paragraph's last line on alone). docDefaults carry w14:ligatures none, so fb render converts the
     docx with LibreOffice's ":-liga" font names (tools/fb/src/doclig.rs): Schola has fi and fl ligatures, which
     typst and Word do not set. The page, sections and footers come from docx/ga-brief.lua and fb render; the cover,
     tables, closing and certificate of service are written by ga-brief.lua with their own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" mc:Ignorable="w14" base="xengine" size="26" body="624" single="312" indent="720" list="720" heading="312" heading-before="156" heading-after="0" quote="156" note="264" note-size="22" note-after="132">
<w:docDefaults>
    <w:rPrDefault>
      <w:rPr>
        <w:rFonts w:ascii="{font}" w:hAnsi="{font}" w:eastAsia="{font}" w:cs="{font}"/>
        <w:sz w:val="26"/>
        <w:szCs w:val="26"/>
        <w:lang w:val="en-US" w:eastAsia="zh-CN" w:bidi="ar-SA"/>
      <w14:ligatures w14:val="none"/></w:rPr>
    </w:rPrDefault>
    <w:pPrDefault>
      <w:pPr>
        <w:widowControl/>
        <w:spacing w:after="0"/>
      </w:pPr>
    </w:pPrDefault>
  </w:docDefaults>
<w:style w:type="paragraph" w:styleId="Heading1"><w:name w:val="heading 1"/><w:basedOn w:val="Normal"/><w:next w:val="FirstParagraph"/><w:uiPriority w:val="9"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="312" w:after="156" w:line="312" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:jc w:val="center"/><w:outlineLvl w:val="0"/></w:pPr><w:rPr><w:b/><w:bCs/><w:color w:val="000000"/></w:rPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Heading1Top"><w:name w:val="Heading 1 Top"/><w:basedOn w:val="Heading1"/><w:next w:val="FirstParagraph"/><w:qFormat/><w:pPr><w:spacing w:before="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:styleId="Heading2"><w:name w:val="heading 2"/><w:basedOn w:val="Normal"/><w:next w:val="FirstParagraph"/><w:uiPriority w:val="9"/><w:unhideWhenUsed/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="156" w:after="0" w:line="312" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:outlineLvl w:val="1"/></w:pPr><w:rPr><w:b/><w:bCs/><w:color w:val="000000"/></w:rPr></w:style>
<w:style w:type="paragraph" w:styleId="Heading3"><w:name w:val="heading 3"/><w:basedOn w:val="Normal"/><w:next w:val="FirstParagraph"/><w:uiPriority w:val="9"/><w:unhideWhenUsed/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="156" w:after="0" w:line="312" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:outlineLvl w:val="2"/></w:pPr><w:rPr><w:b/><w:bCs/><w:i/><w:iCs/><w:color w:val="000000"/></w:rPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Heading2Top"><w:name w:val="Heading 2 Top"/><w:basedOn w:val="Heading2"/><w:next w:val="FirstParagraph"/><w:qFormat/><w:pPr><w:spacing w:before="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Heading3Top"><w:name w:val="Heading 3 Top"/><w:basedOn w:val="Heading3"/><w:next w:val="FirstParagraph"/><w:qFormat/><w:pPr><w:spacing w:before="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="FirstParagraph"><w:name w:val="First Paragraph"/><w:basedOn w:val="BodyText"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:ind w:firstLine="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="FirstParagraphNote"><w:name w:val="First Paragraph Note"/><w:basedOn w:val="FirstParagraph"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
</reference>
