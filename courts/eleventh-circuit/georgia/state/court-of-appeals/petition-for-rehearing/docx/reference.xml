<?xml version="1.0" encoding="UTF-8"?>
<!-- The Court of Appeals of Georgia motion for reconsideration's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the
     face of the typst template ({font}, Times New Roman; Rule 2 (c) (3) names it as a compliant face) at 14 pt (size
     28 half points; Rule 2 (c) (3), footnotes included); Body Text in exact 32.2 pt line boxes (644 twips: typst
     pitch-body, double spacing, Rule 2 (c) (2)) with a half-inch first-line indent (typst para-indent); single lines
     16.1 pt (322 twips: typst pitch-single); Block Text (quotations, Rule 2 (c) (2) exclusion) single-spaced, half an
     inch in on both sides, half a single line (161 twips: typst half) around a quotation and between its paragraphs;
     List Item the label in a half-inch box at the body pitch; footnotes 14 pt in 16.1 pt boxes, 8.05 pt after each
     (161 twips), kept whole on one page (typst sets each note as one unbreakable block). Added here: "Head 1"
     (centered, bold; the filter sets the text in capitals), "Head 2" (bold, wrapped lines hanging half an inch) and
     "Head 3" (bold italic, the same), single lines a single line below the text before them and half a line above
     the text after them (322 and 161 twips: typst pitch-single, half), kept with the next paragraph (typst sticky);
     "Body Text Note" (Body Text without widow control, for a paragraph that anchors a footnote: typst may move such a
     paragraph's last line on alone); "Head 1 Page", "Body Text Page" and "Body Text Note Page" (the body's first block opens
     a page with no space above it, as typst sets it after a page break). The page-number footer, its section and the cover, tables, signature and
     certificate of service are written by docx/gactapp-motion.lua (Letter, 1 in margins, Rule 24 (c); the page
     number centered in a 16.1 pt line whose foot is 34.3 pt above the page edge, 686 twips: 1 in margin - typst
     footer-descent 30 % - 16.1 pt; Rule 24 (e)). Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="28" body="644" single="322" indent="720" list="720" heading="322" heading-before="322" heading-after="161" quote="161" note="322" note-after="161" footer="686">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Head1"><w:name w:val="Head 1"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="322" w:after="161" w:line="322" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:jc w:val="center"/><w:outlineLvl w:val="0"/></w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Head2"><w:name w:val="Head 2"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="322" w:after="161" w:line="322" w:lineRule="exact"/><w:ind w:left="720" w:hanging="720"/><w:outlineLvl w:val="1"/></w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Head3"><w:name w:val="Head 3"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="322" w:after="161" w:line="322" w:lineRule="exact"/><w:ind w:left="720" w:hanging="720"/><w:outlineLvl w:val="2"/></w:pPr><w:rPr><w:b/><w:bCs/><w:i/><w:iCs/></w:rPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Head1Page"><w:name w:val="Head 1 Page"/><w:basedOn w:val="Head1"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:pageBreakBefore/><w:spacing w:before="0" w:after="161" w:line="322" w:lineRule="exact"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextPage"><w:name w:val="Body Text Page"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:pageBreakBefore/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNotePage"><w:name w:val="Body Text Note Page"/><w:basedOn w:val="BodyTextNote"/><w:qFormat/><w:pPr><w:pageBreakBefore/></w:pPr></w:style>
</reference>
