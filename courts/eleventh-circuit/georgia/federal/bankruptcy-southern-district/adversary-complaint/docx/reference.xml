<?xml version="1.0" encoding="UTF-8"?>
<!-- The S.D. Ga. bankruptcy adversary complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in
     the face of the typst template ({font}, Times New Roman) at 12 pt (size 24 half points); Body Text in exact 24 pt
     line boxes (typst pitch-body, GASB-FORM-002 double spacing) with a half-inch first-line indent; the court title,
     caption, headings, footnotes and signature lines in 13.8 pt boxes (typst pitch-single), a heading half a body
     line from the text on either side, 7 pt after each footnote (typst footnote.entry gap); letter page with 1-inch
     margins and a centered 11 pt page number on every page (LR 10.1), its 13.8 pt line 36.75 pt above the page foot
     (735 twips: where typst sets it, footer-descent 30 %). docx/gasb-adversary-complaint.lua writes the caption,
     title, headings and signature with their own spacing; Body Text Note (no widow control) is a paragraph that anchors a footnote. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="276" indent="720" heading="276" heading-before="240" heading-after="240" note="276" note-after="140" footer="735">
  <footer id="rIdFooter1"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="exact"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:fldChar w:fldCharType="begin" /></w:r><w:r><w:rPr><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r><w:r><w:rPr><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:fldChar w:fldCharType="separate" /></w:r><w:r><w:rPr><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t>1</w:t></w:r><w:r><w:rPr><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:fldChar w:fldCharType="end" /></w:r></w:p></footer>
  <w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
</reference>
