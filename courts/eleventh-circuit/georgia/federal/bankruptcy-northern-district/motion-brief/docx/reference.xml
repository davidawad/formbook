<?xml version="1.0" encoding="UTF-8"?>
<!-- The Bankr. N.D. Ga. motion's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the
     face of the typst template ({font}, Times New Roman) at 12 pt (size 24 half points); Body Text in exact 20.7 pt
     line boxes (typst pitch-body, GANB-FORM-003 one and one-half spacing) with a half-inch indent; the court title,
     caption, level 2 and 3 headings, quotations, signature and certificate lines in 13.8 pt boxes (typst pitch-single);
     footnotes 11 pt in 12.65 pt boxes (typst pitch-note), 6 pt after each; letter page with 1-inch
     margins and a centered 11 pt page number (GANB-FORM-005) in a single-pitch line, 36.75 pt above the page foot
     (735 twips: where typst sets it, footer-descent 30 %). docx/ganb-motion-brief.lua writes every
     paragraph's own spacing; the body paragraphs are in Body Para (Body Text 14.4 pt from the blocks around
     it, typst par-gap), so that pandoc writes their footnotes. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="414" single="276" indent="720" heading="276" heading-before="288" heading-after="288" footer="735" note="253" note-size="22" note-after="120">
  <w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyPara"><w:name w:val="Body Para"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:spacing w:before="288" w:after="288" w:line="414" w:lineRule="exact"/><w:ind w:left="0" w:firstLine="720"/><w:jc w:val="left"/></w:pPr></w:style>
  <footer id="rIdFooter1"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="exact"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:fldChar w:fldCharType="begin" /></w:r><w:r><w:rPr><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r><w:r><w:rPr><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:fldChar w:fldCharType="separate" /></w:r><w:r><w:rPr><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t>1</w:t></w:r><w:r><w:rPr><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:fldChar w:fldCharType="end" /></w:r></w:p></footer>
</reference>
