// Brief in support of a motion, for the U.S. District Court for the Middle District of Georgia (gamd), on the generic
// FRCP brief with M.D. Ga.'s rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`,
// fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`).
// Content-agnostic: no case-specific text, measured coordinates or forced breaks. Rule IDs (GAMD-...) refer to
// ../../rules.md. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// GAMD-FORM-001: the local rules name no face; Times New Roman, the house face where no rule names one
// (docs/FONTS.md rule 6; Liberation Serif its metric twin), the exemplar's. Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let gamd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
