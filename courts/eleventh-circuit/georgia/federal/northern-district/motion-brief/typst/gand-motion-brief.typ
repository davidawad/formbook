// Motion with supporting memorandum of law, for the U.S. District Court for the Northern District of Georgia (gand),
// on the generic FRCP brief with N.D. Ga.'s local rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and
// docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced breaks.
// Rule IDs (GAND-...) refer to ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// GAND-FORM-001: LR 5.1(C) names Times New Roman at 14 point first (layout.yaml `size`); Liberation Serif its metric
// twin (docs/FONTS.md). The LR 7.1(D) certificate names the same face. Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

/// A required frontmatter field. A missing one stops the render: the form cannot be left incomplete.
#let need(meta, key) = {
  assert(key in meta, message: "gand-motion-brief: frontmatter field `" + key + "` is required")
  meta.at(key)
}

#let gand-motion-brief(meta, body) = {
  let _ = need(meta, "division")
  let _ = need(meta, "service_text")
  let s = need(meta, "signature")
  for k in ("signer", "firm", "address", "phone", "role") { let _ = need(s, k) }
  // GAND-FORM-005, LR 5.1(G): name, complete address, telephone, email and bar number on every document.
  let attorneys = need(s, "attorneys")
  assert(attorneys.len() > 0, message: "gand-motion-brief: LR 5.1(G) needs at least one attorney block")
  for a in attorneys {
    for k in ("name", "bar", "email") {
      assert(k in a, message: "gand-motion-brief: LR 5.1(G) needs `" + k + "` for every attorney")
    }
  }
  xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
}
