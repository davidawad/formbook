<?xml version="1.0" encoding="UTF-8"?>
<!-- The S.D. Ga. memorandum's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face of the
     typst template ({font}, Times New Roman) at 12 pt (size 24 half points); Body Text in exact 24 pt line boxes
     (typst pitch-body, LR 10.1 double spacing) with a half-inch indent and 16.2 pt after (typst gap), the headings
     in 24 pt boxes 16.2 pt from the text on either side; footnotes 12 pt in 13.8 pt boxes (typst pitch-single), 7 pt
     apart; List Body: the label after the paragraph indent, the text hanging 0.4 in further; letter page with
     1-inch margins and the page number as "- N -" centered in the footer (LR 10.1), its line 36.75 pt above the page
     foot (735 twips: where typst sets it, footer-descent 30 %). docx/gasd-motion-brief.lua writes the cover,
     quotations, signature and certificate with their own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="276" indent="720" heading="480" heading-before="324" heading-after="324" note-after="140" footer="735">
<w:style w:type="paragraph" w:styleId="BodyText"><w:name w:val="Body Text"/><w:basedOn w:val="Normal"/><w:link w:val="BodyTextChar"/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="324" w:line="480" w:lineRule="exact"/><w:ind w:firstLine="720"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="ListBody"><w:name w:val="List Body"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1296"/></w:tabs><w:spacing w:before="0" w:after="324" w:line="480" w:lineRule="exact"/><w:ind w:left="1296" w:hanging="576"/></w:pPr></w:style>
<footer id="rIdFooter1"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="exact" /><w:jc w:val="center" /></w:pPr><w:r><w:t xml:space="preserve">- </w:t></w:r><w:r><w:fldChar w:fldCharType="begin" /></w:r><w:r><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r><w:r><w:fldChar w:fldCharType="separate" /></w:r><w:r><w:t>1</w:t></w:r><w:r><w:fldChar w:fldCharType="end" /></w:r><w:r><w:t xml:space="preserve"> -</w:t></w:r></w:p></footer>
</reference>
