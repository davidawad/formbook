// Memorandum of law in support of a motion, for the U.S. District Court for the Southern District of Georgia (gasd),
// on the generic FRCP brief with S.D. Ga.'s local rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and
// docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced breaks.
// See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// No S.D. Ga. rule names a face (LR 5.4, 10.1; ../README.md): Times New Roman, the house face where no rule names one
// (docs/FONTS.md rule 6; Liberation Serif its metric twin), the exemplar's. Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let gasd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
