// Memorandum in support of a motion, for the U.S. District Court for the Southern District of Alabama (alsd), on the
// generic FRCP brief with S.D. Ala.'s local rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`,
// fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`).
// Content-agnostic: no case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// Gen. L.R. 5(a)(2): "a plain, Roman style (or similar) font"; no face named: Times New Roman, the house standard
// (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let alsd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
