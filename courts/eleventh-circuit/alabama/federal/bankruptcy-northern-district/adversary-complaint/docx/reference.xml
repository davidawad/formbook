<?xml version="1.0" encoding="UTF-8"?>
<!-- The N.D. Ala. bankruptcy adversary complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs)
     in the face of the typst template ({font}, Times New Roman) at 12 pt (size 24 half points; no local rule sets a
     size); Body Text in exact 27.6 pt line boxes (typst pitch-double, double-spaced) with a half-inch first-line
     indent; single lines in 13.8 pt boxes (typst pitch-single); footnotes 10 pt in 11.5 pt boxes, 7 pt apart (typst
     pitch-note, note-gap); letter page with 1-inch margins and a centered page number, its line 36.6 pt above the
     page foot (732 twips: where typst sets it, footer-descent 30 %). docx/alnb.lua writes every other paragraph's own
     spacing. Twips: 20 x pt.
     Styles of its own: "Allegation", Body Text with a tab at the end of the number box (typst number-width, 1 in
     from the margin), for the numbered paragraphs (Fed. R. Civ. P. 10(b)); "Body Text Note" and "Allegation Note",
     the same without widow control, for a paragraph that carries a footnote mark (typst lets the line with the mark
     move on alone when its note does not fit; Word's widow control would move the line before it too). -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="552" single="276" indent="720" heading="276" note="230" note-size="20" note-after="140" footer="732">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Allegation"><w:name w:val="Allegation"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="AllegationNote"><w:name w:val="Allegation Note"/><w:basedOn w:val="Allegation"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
</reference>
