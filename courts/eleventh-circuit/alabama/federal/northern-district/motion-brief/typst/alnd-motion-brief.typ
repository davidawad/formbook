// Memorandum in support of a motion, for the U.S. District Court for the Northern District of Alabama (alnd), with a
// table of contents and a table of authorities, on the generic FRCP brief with N.D. Ala.'s practice overlaid
// (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`, fb-595.17), set by the shared document model
// (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text,
// measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// The local rules name no face: Times New Roman, the house standard and the exemplar's (docs/FONTS.md). Vendored in
// /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let alnd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
