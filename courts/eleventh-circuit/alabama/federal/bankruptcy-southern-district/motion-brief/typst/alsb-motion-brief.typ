// A motion, or a brief in support of one, for the U.S. Bankruptcy Court for the Southern District of Alabama (alsb),
// on the generic FRCP brief with the court's rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and
// docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced
// breaks. Rule IDs (ALSB-...) refer to ../../rules.md. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// ALSB-FORM-001: no rule names a face or size (FRBP 9004(a): "clearly legible"; the S.D. Ala. Local Bankruptcy Rules
// of July 1, 2026 have no form rule); Times New Roman, the house face (docs/FONTS.md; Liberation Serif its metric
// twin), as all three exemplars set it. Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let alsb-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
