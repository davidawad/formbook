<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Continuous paragraph numbers for the "Numbered Paragraph" style (numId 1): "1." at the 0.5 in indent, text follows after a space,
     wrapped lines return to the margin. Matches the typst template's numbered paragraphs (Fed. R. Civ. P. 10(b) via Rule 7010). -->
<w:numbering xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">
  <w:abstractNum w:abstractNumId="0">
    <w:multiLevelType w:val="singleLevel"/>
    <w:lvl w:ilvl="0">
      <w:start w:val="1"/>
      <w:numFmt w:val="decimal"/>
      <w:lvlText w:val="%1."/>
      <w:lvlJc w:val="left"/>
      <w:suff w:val="space"/>
      <w:pPr>
        <w:ind w:left="0" w:firstLine="720"/>
      </w:pPr>
    </w:lvl>
  </w:abstractNum>
  <w:num w:numId="1">
    <w:abstractNumId w:val="0"/>
  </w:num>
</w:numbering>
