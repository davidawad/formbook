<?xml version="1.0" encoding="UTF-8"?>
<!-- The C.D. Ill. bankruptcy adversary complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs)
     in the face of the typst template ({font}, Times New Roman; ILCB-TYPE-1, no rule names one) at 12 pt (size 24
     half points); Body Text in exact 27.6 pt line boxes (552 twips: typst pitch-body, Word's double line at 12 pt, as
     the exemplars set it) with a half-inch first-line indent; Body Keep the same, kept with the signature block;
     Body Text Note without widow control for a paragraph that anchors a footnote (typst moves its last line alone);
     footnotes 11 pt (22 half points) in 12.65 pt boxes (253 twips: typst pitch-note), 7 pt after each (typst
     footnote.entry gap), split where typst splits them (no keep-lines); letter page with 1-inch margins and a
     centered page number, its line 36.75 pt above the page foot (735 twips: where typst sets it, footer-descent
     30 %). Pandoc's fancy lists are off: the typed sub-paragraph labels "(i)", "(1)" stay text, as cmarker reads
     them. docx/ilcb-adversary-complaint.lua writes the court lines, caption, title, headings and signature block with
     their own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="552" single="276" indent="720" heading="276" heading-before="276" heading-after="276" note="253" note-size="22" note-after="140" footer="735" pandoc-from="markdown+smart-fancy_lists">
  <w:style w:type="paragraph" w:styleId="FootnoteText"><w:name w:val="footnote text"/><w:basedOn w:val="Normal"/><w:qFormat/><w:pPr><w:widowControl/><w:spacing w:before="0" w:after="140" w:line="253" w:lineRule="exact"/></w:pPr><w:rPr><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr></w:style>
  <w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
  <w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyKeep"><w:name w:val="Body Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
</reference>
