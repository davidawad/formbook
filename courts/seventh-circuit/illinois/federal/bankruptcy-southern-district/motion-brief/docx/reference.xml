<?xml version="1.0" encoding="UTF-8"?>
<!-- The S.D. Ill. bankruptcy motion brief's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the
     face of the typst template ({font}, Times New Roman; no S.D. Ill. rule names one, ILSB-FORM-002) at 12 pt (size
     24 half points); Body Text in exact 24 pt line boxes (typst pitch-body, double spacing as filed) with a half-inch
     first-line indent (typst para-indent); the court title, caption, headings, quotations, footnotes and signature
     in 13.8 pt boxes (typst pitch-single), headings half a body line from the text on either side, Block Text
     indented half an inch on both sides with half a body line around and between its paragraphs, 12 pt footnotes
     7 pt apart (typst note-gap), split where typst splits them (no keep-lines); Body Text Note (no widow control) is
     a paragraph that anchors a footnote. Letter page with 1-inch margins (ILSB-FORM-001) and a centered "Page X of Y"
     footer at 10 pt in a 12 pt line whose foot is 38.4 pt above the page edge (768 twips: where typst sets it,
     footer-descent 30 %). docx/ilsb.lua writes the court title, caption, title, headings, signature and certificate
     of service with their own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="276" indent="720" heading="276" heading-before="240" heading-after="240" quote="240" note="276" note-after="140" footer="768" pandoc-from="markdown+smart-fancy_lists">
<w:style w:type="paragraph" w:styleId="FootnoteText"><w:name w:val="footnote text"/><w:basedOn w:val="Normal"/><w:qFormat/><w:pPr><w:widowControl/><w:spacing w:before="0" w:after="140" w:line="276" w:lineRule="exact"/></w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<footer id="rIdFooter1"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="240" w:lineRule="exact"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">Page </w:t></w:r><w:r><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r><w:r><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:fldChar w:fldCharType="separate"/></w:r><w:r><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>1</w:t></w:r><w:r><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:fldChar w:fldCharType="end"/></w:r><w:r><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve"> of </w:t></w:r><w:r><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:instrText xml:space="preserve"> NUMPAGES </w:instrText></w:r><w:r><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:fldChar w:fldCharType="separate"/></w:r><w:r><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>1</w:t></w:r><w:r><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:fldChar w:fldCharType="end"/></w:r></w:p></footer>
</reference>
