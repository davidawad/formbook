// Motion to dismiss with a brief in support for the U.S. District Court for the Southern District of Illinois (ilsd),
// on the generic FRCP brief with S.D. Ill.'s local rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and
// docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced
// breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LR 7.1(a)(3) asks for 12-point type and names no face: Times New Roman, the exemplar's face, with Liberation
// Serif its metric-compatible substitute (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let ilsd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
