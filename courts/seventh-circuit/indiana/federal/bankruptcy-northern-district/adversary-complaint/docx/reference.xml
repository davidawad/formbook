<?xml version="1.0" encoding="UTF-8"?>
<!-- The N.D. Ind. bankruptcy adversary complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs)
     in the face of the typst template ({font}, Times New Roman; INNB-FORM-005, no rule names one) at 12 pt (size 24
     half points); Body Text in exact 24 pt line boxes (typst pitch-body, INNB-FORM-001 double spacing) with a
     half-inch first-line indent; the court title, caption, headings, quotations, footnotes and signature lines in
     13.8 pt boxes (typst pitch-single), a heading or quotation half a body line from the text on either side, 7 pt
     after each footnote (typst note-gap); letter page with 1-inch margins (INNB-FORM-004) and a centered 11 pt page
     number (INNB-FORM-003), its 13.8 pt line 36.75 pt above the page foot (735 twips: where typst sets it,
     footer-descent 30 %). Styles added: Body Text Note, Body Text without widow control, for a paragraph that
     anchors a footnote (typst moves its last line on alone when the note does not fit); Numbered Paragraph (and
     Numbered Paragraph Note), Body Text with a left tab an inch in, after the paragraph number in its half-inch
     box; Body Text Keep and Numbered Paragraph Keep, kept whole and with the signature after them (the prayer);
     Footnote Text without keep-lines, so a note splits where typst splits it. docx/innb-adversary-complaint.lua
     writes the caption, title, headings and signature with their own spacing. Pandoc's fancy lists are off: the
     lettered sub-items "A." are text, as the typst template (cmarker) reads them. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="276" indent="720" heading="276" heading-before="240" heading-after="240" quote="240" note="276" note-after="140" footer="735" pandoc-from="markdown+smart-fancy_lists">
  <footer id="rIdFooter1"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="exact"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:fldChar w:fldCharType="begin" /></w:r><w:r><w:rPr><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r><w:r><w:rPr><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:fldChar w:fldCharType="separate" /></w:r><w:r><w:rPr><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t>1</w:t></w:r><w:r><w:rPr><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:fldChar w:fldCharType="end" /></w:r></w:p></footer>
  <w:style w:type="paragraph" w:styleId="FootnoteText"><w:name w:val="footnote text"/><w:basedOn w:val="Normal"/><w:qFormat/><w:pPr><w:widowControl/><w:spacing w:before="0" w:after="140" w:line="276" w:lineRule="exact"/></w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
  <w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
  <w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextKeep"><w:name w:val="Body Text Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
  <w:style w:type="paragraph" w:customStyle="1" w:styleId="NumberedParagraph"><w:name w:val="Numbered Paragraph"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs></w:pPr></w:style>
  <w:style w:type="paragraph" w:customStyle="1" w:styleId="NumberedParagraphNote"><w:name w:val="Numbered Paragraph Note"/><w:basedOn w:val="NumberedParagraph"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
  <w:style w:type="paragraph" w:customStyle="1" w:styleId="NumberedParagraphKeep"><w:name w:val="Numbered Paragraph Keep"/><w:basedOn w:val="NumberedParagraph"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
</reference>
