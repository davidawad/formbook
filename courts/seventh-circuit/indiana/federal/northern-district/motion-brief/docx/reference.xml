<?xml version="1.0" encoding="UTF-8"?>
<!-- The N.D. Ind. motion brief's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md,
     "Cross-engine gate") in the face of the typst template ({font}, Times New Roman; L.R. 5-4(a) names no face) at
     12 pt (size 24 half points, L.R. 5-4(a)(4)); Body Text in exact 27.6 pt line boxes (552 twips: typst pitch-body,
     double spacing, L.R. 5-4(a)(5)) with a half-inch first-line indent; single lines in 13.8 pt boxes (276 twips:
     typst pitch-single); footnotes at 10 pt (L.R. 5-4(a)(4)) in 11.5 pt boxes (230 twips: typst pitch-note), 7 pt
     apart (typst note-gap). Body Para: a body paragraph with 19.8 pt below it (396 twips: typst para-gap); List Para: a list item, its number at the 0.5 in indent and its text from 1 in (typst list-text); Body Last: the last paragraph, kept with the signature. Letter page
     (L.R. 5-4(a)(2)) with one-inch margins (L.R. 5-4(a)(3)), the page number centred at 12 pt on every page
     (L.R. 5-4(a)(6)) in a single-pitch line whose box ends 0.5 in above the page edge (typst footer-distance).
     docx/innd.lua writes every other paragraph's own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="552" single="276" indent="720" heading="552" heading-before="552" heading-after="396" note="230" note-size="20" note-after="140" footer="720">
  <w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyPara"><w:name w:val="Body Para"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="396" w:line="552" w:lineRule="exact"/></w:pPr></w:style>
  <w:style w:type="paragraph" w:customStyle="1" w:styleId="ListPara"><w:name w:val="List Para"/><w:basedOn w:val="BodyPara"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:ind w:left="1440" w:hanging="720"/></w:pPr></w:style>
  <w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyLast"><w:name w:val="Body Last"/><w:basedOn w:val="BodyPara"/><w:qFormat/><w:pPr><w:keepNext/></w:pPr></w:style>
<footer id="rIdFooter1"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:jc w:val="center"/></w:pPr><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:r><w:t>1</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r></w:p></footer>
</reference>
