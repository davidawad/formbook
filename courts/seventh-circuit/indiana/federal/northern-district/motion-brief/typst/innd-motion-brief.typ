// Brief in support of a Rule 12 motion for the U.S. District Court for the Northern District of Indiana (innd),
// on the generic FRCP brief with N.D. Ind.'s local rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and
// docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced
// breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// L.R. 5-4(a) names no face: Times New Roman, the house standard (docs/FONTS.md), with Liberation
// Serif its metric-compatible substitute. Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let innd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
