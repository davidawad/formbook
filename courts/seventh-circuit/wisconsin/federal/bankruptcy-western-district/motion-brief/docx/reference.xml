<!-- The W.D. Wis. bankruptcy motion and memorandum's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs;
     docs/EVAL-LOOP.md, "Cross-engine gate") in the face of the typst template ({font}, Times New Roman; no W.D. Wis.
     rule names a face, README.md) at 12 pt (size 24 half points); Body Text in exact 27.6 pt line boxes (552 twips:
     typst pitch-body, double spacing) with a half-inch first-line indent (and Body Text Keep, the same kept with the signature block; List Note (Keep), a bulleted item that carries a footnote:
     the bullet at 0.5 in, the text hanging at 0.9 in, typst bullet-box);
     single lines in 13.8 pt boxes (276 twips: typst pitch-single); Footnote Text at 10 pt in
     11.5 pt boxes (230 twips: typst pitch-note) with 6 pt after each note (typst note-gap). Letter page with
     one-inch margins, the page number centred at 11 pt in a single-pitch line whose box ends 0.5 in above the page
     edge (typst footer-distance). docx/wiwb.lua writes every other paragraph's own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="552" single="276" indent="720" heading="276" heading-before="276" heading-after="276" note="230" note-size="20" note-after="120" footer="720">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextKeep"><w:name w:val="Body Text Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="ListNote"><w:name w:val="List Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1296"/></w:tabs><w:ind w:left="1296" w:hanging="576"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="ListNoteKeep"><w:name w:val="List Note Keep"/><w:basedOn w:val="ListNote"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<footer id="rIdFooter1"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:rPr><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r><w:r><w:rPr><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:fldChar w:fldCharType="separate"/></w:r><w:r><w:rPr><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t>1</w:t></w:r><w:r><w:rPr><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:fldChar w:fldCharType="end"/></w:r></w:p></footer>
</reference>
