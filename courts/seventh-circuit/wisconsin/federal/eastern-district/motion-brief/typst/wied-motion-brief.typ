// Brief supporting a motion for the U.S. District Court for the Eastern District of Wisconsin (wied), on the generic
// FRCP brief with E.D. Wis.'s local rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`,
// fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`).
// Content-agnostic: no case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// General L.R. 5(a)(6): a proportionally spaced serif face of 12 points or more, no face named: Times New Roman, the
// house standard and the exemplars' face, with Liberation Serif its metric-compatible substitute (docs/FONTS.md).
// Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let wied-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
