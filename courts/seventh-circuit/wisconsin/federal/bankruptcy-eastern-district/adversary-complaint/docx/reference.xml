<!-- The E.D. Wis. bankruptcy adversary complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs;
     docs/EVAL-LOOP.md, "Cross-engine gate") in the face of the typst template ({font}, Times New Roman; LR 9004-1(a)
     allows any proportional font) at 12 pt (size 24 half points, WIEB-FORM-001); Body Text in exact 24 pt line
     boxes (480 twips: typst pitch-body, double spacing, WIEB-FORM-002); single lines in 14.4 pt boxes (288 twips:
     typst pitch-single). Letter page with one-inch margins (WIEB-FORM-003), the page number centred at 12 pt from
     page 1 in a single-pitch line whose box ends 0.5 in above the page edge (typst footer-distance). docx/wieb.lua
     writes every paragraph's own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="288" indent="720" heading="288" heading-before="240" heading-after="144" footer="720">
<footer id="rIdFooter1"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="288" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:jc w:val="center"/></w:pPr><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:r><w:t>1</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r></w:p></footer>
</reference>
