// Brief in support of a motion to dismiss for the U.S. District Court for the Western District of Wisconsin (wiwd), on
// the generic FRCP brief with W.D. Wis.'s practice overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and
// docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced
// breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// No W.D. Wis. rule names a face (rules.md WIWD-LEN-001): Times New Roman, the house standard, with Liberation Serif
// its metric-compatible substitute (docs/FONTS.md); the exemplar's Century Schoolbook is that filer's style (tier 3).
// Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let wiwd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
