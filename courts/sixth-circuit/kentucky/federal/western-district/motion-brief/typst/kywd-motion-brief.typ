// Memorandum of law in support of a motion, for the U.S. District Court for the Western District of Kentucky (kywd),
// on the generic FRCP brief with W.D. Ky.'s local rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17.17), set by the shared document model (lib/typst/xdoc.typ; latex/
// and docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced
// breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LR 5.2(a): "at least 12-point proportionately-spaced font"; no face is named, so Times New Roman, the house default
// (vendored in /fonts, Liberation Serif its metric twin the fallback; docs/FONTS.md).
#let font-family = ("Times New Roman", "Liberation Serif")

#let kywd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
