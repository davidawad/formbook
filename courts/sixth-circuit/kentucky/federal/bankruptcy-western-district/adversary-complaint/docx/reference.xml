<?xml version="1.0" encoding="UTF-8"?>
<!-- The kywb adversary-complaint Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md,
     "Cross-engine gate") in the face of the typst template ({font}) at 12 pt (size 24 half points, the exemplar's
     size); Body Text in exact 24 pt line boxes (480 twips, typst pitch-body: double spacing, the filed exemplar's
     convention) with a half-inch first-line indent (typst para-indent); single lines in 14 pt boxes (280 twips, typst
     pitch-single); letter page, 1 in margins and a centred page-number footer. Added or replaced here, as the typst
     template sets them: "Allegation" (Body Text with a tab stop at 1 in: the number "1." in a half-inch box after the
     indent; typst number-box), "Prayer Item" (the letter "A." hanging in a 0.5 in box half an inch in; typst
     letter-box), Heading 1 centred bold on the body pitch with half a line (240 twips) above and below (typst
     heading-line; the filter writes the capitals). Caption, title, signature and exhibits carry their own spacing
     (docx/kywb-adversary-complaint.lua). Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="280" indent="720" heading="480" heading-before="240" heading-after="240">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Allegation"><w:name w:val="Allegation"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:firstLine="720"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="PrayerItem"><w:name w:val="Prayer Item"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:left="1440" w:hanging="720"/></w:pPr></w:style>
</reference>
