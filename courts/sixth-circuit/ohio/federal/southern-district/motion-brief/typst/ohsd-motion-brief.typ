// Motion to dismiss with its memorandum in support, for the U.S. District Court for the Southern District of Ohio
// (ohsd), on the generic FRCP brief with S.D. Ohio's local rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17.18), set by the shared document model (lib/typst/xdoc.typ; latex/
// and docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced
// breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// S.D. Ohio Civ. R. 5.1 sets no typeface: Times New Roman, the house default and the exemplar's face (vendored in
// /fonts, Liberation Serif its metric twin the fallback; docs/FONTS.md).
#let font-family = ("Times New Roman", "Liberation Serif")

#let ohsd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
