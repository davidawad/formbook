<?xml version="1.0" encoding="UTF-8"?>
<!-- The ohsb adversary complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md,
     "Cross-engine gate") in the face of the typst template ({font}, Times New Roman; LBR 9004-1(b) names no face and
     asks for 10-12 point type) at 12 pt (size 24 half points); Body Text in exact 24 pt line boxes (480 twips, typst
     pitch-body; LBR 9004-1(b): double spaced) with a half-inch first-line indent (typst para-indent); single lines and
     footnotes in 14 pt boxes (280 twips, typst pitch-single), 7 pt after a footnote (typst note-gap). Added here, as
     the typst template sets them: "Numbered Paragraph" (an allegation, Fed. R. Civ. P. 10(b), or a relief item: the
     number at the indent, a tab to the text 1 in in; typst num-box), "Numbered Paragraph Keep" (the paragraph before
     the signature, kept whole with it: typst one unbreakable block) and "List Number" (a markdown list's number half
     an inch in, the text hanging at 0.9 in; typst list-indent, list-box). docx/ohsb-adversary-complaint.lua writes the
     court title, the caption, the headings, the signature block, the exhibit table, the footer (the page number,
     centred, its line box ending 0.5 in above the edge: typst footer-descent) and the section (letter, 1 in margins,
     LBR 9004-1(b)). Twips: 20 x pt. pandoc-from: CommonMark with smart punctuation, as typst's cmarker reads the body
     ("i." and "(A)" stay text). -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" pandoc-from="commonmark+smart+footnotes+pipe_tables+yaml_metadata_block" size="24" body="480" single="280" indent="720" heading="480" heading-before="0" heading-after="0" note-after="140" footer="720">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="NumberedParagraph"><w:name w:val="Numbered Paragraph"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:firstLine="720"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="NumberedParagraphKeep"><w:name w:val="Numbered Paragraph Keep"/><w:basedOn w:val="NumberedParagraph"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextKeep"><w:name w:val="Body Text Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="ListNumber"><w:name w:val="List Number"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1296"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:left="1296" w:hanging="576"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="ListNumberKeep"><w:name w:val="List Number Keep"/><w:basedOn w:val="ListNumber"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
</reference>
