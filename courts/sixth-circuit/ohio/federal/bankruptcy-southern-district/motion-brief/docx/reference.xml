<?xml version="1.0" encoding="UTF-8"?>
<!-- The ohsb motion's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md,
     "Cross-engine gate") in the face of the typst template ({font}, Times New Roman; LBR 9004-1(b) names no face and
     asks for 10-12 point type) at 12 pt (size 24 half points); Body Text in exact 24 pt line boxes (480 twips, typst
     pitch-body; LBR 9004-1(b): double spaced) with a half-inch first-line indent (typst para-indent); single lines and
     footnotes in 14 pt boxes (280 twips, typst pitch-single), 7 pt after a footnote (typst note-gap). Added here, as
     the typst template sets them: "List Number" (a markdown list's number half an inch in, the text hanging at 0.9 in;
     typst list-indent, list-box), "Quotation Lettered" (a lettered quotation of the statute, 0.75 in in, double
     spaced; typst quote-indent) and "Lines" (a paragraph of hard-broken lines, an address: single spaced, not
     indented, a blank single line above and below; typst lines-gap). docx/ohsb-motion-brief.lua writes the court
     title, the caption, the headings, the signature blocks, the footer (the page number, centred, its line box ending
     0.5 in above the edge: typst footer-descent) and the section (letter, 1 in margins, LBR 9004-1(b)). Twips: 20 x pt.
     pandoc-from: CommonMark with smart punctuation, as typst's cmarker reads the body ("(A)" stays text). -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" pandoc-from="commonmark+smart+footnotes+yaml_metadata_block" size="24" body="480" single="280" indent="720" heading="480" heading-before="0" heading-after="0" note-after="140" footer="720">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="ListNumber"><w:name w:val="List Number"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1296"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:left="1296" w:hanging="576"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="QuotationLettered"><w:name w:val="Quotation Lettered"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:left="1080" w:firstLine="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Lines"><w:name w:val="Lines"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:spacing w:before="280" w:after="280" w:line="280" w:lineRule="exact"/><w:ind w:left="0" w:firstLine="0"/></w:pPr></w:style>
</reference>
