<?xml version="1.0" encoding="UTF-8"?>
<!-- The ohnd memorandum's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md,
     "Cross-engine gate") in the face of the typst template ({font}, Times New Roman; L.R. 10.1 names no face) at
     12 pt (size 24 half points); Body Text in exact 27.6 pt line boxes (552 twips: typst pitch-body, L.R. 10.1
     double-spaced) with a half-inch first-line indent (typst para-indent); single lines, headings and footnotes in
     13.8 pt boxes (276 twips: typst pitch-single), the footnotes at the type size, 7 pt apart (typst note-gap); a
     heading a single line below the text (typst heading-above). One style of its own: "Body Text Note", Body Text
     for a paragraph pandoc writes because it carries a footnote. Letter page, 1 in margins; the 1 1/2 in first-page
     top margin (L.R. 10.1) is the space before the court title. The footer's single-pitch line box ends 0.5 in above
     the page edge (footer="720"; typst footer-descent). docx/ohnd-motion-brief.lua writes every other paragraph's
     own spacing, the footer (a centered page number, L.R. 10.1) and the last section. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="552" single="276" indent="720" heading="276" heading-before="276" heading-after="0" note="276" note-size="24" note-after="140" footer="720">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="0" w:line="552" w:lineRule="exact"/><w:ind w:firstLine="720"/></w:pPr></w:style>
</reference>
