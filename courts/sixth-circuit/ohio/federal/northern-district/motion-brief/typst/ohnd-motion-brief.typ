// Memorandum in support of a motion for the U.S. District Court for the Northern District of Ohio (ohnd), on the
// generic FRCP brief with N.D. Ohio's local rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`,
// fb-595.17, fb-595.92), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb
// engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// L.R. 10.1 names no face; Times New Roman, the house standard and the face of both filed exemplars (docs/FONTS.md).
// Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

// L.R. 7.1(f): the tracks the certification names; another stops the render (the page limit would be unknown).
#let TRACKS = ("expedited", "administrative", "standard", "unassigned", "complex", "mass tort")

#let ohnd-motion-brief(meta, body) = {
  assert(meta.at("track", default: none) in TRACKS,
    message: "ohnd-motion-brief: frontmatter `track` must be one of " + TRACKS.join(", ") + " (L.R. 7.1(f))")
  xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
}
