<?xml version="1.0" encoding="UTF-8"?>
<!-- The M.D. Tenn. bankruptcy memorandum of law's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in
     the face of the typst template ({font}, Times New Roman; no tnmb rule names one) at 12 pt (size 24 half points;
     LBR 5005-3(a), "12-point font", footnotes too); Body Text in exact 24 pt line boxes (480 twips: typst pitch-body,
     double spacing as filed) with a half-inch first-line indent (typst para-indent); single lines 13.8 pt (276 twips:
     typst pitch-single); Block Text (quotations) single-spaced, half an inch in on both sides, half a body line
     (240 twips: typst gap) around a quotation and between its paragraphs; List Item the label in a half-inch box;
     footnotes 12 pt in 13.8 pt boxes, 7 pt after each (140 twips: typst note-gap), kept whole on
     one page (the recipe's Footnote Text; typst sets each note as one unbreakable block). Added here: "Head 1" (centered, bold) and "Head 2" (bold, the typed label at the
     half-inch indent in a half-inch box, the text hanging at 1 in, half an inch short of the right margin: typst
     heading-box, heading-right), single lines half a body line from the text on either side (240 twips: typst
     gap), kept with the next paragraph (typst sticky); "Body Text Note" (Body Text without widow control, for a
     paragraph that anchors a footnote: typst may move such a paragraph's last line on alone); "Body Flush" (the
     paragraph right after a quotation, its citation, at the margin) and its "Note" variant; "Body Keep" and "Body
     Flush Keep" (the last paragraph, kept with the signature block: typst sets them in one unbreakable block).
     Letter page with 1-inch margins (LBR 5005-3(a)) and the page number centered in a 13.8 pt line whose foot is
     15 pt above the page edge (300 twips: where typst sets it, 1 in margin - footer-descent 0.6 in - 13.8 pt;
     LBR 5005-3(b)). docx/tnmb-motion-brief.lua writes the court title, caption, title, signature and certificate of
     service with their own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="276" indent="720" list="720" heading="276" heading-before="240" heading-after="240" quote="240" note="276" note-after="140" footer="300">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Head1"><w:name w:val="Head 1"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="240" w:after="240" w:line="276" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:jc w:val="center"/><w:outlineLvl w:val="0"/></w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Head2"><w:name w:val="Head 2"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="240" w:after="240" w:line="276" w:lineRule="exact"/><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:outlineLvl w:val="1"/></w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyFlush"><w:name w:val="Body Flush"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:ind w:firstLine="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyFlushNote"><w:name w:val="Body Flush Note"/><w:basedOn w:val="BodyFlush"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyKeep"><w:name w:val="Body Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyFlushKeep"><w:name w:val="Body Flush Keep"/><w:basedOn w:val="BodyFlush"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<footer id="rIdFooter1"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="exact"/><w:jc w:val="center"/></w:pPr><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:r><w:t>1</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r></w:p></footer>
</reference>
