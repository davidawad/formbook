<?xml version="1.0" encoding="UTF-8"?>
<!-- The E.D. Tenn. memorandum of law's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face
     of the typst template ({font}, Times New Roman; LR 5.1 names no face) at 12 pt (size 24 half points; LR 5.1: no
     smaller than 12 pt, footnotes included); Body Text in exact 24 pt line boxes (480 twips: typst pitch-body, double
     spacing, LR 5.1) with a half-inch first-line indent (typst para-indent); Body Keep the same kept with the next
     paragraph (the last paragraph, kept with the signature block); Body Text Note the same without widow control (a
     paragraph that anchors a footnote: typst moves its last line alone when the note does not fit); Block Text
     single-spaced (276 twips: typst pitch-single, LR 5.1), half an inch in on both sides (typst quote-indent), 12 pt
     from the text (240: typst quote-gap); footnotes 12 pt in 13.8 pt boxes (276), 7 pt after each (140: typst
     note-gap), not kept whole (LibreOffice splits a note where typst does); List Item the label in a half-inch box;
     letter page with 1-inch margins (LR 5.1) and the page number centered in the footer in a 13.8 pt line, 36.75 pt
     above the page foot (735 twips: where typst sets it, footer-descent 30 %; LR 5.1: numbered at the bottom).
     docx/tned-motion-brief.lua writes the court title, caption, title, headings, signature and certificate of service
     with their own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="276" indent="720" list="720" heading="276" heading-before="240" heading-after="240" quote="240" note="276" note-after="140" footer="735">
<footer id="rIdFooter1"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="exact"/><w:jc w:val="center"/></w:pPr><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:r><w:t>1</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r></w:p></footer>
<w:style w:type="paragraph" w:styleId="FootnoteText"><w:name w:val="footnote text"/><w:basedOn w:val="Normal"/><w:qFormat/><w:pPr><w:widowControl/><w:spacing w:before="0" w:after="140" w:line="276" w:lineRule="exact"/></w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyKeep"><w:name w:val="Body Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
</reference>
