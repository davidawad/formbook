<?xml version="1.0" encoding="UTF-8"?>
<!-- The W.D. Tenn. bankruptcy adversary complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs)
     in the face of the typst template ({font}, Times New Roman, the exemplar's face; no TNWB rule names one,
     TNWB-FORM-002) at 12 pt (size 24 half points, the exemplar's size); Body Text in exact 24 pt line boxes (480 twips:
     typst pitch-body, double spacing as filed) with a half-inch first-line indent (typst para-indent); single lines
     13.8 pt (276 twips: typst pitch-single), headings half a body line (240 twips: typst gap) from the text on either
     side, block quotations half an inch in on both sides with half a body line around them; footnotes 10 pt (note-size
     20 half points) in 11.5 pt boxes (230 twips: typst pitch-note), 6 pt after each (120 twips: typst note-gap), not
     kept whole (Footnote Text without the recipe's keep-lines: LibreOffice splits a note where typst does). Added here:
     "Numbered Paragraph" (FRCP 10(b) via FRBP 7010: the number or prayer letter at the half-inch indent, a tab to 1 in,
     typst number-box; the text wraps to the margin, as filed), its "Note" variant and "Body Text Note" without widow
     control (a paragraph that anchors a footnote: typst may move its last line on alone), its "Keep" variant and
     "Body Keep" kept with the next paragraph (the WHEREFORE paragraph, and the last paragraph with the signature:
     typst sticky and the unbreakable tail). Letter page with 1-inch margins and the page number centered in the footer
     in a 13.8 pt line, 36.75 pt above the page foot (735 twips: where typst sets it, footer-descent 30 %).
     docx/tnwb-adversary-complaint.lua writes the court heading, caption, title, headings, transfer tables and
     signature with their own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="276" indent="720" heading="276" heading-before="240" heading-after="240" quote="240" note="230" note-size="20" note-after="120" footer="735">
<footer id="rIdFooter1"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="exact"/><w:jc w:val="center"/></w:pPr><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:r><w:t>1</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r></w:p></footer>
<w:style w:type="paragraph" w:styleId="FootnoteText"><w:name w:val="footnote text"/><w:basedOn w:val="Normal"/><w:qFormat/><w:pPr><w:widowControl/><w:spacing w:before="0" w:after="120" w:line="230" w:lineRule="exact"/></w:pPr><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyKeep"><w:name w:val="Body Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="NumberedParagraph"><w:name w:val="Numbered Paragraph"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:firstLine="720"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="NumberedParagraphNote"><w:name w:val="Numbered Paragraph Note"/><w:basedOn w:val="NumberedParagraph"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="NumberedParagraphKeep"><w:name w:val="Numbered Paragraph Keep"/><w:basedOn w:val="NumberedParagraph"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
</reference>
