// Memorandum of law in support of a motion, for the U.S. District Court for the Middle District of Tennessee (tnmd),
// on the generic FRCP brief with M.D. Tenn.'s local rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17.18), set by the shared document model (lib/typst/xdoc.typ; latex/
// and docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced
// breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LR 7.03(a): "at least 12-point font"; no face is named, so Times New Roman, the house default and the exemplar's
// face (vendored in /fonts, Liberation Serif its metric twin the fallback; docs/FONTS.md).
#let font-family = ("Times New Roman", "Liberation Serif")

#let tnmd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
