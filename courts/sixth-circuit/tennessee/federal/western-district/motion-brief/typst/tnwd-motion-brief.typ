// Memorandum in support of a motion, for the U.S. District Court for the Western District of Tennessee (tnwd), on the
// generic FRCP brief with W.D. Tenn.'s local rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17.18), set by the shared document model (lib/typst/xdoc.typ; latex/
// and docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced
// breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LR 7.1(b): "no smaller than 12 point"; no face is named (the CM/ECF manual allows Times New Roman), so Times New
// Roman, the house default and the exemplar's face (vendored in /fonts, Liberation Serif its metric twin the
// fallback; docs/FONTS.md).
#let font-family = ("Times New Roman", "Liberation Serif")

#let tnwd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
