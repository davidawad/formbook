// Motion and brief in support for the U.S. District Court for the Eastern District of Michigan (mied), on the generic
// FRCP brief with E.D. Mich.'s local rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`, the
// motion before the brief as `lead`, fb-595.17, fb-595.92), set by the shared document model (lib/typst/xdoc.typ;
// latex/ and docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or
// forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LR 5.1(a)(3) sets 14-point type and names no face; Times New Roman, the exemplar's and the house standard
// (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let mied-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
