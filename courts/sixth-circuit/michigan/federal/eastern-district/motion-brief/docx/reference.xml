<!-- The mied motion and brief Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md,
     "Cross-engine gate") in the face of the typst template ({font}, Times New Roman) at 14 pt (size 28 half points;
     LR 5.1(a)(3): 14 point for proportional type); Body Text in exact 32.2 pt line boxes (typst pitch-body, LR
     5.1(a)(2) double spaced: twice Times New Roman's 1.15 em single line) with a half-inch first-line indent (typst
     para-indent); single lines in 16.1 pt boxes (typst pitch-single). Replaced here, as the typst template sets them:
     the three heading levels at the type size on the body pitch with no space of their own, kept with the next line
     (level 1 centred bold, the filter types it in capitals; level 2 bold at the margin, its later lines hanging half
     an inch; level 3 bold, half an inch in, hanging another half inch). Letter page, 1 in margins (LR 5.1(a)(2)); the
     footer's line box ends 0.5 in above the page edge (footer="720"; typst footer-descent).
     docx/mied-motion-brief.lua writes everything else with its own spacing: the covers, the caption, the lists, the
     quotations, the contents (pages from fb render's passes), the signature blocks, the certificate, the four
     sections and their footers (the 12 pt page number, centred; none on the brief's cover). Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="28" body="644" single="322" indent="720" heading="644" heading-before="0" heading-after="0" quote="322" footer="720">
<w:style w:type="paragraph" w:styleId="Heading1"><w:name w:val="heading 1"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="0" w:after="0" w:line="644" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:jc w:val="center"/><w:outlineLvl w:val="0"/></w:pPr><w:rPr><w:b/><w:bCs/><w:color w:val="000000"/><w:sz w:val="28"/><w:szCs w:val="28"/></w:rPr></w:style>
<w:style w:type="paragraph" w:styleId="Heading2"><w:name w:val="heading 2"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="0" w:after="0" w:line="644" w:lineRule="exact"/><w:ind w:left="720" w:hanging="720"/><w:jc w:val="left"/><w:outlineLvl w:val="1"/></w:pPr><w:rPr><w:b/><w:bCs/><w:color w:val="000000"/><w:sz w:val="28"/><w:szCs w:val="28"/></w:rPr></w:style>
<w:style w:type="paragraph" w:styleId="Heading3"><w:name w:val="heading 3"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="0" w:after="0" w:line="644" w:lineRule="exact"/><w:ind w:left="1440" w:hanging="720"/><w:jc w:val="left"/><w:outlineLvl w:val="2"/></w:pPr><w:rPr><w:b/><w:bCs/><w:color w:val="000000"/><w:sz w:val="28"/><w:szCs w:val="28"/></w:rPr></w:style>
</reference>
