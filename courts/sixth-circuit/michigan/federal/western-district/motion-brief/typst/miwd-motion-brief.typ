// Brief in support of a dispositive motion, for the U.S. District Court for the Western District of Michigan (miwd),
// on the generic FRCP brief with W.D. Mich.'s local rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17.17), set by the shared document model (lib/typst/xdoc.typ; latex/
// and docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced
// breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LCivR 10.1 names no face, only type no smaller than 12 point: Times New Roman, as the filed briefs (vendored in
// /fonts, Liberation Serif its metric twin the fallback; docs/FONTS.md).
#let font-family = ("Times New Roman", "Liberation Serif")

#let miwd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
