<?xml version="1.0" encoding="UTF-8"?>
<!-- The ca6 answering brief's Word styles; fb render builds docx/reference.docx from pandoc's default reference with
     them (tools/fb/src/docxref.rs), matching ../typst/ca6-answering-brief.typ: TeX Gyre Schola 14 pt everywhere
     (the typst face, vendored in fonts/; footnotes included); body lines exact at 637 twips (31.85 pt, the typst body
     pitch: Schola's 0.939 em line box plus 1.336 em leading, double spacing), single-spaced blocks (headings, TOC,
     TOA, cover, certificates, footnotes) exact at 407 twips (20.37 pt, 0.939 + 0.516 em); first-line indent 0.5 in,
     no space between paragraphs; 16 pt section titles exact at 466 twips (Schola's line box at 16 pt, so a
     title at the top of a page stays inside the 1 in margin), no space after a heading (typst sets the next line on
     its single leading); cover lines exact at 380 twips so the cover keeps to one page (typst shrinks its cover
     spacing to fit). Hanging indents carry no firstLine attribute (LibreOffice let w:firstLine="0" cancel
     w:hanging). The footers and the page setup of every section (letter paper, 1 in margins) are
     fb render's and the filter's: rIdFtrNone, rIdFtrPage, rIdFtrAdd; docx/ca6-answering-brief.lua writes the
     section breaks and FORMBOOK_FINAL. -->
