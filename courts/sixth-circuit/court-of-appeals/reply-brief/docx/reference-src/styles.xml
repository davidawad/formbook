<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Styles for the ca6 reply brief docx engine. Measures are the ones the typst template gets from the 14-pt EB
     Garamond render (see ../../typst/ca6-reply-brief.typ): body lines 31.43 pt apart (w:line 629 exact), single-
     spaced blocks 19.95 pt (399 exact), first-line indent 0.5 in, no space between paragraphs. -->
<w:styles xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">
  <w:docDefaults>
    <w:rPrDefault>
      <w:rPr>
        <w:rFonts w:ascii="EB Garamond" w:hAnsi="EB Garamond" w:eastAsia="EB Garamond" w:cs="EB Garamond"/>
        <w:sz w:val="28"/>
        <w:szCs w:val="28"/>
        <w:lang w:val="en-US" w:eastAsia="en-US" w:bidi="ar-SA"/>
      </w:rPr>
    </w:rPrDefault>
    <w:pPrDefault>
      <w:pPr>
        <w:spacing w:before="0" w:after="0" w:line="240" w:lineRule="auto"/>
      </w:pPr>
    </w:pPrDefault>
  </w:docDefaults>

<w:style w:type="paragraph" w:default="1" w:styleId="Normal">
    <w:name w:val="Normal"/>
    <w:qFormat/>
    <w:pPr>
      <w:spacing w:before="0" w:after="0" w:line="399" w:lineRule="exact"/>
    </w:pPr>
  </w:style>

<w:style w:type="character" w:default="1" w:styleId="DefaultParagraphFont">
    <w:name w:val="Default Paragraph Font"/>
    <w:uiPriority w:val="1"/>
    <w:semiHidden/>
    <w:unhideWhenUsed/>
  </w:style>

<w:style w:type="table" w:default="1" w:styleId="TableNormal">
    <w:name w:val="Normal Table"/>
    <w:uiPriority w:val="99"/>
    <w:semiHidden/>
    <w:unhideWhenUsed/>
    <w:tblPr>
      <w:tblInd w:w="0" w:type="dxa"/>
      <w:tblCellMar>
        <w:top w:w="0" w:type="dxa"/>
        <w:left w:w="0" w:type="dxa"/>
        <w:bottom w:w="0" w:type="dxa"/>
        <w:right w:w="0" w:type="dxa"/>
      </w:tblCellMar>
    </w:tblPr>
  </w:style>

<w:style w:type="table" w:styleId="Table">
    <w:name w:val="Table"/>
    <w:basedOn w:val="TableNormal"/>
    <w:tblPr>
      <w:tblBorders>
        <w:top w:val="nil"/>
        <w:left w:val="nil"/>
        <w:bottom w:val="nil"/>
        <w:right w:val="nil"/>
        <w:insideH w:val="nil"/>
        <w:insideV w:val="nil"/>
      </w:tblBorders>
      <w:tblCellMar>
        <w:left w:w="0" w:type="dxa"/>
        <w:right w:w="115" w:type="dxa"/>
      </w:tblCellMar>
    </w:tblPr>
  </w:style>

<w:style w:type="paragraph" w:styleId="BodyText">
    <w:name w:val="Body Text"/>
    <w:basedOn w:val="Normal"/>
    <w:qFormat/>
    <w:pPr>
      <w:spacing w:before="0" w:after="0" w:line="629" w:lineRule="exact"/>
      <w:ind w:firstLine="720"/>
    </w:pPr>
  </w:style>

<w:style w:type="paragraph" w:styleId="FirstParagraph">
    <w:name w:val="First Paragraph"/>
    <w:basedOn w:val="BodyText"/>
    <w:next w:val="BodyText"/>
    <w:qFormat/>
  </w:style>

<w:style w:type="paragraph" w:styleId="Compact">
    <w:name w:val="Compact"/>
    <w:basedOn w:val="Normal"/>
    <w:qFormat/>
    <w:pPr>
      <w:spacing w:before="0" w:after="0" w:line="399" w:lineRule="exact"/>
      <w:ind w:firstLine="0"/>
    </w:pPr>
  </w:style>

<w:style w:type="paragraph" w:styleId="FootnoteText">
    <w:name w:val="Footnote Text"/>
    <w:basedOn w:val="Normal"/>
    <w:pPr>
      <w:spacing w:before="0" w:after="140" w:line="399" w:lineRule="exact"/>
      <w:ind w:firstLine="0"/>
    </w:pPr>
    <w:rPr>
      <w:sz w:val="28"/>
      <w:szCs w:val="28"/>
    </w:rPr>
  </w:style>

<w:style w:type="character" w:styleId="FootnoteReference">
    <w:name w:val="Footnote Reference"/>
    <w:rPr>
      <w:vertAlign w:val="superscript"/>
    </w:rPr>
  </w:style>

<w:style w:type="paragraph" w:styleId="Footer">
    <w:name w:val="footer"/>
    <w:basedOn w:val="Normal"/>
    <w:pPr>
      <w:spacing w:line="399" w:lineRule="exact"/>
      <w:jc w:val="center"/>
    </w:pPr>
  </w:style>

  <!-- Custom paragraph styles used by the ca6 Lua filter (pandoc custom-style= and raw openxml). -->

<w:style w:type="paragraph" w:customStyle="1" w:styleId="CASection">
    <w:name w:val="CA Section"/>
    <w:basedOn w:val="Normal"/>
    <w:next w:val="BodyText"/>
    <w:qFormat/>
    <w:pPr>
      <w:keepNext/>
      <w:keepLines/>
      <w:spacing w:before="420" w:after="308" w:line="399" w:lineRule="exact"/>
      <w:ind w:firstLine="0"/>
      <w:jc w:val="center"/>
      <w:outlineLvl w:val="0"/>
    </w:pPr>
    <w:rPr>
      <w:b/>
      <w:bCs/>
      <w:caps/>
      <w:sz w:val="32"/>
      <w:szCs w:val="32"/>
    </w:rPr>
  </w:style>

<w:style w:type="paragraph" w:customStyle="1" w:styleId="CASectionNewPage">
    <w:name w:val="CA Section New Page"/>
    <w:basedOn w:val="CASection"/>
    <w:next w:val="BodyText"/>
    <w:pPr>
      <w:pageBreakBefore/>
    </w:pPr>
  </w:style>

<!-- Point heading (level 2 in the Argument): label at the margin, text half an inch in, wrapped lines under the text. -->
<w:style w:type="paragraph" w:customStyle="1" w:styleId="CAPoint">
    <w:name w:val="CA Point"/>
    <w:basedOn w:val="Normal"/>
    <w:next w:val="BodyText"/>
    <w:pPr>
      <w:keepNext/>
      <w:keepLines/>
      <w:tabs><w:tab w:val="left" w:pos="721"/></w:tabs>
      <w:spacing w:before="308" w:after="252" w:line="399" w:lineRule="exact"/>
      <w:ind w:left="720" w:hanging="720"/>
      <w:outlineLvl w:val="1"/>
    </w:pPr>
    <w:rPr>
      <w:b/>
      <w:bCs/>
    </w:rPr>
  </w:style>

<w:style w:type="paragraph" w:customStyle="1" w:styleId="CASub1">
    <w:name w:val="CA Sub 1"/>
    <w:basedOn w:val="Normal"/>
    <w:next w:val="BodyText"/>
    <w:pPr>
      <w:tabs><w:tab w:val="left" w:pos="1441"/></w:tabs>
      <w:keepNext/>
      <w:keepLines/>
      <w:spacing w:before="308" w:after="252" w:line="399" w:lineRule="exact"/>
      <w:ind w:left="1440" w:hanging="720"/>
      <w:outlineLvl w:val="2"/>
    </w:pPr>
    <w:rPr>
      <w:b/>
      <w:bCs/>
    </w:rPr>
  </w:style>

<w:style w:type="paragraph" w:customStyle="1" w:styleId="CASub2">
    <w:name w:val="CA Sub 2"/>
    <w:basedOn w:val="CASub1"/>
    <w:next w:val="BodyText"/>
    <w:pPr>
      <w:tabs><w:tab w:val="left" w:pos="2161"/></w:tabs>
      <w:ind w:left="2160" w:hanging="720"/>
      <w:outlineLvl w:val="3"/>
    </w:pPr>
  </w:style>

<w:style w:type="paragraph" w:customStyle="1" w:styleId="CASub3">
    <w:name w:val="CA Sub 3"/>
    <w:basedOn w:val="CASub1"/>
    <w:next w:val="BodyText"/>
    <w:pPr>
      <w:tabs><w:tab w:val="left" w:pos="2881"/></w:tabs>
      <w:ind w:left="2880" w:hanging="720"/>
      <w:outlineLvl w:val="4"/>
    </w:pPr>
  </w:style>

<w:style w:type="paragraph" w:customStyle="1" w:styleId="CASub4">
    <w:name w:val="CA Sub 4"/>
    <w:basedOn w:val="CASub1"/>
    <w:next w:val="BodyText"/>
    <w:pPr>
      <w:tabs><w:tab w:val="left" w:pos="3601"/></w:tabs>
      <w:ind w:left="3600" w:hanging="720"/>
      <w:outlineLvl w:val="5"/>
    </w:pPr>
  </w:style>

<w:style w:type="paragraph" w:customStyle="1" w:styleId="CABodyKeep">
    <w:name w:val="CA Body Keep"/>
    <w:basedOn w:val="BodyText"/>
    <w:pPr>
      <w:keepNext/>
    </w:pPr>
  </w:style>

<w:style w:type="paragraph" w:customStyle="1" w:styleId="CASingle">
    <w:name w:val="CA Single"/>
    <w:basedOn w:val="Normal"/>
    <w:pPr>
      <w:spacing w:before="0" w:after="280" w:line="399" w:lineRule="exact"/>
      <w:ind w:firstLine="0"/>
    </w:pPr>
  </w:style>

<!-- Cover (FRAP 32(a)(2)): centred lines, short rules between the parts, counsel at 40 % of the measure. -->
<w:style w:type="paragraph" w:customStyle="1" w:styleId="CACover">
    <w:name w:val="CA Cover"/>
    <w:basedOn w:val="Normal"/>
    <w:pPr>
      <w:spacing w:before="10" w:after="10" w:line="399" w:lineRule="exact"/>
      <w:ind w:firstLine="0"/>
      <w:jc w:val="center"/>
    </w:pPr>
  </w:style>

<w:style w:type="paragraph" w:customStyle="1" w:styleId="CACoverBold">
    <w:name w:val="CA Cover Bold"/>
    <w:basedOn w:val="CACover"/>
    <w:rPr>
      <w:b/>
      <w:bCs/>
    </w:rPr>
  </w:style>

<!-- The court's name: a 4.4 in measure (indents of 1.05 in each side of the 6.5 in text width), so it wraps after APPEALS. -->
<w:style w:type="paragraph" w:customStyle="1" w:styleId="CACourt">
    <w:name w:val="CA Court"/>
    <w:basedOn w:val="CACoverBold"/>
    <w:pPr>
      <w:ind w:left="1512" w:right="1512" w:firstLine="0"/>
    </w:pPr>
  </w:style>

<w:style w:type="paragraph" w:customStyle="1" w:styleId="CACoverTitle">
    <w:name w:val="CA Cover Title"/>
    <w:basedOn w:val="CACoverBold"/>
    <w:rPr>
      <w:caps/>
    </w:rPr>
  </w:style>

<w:style w:type="paragraph" w:customStyle="1" w:styleId="CAShortRule">
    <w:name w:val="CA Short Rule"/>
    <w:basedOn w:val="Normal"/>
    <w:pPr>
      <w:pBdr>
        <w:bottom w:val="single" w:sz="6" w:space="0" w:color="000000"/>
      </w:pBdr>
      <w:spacing w:before="0" w:after="60" w:line="200" w:lineRule="exact"/>
      <w:ind w:left="3240" w:right="3240" w:firstLine="0"/>
    </w:pPr>
    <w:rPr>
      <w:sz w:val="4"/>
      <w:szCs w:val="4"/>
    </w:rPr>
  </w:style>

<!-- Spacers: empty paragraphs of a fixed height (exact line height), used between the parts of the cover. -->
<w:style w:type="paragraph" w:customStyle="1" w:styleId="CASpacerS">
    <w:name w:val="CA Spacer S"/>
    <w:basedOn w:val="Normal"/>
    <w:pPr>
      <w:spacing w:before="0" w:after="0" w:line="120" w:lineRule="exact"/>
      <w:ind w:firstLine="0"/>
    </w:pPr>
    <w:rPr>
      <w:sz w:val="4"/>
      <w:szCs w:val="4"/>
    </w:rPr>
  </w:style>

<w:style w:type="paragraph" w:customStyle="1" w:styleId="CASpacerM">
    <w:name w:val="CA Spacer M"/>
    <w:basedOn w:val="CASpacerS"/>
    <w:pPr>
      <w:spacing w:line="100" w:lineRule="exact"/>
    </w:pPr>
  </w:style>

<w:style w:type="paragraph" w:customStyle="1" w:styleId="CASpacerL">
    <w:name w:val="CA Spacer L"/>
    <w:basedOn w:val="CASpacerS"/>
    <w:pPr>
      <w:spacing w:line="150" w:lineRule="exact"/>
    </w:pPr>
  </w:style>

<w:style w:type="paragraph" w:customStyle="1" w:styleId="CASpacerXL">
    <w:name w:val="CA Spacer XL"/>
    <w:basedOn w:val="CASpacerS"/>
    <w:pPr>
      <w:spacing w:line="200" w:lineRule="exact"/>
    </w:pPr>
  </w:style>

<!-- Counsel block (cover) and signature blocks: 40 % indent; lines single-spaced with a small gap between them. -->
<w:style w:type="paragraph" w:customStyle="1" w:styleId="CACounsel">
    <w:name w:val="CA Counsel"/>
    <w:basedOn w:val="Normal"/>
    <w:pPr>
      <w:keepNext/>
      <w:keepLines/>
      <w:spacing w:before="0" w:after="40" w:line="399" w:lineRule="exact"/>
      <w:ind w:left="3744" w:firstLine="0"/>
      <w:jc w:val="left"/>
    </w:pPr>
  </w:style>

<w:style w:type="paragraph" w:customStyle="1" w:styleId="CACounselEnd">
    <w:name w:val="CA Counsel End"/>
    <w:basedOn w:val="CACounsel"/>
    <w:pPr>
      <w:keepNext w:val="0"/>
      <w:spacing w:after="0"/>
    </w:pPr>
  </w:style>

<w:style w:type="paragraph" w:customStyle="1" w:styleId="CARespect">
    <w:name w:val="CA Respectfully"/>
    <w:basedOn w:val="CASingle"/>
    <w:pPr>
      <w:keepNext/>
      <w:keepLines/>
      <w:spacing w:before="392" w:after="0" w:line="399" w:lineRule="exact"/>
    </w:pPr>
  </w:style>

<w:style w:type="paragraph" w:customStyle="1" w:styleId="CASigFirst">
    <w:name w:val="CA Signature First"/>
    <w:basedOn w:val="CACounsel"/>
    <w:pPr>
      <w:spacing w:before="392" w:after="84" w:line="399" w:lineRule="exact"/>
    </w:pPr>
  </w:style>

<w:style w:type="paragraph" w:customStyle="1" w:styleId="CASigLine">
    <w:name w:val="CA Signature Line"/>
    <w:basedOn w:val="CACounsel"/>
    <w:pPr>
      <w:spacing w:before="0" w:after="84" w:line="399" w:lineRule="exact"/>
    </w:pPr>
  </w:style>

<w:style w:type="paragraph" w:customStyle="1" w:styleId="CASigEnd">
    <w:name w:val="CA Signature End"/>
    <w:basedOn w:val="CACounsel"/>
    <w:pPr>
      <w:keepNext w:val="0"/>
      <w:spacing w:before="0" w:after="0" w:line="399" w:lineRule="exact"/>
    </w:pPr>
  </w:style>

<w:style w:type="paragraph" w:customStyle="1" w:styleId="CACertFirst">
    <w:name w:val="CA Certificate Signature First"/>
    <w:basedOn w:val="CASigFirst"/>
    <w:pPr>
      <w:spacing w:before="448" w:after="84" w:line="399" w:lineRule="exact"/>
    </w:pPr>
  </w:style>

<w:style w:type="paragraph" w:customStyle="1" w:styleId="CATOCPage">
    <w:name w:val="CA TOC Page"/>
    <w:basedOn w:val="Normal"/>
    <w:pPr>
      <w:spacing w:before="0" w:after="0" w:line="399" w:lineRule="exact"/>
      <w:ind w:firstLine="0"/>
      <w:jc w:val="right"/>
    </w:pPr>
    <w:rPr>
      <w:b/>
      <w:bCs/>
      <w:u w:val="single"/>
    </w:rPr>
  </w:style>

  <!-- TOC entries are one-row tables (see ca6-reply-brief.lua): a label cell indented to its level, and a title
       cell with the dot-leader tab for the page number. A tab after a label in a paragraph with a hanging indent
       would take the dot leader too, so the label gets its own cell. -->
<w:style w:type="paragraph" w:customStyle="1" w:styleId="CATOCTextTop">
    <w:name w:val="CA TOC Text Top"/>
    <w:basedOn w:val="Normal"/>
    <w:pPr>
      <w:tabs>
        <w:tab w:val="right" w:leader="dot" w:pos="9245"/>
      </w:tabs>
      <w:spacing w:before="168" w:after="0" w:line="399" w:lineRule="exact"/>
      <w:ind w:left="0" w:firstLine="0"/>
    </w:pPr>
  </w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="CATOCText0">
    <w:name w:val="CA TOC Text 0"/>
    <w:basedOn w:val="Normal"/>
    <w:pPr>
      <w:tabs>
        <w:tab w:val="right" w:leader="dot" w:pos="8525"/>
      </w:tabs>
      <w:spacing w:before="98" w:after="0" w:line="399" w:lineRule="exact"/>
      <w:ind w:left="0" w:firstLine="0"/>
    </w:pPr>
  </w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="CATOCText1">
    <w:name w:val="CA TOC Text 1"/>
    <w:basedOn w:val="Normal"/>
    <w:pPr>
      <w:tabs>
        <w:tab w:val="right" w:leader="dot" w:pos="7805"/>
      </w:tabs>
      <w:spacing w:before="98" w:after="0" w:line="399" w:lineRule="exact"/>
      <w:ind w:left="0" w:firstLine="0"/>
    </w:pPr>
  </w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="CATOCText2">
    <w:name w:val="CA TOC Text 2"/>
    <w:basedOn w:val="Normal"/>
    <w:pPr>
      <w:tabs>
        <w:tab w:val="right" w:leader="dot" w:pos="7085"/>
      </w:tabs>
      <w:spacing w:before="98" w:after="0" w:line="399" w:lineRule="exact"/>
      <w:ind w:left="0" w:firstLine="0"/>
    </w:pPr>
  </w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="CATOCText3">
    <w:name w:val="CA TOC Text 3"/>
    <w:basedOn w:val="Normal"/>
    <w:pPr>
      <w:tabs>
        <w:tab w:val="right" w:leader="dot" w:pos="6365"/>
      </w:tabs>
      <w:spacing w:before="98" w:after="0" w:line="399" w:lineRule="exact"/>
      <w:ind w:left="0" w:firstLine="0"/>
    </w:pPr>
  </w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="CATOCLabel0">
    <w:name w:val="CA TOC Label 0"/>
    <w:basedOn w:val="Normal"/>
    <w:pPr>
      <w:spacing w:before="98" w:after="0" w:line="399" w:lineRule="exact"/>
      <w:ind w:left="0" w:firstLine="0"/>
    </w:pPr>
  </w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="CATOCLabel1">
    <w:name w:val="CA TOC Label 1"/>
    <w:basedOn w:val="Normal"/>
    <w:pPr>
      <w:spacing w:before="98" w:after="0" w:line="399" w:lineRule="exact"/>
      <w:ind w:left="720" w:firstLine="0"/>
    </w:pPr>
  </w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="CATOCLabel2">
    <w:name w:val="CA TOC Label 2"/>
    <w:basedOn w:val="Normal"/>
    <w:pPr>
      <w:spacing w:before="98" w:after="0" w:line="399" w:lineRule="exact"/>
      <w:ind w:left="1440" w:firstLine="0"/>
    </w:pPr>
  </w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="CATOCLabel3">
    <w:name w:val="CA TOC Label 3"/>
    <w:basedOn w:val="Normal"/>
    <w:pPr>
      <w:spacing w:before="98" w:after="0" w:line="399" w:lineRule="exact"/>
      <w:ind w:left="2160" w:firstLine="0"/>
    </w:pPr>
  </w:style>

<w:style w:type="paragraph" w:customStyle="1" w:styleId="CATOAGroup">
    <w:name w:val="CA TOA Group"/>
    <w:basedOn w:val="Normal"/>
    <w:pPr>
      <w:keepNext/>
      <w:tabs>
        <w:tab w:val="right" w:pos="9360"/>
      </w:tabs>
      <w:spacing w:before="280" w:after="60" w:line="399" w:lineRule="exact"/>
      <w:ind w:firstLine="0"/>
    </w:pPr>
    <w:rPr>
      <w:b/>
      <w:bCs/>
    </w:rPr>
  </w:style>

<w:style w:type="paragraph" w:customStyle="1" w:styleId="CATOAEntry">
    <w:name w:val="CA TOA Entry"/>
    <w:basedOn w:val="Normal"/>
    <w:pPr>
      <w:keepLines/>
      <w:tabs>
        <w:tab w:val="right" w:leader="dot" w:pos="9360"/>
      </w:tabs>
      <w:spacing w:before="140" w:after="0" w:line="399" w:lineRule="exact"/>
      <w:ind w:left="504" w:hanging="504" w:firstLine="0"/>
    </w:pPr>
  </w:style>

<w:style w:type="paragraph" w:customStyle="1" w:styleId="CATable">
    <w:name w:val="CA Table Text"/>
    <w:basedOn w:val="Compact"/>
    <w:pPr>
      <w:spacing w:before="0" w:after="0" w:line="399" w:lineRule="exact"/>
      <w:ind w:firstLine="0"/>
      <w:jc w:val="left"/>
    </w:pPr>
  </w:style>

<w:style w:type="paragraph" w:customStyle="1" w:styleId="CASectionBreak">
    <w:name w:val="CA Section Break"/>
    <w:basedOn w:val="Normal"/>
    <w:pPr>
      <w:spacing w:before="0" w:after="0" w:line="20" w:lineRule="exact"/>
      <w:ind w:firstLine="0"/>
    </w:pPr>
    <w:rPr>
      <w:sz w:val="2"/>
