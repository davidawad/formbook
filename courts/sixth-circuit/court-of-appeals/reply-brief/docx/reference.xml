<?xml version="1.0" encoding="UTF-8"?>
<!-- The CA6 reply brief's Word styles (fb render builds docx/reference.docx from them, tools/fb/src/docxref.rs; were
     docx/make-reference.sh): the shared style recipe of the cross-engine layout model (tools/fb/src/docxxengine.rs;
     docs/EVAL-LOOP.md, "Cross-engine gate") in the typst template's face ({font}, Times New Roman) 14 pt, Body Text
     in 31.4 pt line boxes with a half-inch indent, footnotes 14 pt in 20 pt boxes with 7 pt between them, block
     quotations 14 pt above and below; exact line spacing; the typst pitch-double and pitch-single. One style of its
     own: "CA Body Keep", the body's last paragraph, kept with the signature block (typst sets them in one unbreakable
     block). Word 2013+ layout rules in settings.xml (compatibilityMode 15: tab stops measured from the margin, as
     LibreOffice needs for the TOC). Every other paragraph (cover, headings, tables, signature, certificates) carries
     its own spacing, and the sections, the footers and the last section come from ca6-reply-brief.lua
     (FORMBOOK_FOOTERS, FORMBOOK_FINAL). Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="28" body="628" single="400" indent="720" quote="280" note-after="140">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="CABodyKeep"><w:name w:val="CA Body Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<part name="word/settings.xml">
<w:settings xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:sl="http://schemas.openxmlformats.org/schemaLibrary/2006/main">
  <w:zoom w:percent="100" />
  <w:embedSystemFonts />
  <w:proofState w:spelling="clean" w:grammar="clean" />
  <w:stylePaneFormatFilter w:val="0004" />
  <w:doNotTrackMoves />
  <w:defaultTabStop w:val="720" />
  <w:drawingGridHorizontalSpacing w:val="360" />
  <w:drawingGridVerticalSpacing w:val="360" />
  <w:displayHorizontalDrawingGridEvery w:val="0" />
  <w:displayVerticalDrawingGridEvery w:val="0" />
  <w:characterSpacingControl w:val="doNotCompress" />
  <w:savePreviewPicture />
  <w:footnotePr>
    <w:footnote w:id="-1" />
    <w:footnote w:id="0" />
  </w:footnotePr>
  <w:compat><w:compatSetting w:name="compatibilityMode" w:uri="http://schemas.microsoft.com/office/word" w:val="15"/></w:compat><w:rsids>
  </w:rsids>
  <m:mathPr>
    <m:mathFont m:val="Cambria Math" />
    <m:brkBin m:val="before" />
    <m:brkBinSub m:val="--" />
    <m:smallFrac m:val="0" />
    <m:dispDef />
    <m:lMargin m:val="0" />
    <m:rMargin m:val="0" />
    <m:wrapRight />
    <m:intLim m:val="subSup" />
    <m:naryLim m:val="undOvr" />
  </m:mathPr>
  <w:themeFontLang w:val="en-US" />
  <w:clrSchemeMapping w:bg1="light1" w:t1="dark1" w:bg2="light2" w:t2="dark2" w:accent1="accent1" w:accent2="accent2" w:accent3="accent3" w:accent4="accent4" w:accent5="accent5" w:accent6="accent6" w:hyperlink="hyperlink" w:followedHyperlink="followedHyperlink" />
  <w:decimalSymbol w:val="." />
  <w:listSeparator w:val="," />
</w:settings>
</part>
</reference>
