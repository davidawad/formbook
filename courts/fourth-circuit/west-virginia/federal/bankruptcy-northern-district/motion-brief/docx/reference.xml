<?xml version="1.0" encoding="UTF-8"?>
<!-- The N.D. W. Va. bankruptcy motion's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face
     of the typst template ({font}, Times New Roman) at 12 pt (LBR 9004-1: at least 10 pt; size 24 half points); Body
     Text in exact 18 pt line boxes (typst pitch-body, about 1.5 spacing, inside LBR 9004-1's single-to-double range)
     with a half-inch indent; the counsel block, court lines, caption, notice, headings, quotations, signature and
     certificate in 13.8 pt boxes (typst pitch-single); footnotes 10 pt in 11.5 pt boxes (typst pitch-note), 6 pt
     after each (typst note-gap), kept whole; letter page with 1-inch margins and a centered page number, its line
     36.75 pt above the page foot (735 twips: where typst sets it, footer-descent 30 %). Styles added: Body Text Noted,
     Body Text without widow control, for a paragraph that holds a footnote mark; Body Text Spaced (and Spaced Noted),
     a single line above it, for the paragraph after the negative notice's box (Word sets no space after a table).
     docx/wvnb-motion-brief.lua writes everything but the body paragraphs and their footnotes with its own spacing.
     Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="360" single="276" indent="720" heading="276" heading-before="276" heading-after="138" note="230" note-size="20" note-after="120" footer="735">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNoted"><w:name w:val="Body Text Noted"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextSpaced"><w:name w:val="Body Text Spaced"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:spacing w:before="276" w:after="0" w:line="360" w:lineRule="exact"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextSpacedNoted"><w:name w:val="Body Text Spaced Noted"/><w:basedOn w:val="BodyTextSpaced"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
</reference>
