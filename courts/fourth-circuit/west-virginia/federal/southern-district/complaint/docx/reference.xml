<!-- The S.D. W. Va. complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face of the
     typst template ({font}, Times New Roman, as the memorandum: LR Civ P 7.1(a)(4)) at 12 pt (size 24 half points;
     footnotes too); Body Text in exact 24 pt line boxes (typst pitch-body, double spacing as LR Civ P 7.1(a)(3)) with
     a half-inch first-line indent; Allegation (Fed. R. Civ. P. 10(b) numbered paragraphs): the number at the half
     inch, the text from a tab at one inch; Block Text (quotations) and Footnote Text in 13.8 pt boxes (typst
     pitch-single), quotations 12 pt above and below and indented half an inch on both sides, footnotes 7 pt apart
     (typst note-gap); letter page with 1-inch margins. docx/complaint.lua writes the cover, the table of contents,
     the headings, the lead-in, the signature and the verification with their own spacing, the sections and their
     footers (none on the cover; the page number, roman on the contents and arabic from 1 on the body, in a 13.8 pt
     line 36.6 pt above the page foot: 732 twips, where typst sets it, footer-descent 30 %). Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="276" indent="720" heading="276" heading-before="240" heading-after="240" quote="240" note-after="140" footer="732">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Allegation"><w:name w:val="Allegation"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:firstLine="720"/></w:pPr></w:style>
</reference>
