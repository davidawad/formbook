// Memorandum of law in support of a motion to dismiss, for the U.S. District Court for the Southern District of West
// Virginia (wvsd), on the generic FRCP brief with the S.D. W. Va. local rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and
// docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced
// breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LR Civ P 7.1(a)(4): a proportional face of 12 point or larger; Times New Roman is on the rule's presumed-legible
// list and the house standard (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let wvsd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
