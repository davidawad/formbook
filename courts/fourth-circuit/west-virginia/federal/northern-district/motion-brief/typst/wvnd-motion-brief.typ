// Memorandum of law supporting a motion, for the U.S. District Court for the Northern District of West Virginia (wvnd),
// on the generic FRCP brief with the N.D. W. Va. local rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and
// docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced
// breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LR Civ P 7.02(a): Times New Roman, Courier New or Arial, 12 point proportional: Times New Roman, vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let wvnd-motion-brief(meta, body) = {
  // Fed. R. Civ. P. 11(a): the signer's e-mail address and telephone number among the signature lines.
  let lines = meta.signature.lines
  assert(lines.any(l => l.contains("@")), message: "wvnd-motion-brief: the signature lines need an e-mail address (Fed. R. Civ. P. 11(a))")
  assert(lines.any(l => l.match(regex("\\(?\\d{3}\\)?[ .-]?\\d{3}[ .-]?\\d{4}")) != none), message: "wvnd-motion-brief: the signature lines need a telephone number (Fed. R. Civ. P. 11(a))")
  // LR Gen P 5.06(e): the certificate of service names who was served.
  assert("served" in meta.certificate_of_service, message: "wvnd-motion-brief: the certificate needs served (who was served, LR Gen P 5.06(e))")
  xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
}
