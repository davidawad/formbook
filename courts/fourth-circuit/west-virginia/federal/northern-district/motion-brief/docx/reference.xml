<?xml version="1.0" encoding="UTF-8"?>
<!-- The wvnd memorandum's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face of the typst
     template ({font}, Times New Roman; LR Civ P 7.02(a) names Times New Roman) at 12 pt (size 24 half points;
     LR Civ P 7.02(a), 12 point); Body Text in exact 24 pt line boxes (typst pitch-body, LR Civ P 7.02(a) double
     spacing) with a half-inch first-line indent (typst para-indent); caption, signature and certificate lines in
     13.8 pt boxes (typst pitch-single); footnotes 11 pt (note-size 22 half points; LR Civ P 7.02(a): at least 11
     point) single spaced in 12.65 pt boxes (typst pitch-note, 253 twips), 6 pt apart (typst note-gap). Added or
     replaced here, as the typst template sets them: "Body Text Note" (Body Text without widow control, for a
     paragraph that anchors a footnote), Footnote Text without the recipe's keepLines (typst splits a long note
     across pages). Letter page with 1-inch margins (LR Civ P 7.02(a)) and the page number centered in the footer, in
     a 13.8 pt line 36.75 pt above the page foot (735 twips: where typst sets it, footer-descent 30 %).
     docx/wvnd-motion-brief.lua writes the caption, titles, headings, signature and certificate with their own
     spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="276" indent="720" heading="480" heading-before="0" heading-after="0" note="253" note-size="22" note-after="120" footer="735">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:styleId="FootnoteText"><w:name w:val="Footnote Text"/><w:basedOn w:val="Normal"/><w:next w:val="FootnoteText"/><w:uiPriority w:val="9"/><w:unhideWhenUsed/><w:qFormat/><w:pPr><w:widowControl/><w:spacing w:before="0" w:after="120" w:line="253" w:lineRule="exact"/></w:pPr><w:rPr><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr></w:style>
<footer id="rIdFooter1"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="exact" /><w:jc w:val="center" /></w:pPr><w:r><w:fldChar w:fldCharType="begin" /></w:r><w:r><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r><w:r><w:fldChar w:fldCharType="separate" /></w:r><w:r><w:t>1</w:t></w:r><w:r><w:fldChar w:fldCharType="end" /></w:r></w:p></footer>
</reference>
