<!-- The wvnd complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face of the typst
     template ({font}, Times New Roman; LR Civ P 7.02(a) names Times New Roman) at 12 pt (size 24 half points;
     LR Civ P 7.02(a), 12 point); Body Text in exact 24 pt line boxes (typst pitch-body, LR Civ P 7.02(a) double
     spacing) with a half-inch indent; caption and signature lines in 13.8 pt boxes (typst pitch-single); letter page
     with 1-inch margins (LR Civ P 7.02(a)) and the page number centered in the footer, in a 13.8 pt line 36.75 pt
     above the page foot (735 twips: where typst sets it, footer-descent 30 %). docx/wvnd-complaint.lua writes every
     paragraph with its own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="276" indent="720" heading="480" heading-before="0" heading-after="0" footer="735">
<footer id="rIdFooter1"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="exact" /><w:jc w:val="center" /></w:pPr><w:r><w:fldChar w:fldCharType="begin" /></w:r><w:r><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r><w:r><w:fldChar w:fldCharType="separate" /></w:r><w:r><w:t>1</w:t></w:r><w:r><w:fldChar w:fldCharType="end" /></w:r></w:p></footer>
</reference>
