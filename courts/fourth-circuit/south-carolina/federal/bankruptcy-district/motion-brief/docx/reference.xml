<?xml version="1.0" encoding="UTF-8"?>
<!-- The scb motion-brief Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md,
     "Cross-engine gate") in the face of the typst template ({font}) at 12 pt (size 24 half points; no SC bankruptcy
     rule sets a size, FRBP 9004(a) asks for legibility, 12 pt is the convention); Body Text in exact 24 pt line boxes
     (typst pitch-body, double spaced) with a half-inch first-line indent (typst para-indent); single lines in 16.2 pt
     boxes (typst pitch-single: court title, caption, block quotations, signature); headings on the body pitch with
     12 pt above and none below (typst heading-above); footnotes at the type size in 16.2 pt boxes, 6 pt apart (typst
     note-gap); letter page, 1 in margins and the recipe's centred page-number footer, its line box ending 697 twips
     (34.85 pt) above the edge, where typst (footer-descent 30 %) sets the number. The markdown is read without fancy
     lists, as typst (CommonMark) reads it. Added here, for a paragraph that anchors a footnote (no widow control, as
     LaTeX and Word carry a footnote's line with the one before it): "Body Text Note", "Numbered Note" (the fact's
     number after the indent, a tab at 1 in; typst number-box) and "List Letter Note" (the letter half an inch in,
     hanging in a 0.4 in box; typst list-indent, letter-box), and Heading 4 upright (the recipe sets it in italics; typst sets the
     level-4 heading bold upright). Every other paragraph carries its own spacing and indents
     (docx/scb-motion-brief.lua). Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="324" indent="720" heading="480" heading-before="240" heading-after="0" quote="216" note="324" note-size="24" note-after="120" footer="697" pandoc-from="markdown-fancy_lists">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="NumberedNote"><w:name w:val="Numbered Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:firstLine="720"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="ListLetterNote"><w:name w:val="List Letter Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:left="1296" w:hanging="576"/></w:pPr></w:style>
<w:style w:type="paragraph" w:styleId="Heading4"><w:name w:val="heading 4"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="240" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:left="1440" w:hanging="720"/><w:outlineLvl w:val="3"/></w:pPr><w:rPr><w:b/><w:bCs/><w:color w:val="000000"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
</reference>
