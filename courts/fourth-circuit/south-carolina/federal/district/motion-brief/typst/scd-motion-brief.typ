// Memorandum in support of a motion, for the U.S. District Court for the District of South Carolina (scd), on the
// generic FRCP brief with D.S.C.'s local rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`,
// fb-595.17.9), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`).
// Content-agnostic: no case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// L.R. 1.05(B): Times New Roman, Arial or Courier New; Times New Roman, vendored in /fonts (Liberation Serif, its
// metric twin, the fallback; docs/FONTS.md).
#let font-family = ("Times New Roman", "Liberation Serif")

#let scd-motion-brief(meta, body) = {
  assert("division" in meta, message: "scd-motion-brief: the caption names the division (`division`)")
  for k in ("location", "dated", "by", "signers", "firm") {
    assert(k in meta.signature, message: "scd-motion-brief: Fed. R. Civ. P. 11(a): the signature needs `" + k + "`")
  }
  xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
}
