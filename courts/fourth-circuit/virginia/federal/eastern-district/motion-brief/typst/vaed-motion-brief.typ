// Memorandum in support of a motion, for the U.S. District Court for the Eastern District of Virginia (vaed), on the
// generic FRCP brief with the E.D. Va. local rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`,
// fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`).
// Content-agnostic: no case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// L.R. 7(F)(3): "12 point Roman style"; the rule names no face: Times New Roman, the house standard and the exemplar's
// face (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let vaed-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
