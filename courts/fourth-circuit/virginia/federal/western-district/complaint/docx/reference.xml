<!-- The W.D. Va. complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face of the
     typst template ({font}, Times New Roman) at 12 pt (size 24 half points). No W.D. Va. rule sets a size, margin
     or spacing for pleadings (../README.md): the convention of both exemplars. Body Text in exact 27.6 pt line boxes
     (552 twips, typst pitch-body, double spacing) with a half-inch indent; the court title, caption and signature
     lines in 13.8 pt boxes (276 twips, typst pitch-single); letter page with 1-inch margins and the page number
     centered in the footer in a 13.8 pt box, its line 36.6 pt above the page foot (732 twips: where typst sets it,
     footer-descent 30 %). docx/vawd-complaint.lua writes every paragraph's own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="552" single="276" indent="720" heading="552" heading-before="276" heading-after="0" footer="732">
<footer id="rIdFooter1"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="exact" /><w:jc w:val="center" /></w:pPr><w:r><w:fldChar w:fldCharType="begin" /></w:r><w:r><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r><w:r><w:fldChar w:fldCharType="separate" /></w:r><w:r><w:t>1</w:t></w:r><w:r><w:fldChar w:fldCharType="end" /></w:r></w:p></footer>
</reference>
