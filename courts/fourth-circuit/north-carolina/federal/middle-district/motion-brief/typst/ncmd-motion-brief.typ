// Brief in support of a motion, for the U.S. District Court for the Middle District of North Carolina (ncmd), on the
// generic FRCP brief with M.D.N.C.'s local rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17.9), set by the shared document model (lib/typst/xdoc.typ; latex/ and
// docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced
// breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// NCMD-FORM-002, LR 7.1(a) names no face (a proportional font of 13 point or more): Times New Roman, the house
// standard (docs/FONTS.md rule 6). Vendored in /fonts (Liberation Serif, its metric twin, the fallback).
#let font-family = ("Times New Roman", "Liberation Serif")

#let ncmd-motion-brief(meta, body) = {
  for k in ("case_number", "caption", "brief_title", "date", "certificate_date", "service_date", "signatures") {
    assert(k in meta, message: "ncmd-motion-brief: missing required metadata field `" + k + "`")
  }
  // NCMD-FIRST-001, LR 7.1(b): each signer's name, mailing address, telephone and e-mail.
  for s in meta.signatures {
    for k in ("signer", "address", "phone", "email", "role") {
      assert(k in s, message: "ncmd-motion-brief: signer block missing `" + k + "` (LR 7.1(b))")
    }
  }
  xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
}
