<!-- The M.D.N.C. Bankruptcy motion brief's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the
     face of the typst template ({font}, Times New Roman) at 12 pt (no local size rule; size 24 half points); Body Text
     in exact 24 pt line boxes (typst pitch-double, the exemplar's double spacing) with a half-inch first-line indent;
     the court lines, title, headings, signature, certificate and footnotes in 13.8 pt boxes (typst pitch-single), a
     heading 12 pt (240 twips) from the text on either side, footnotes 7 pt apart (typst note-gap); letter page with
     1-inch margins and a centered page number from page two (titlePg: none on the caption page), its line 36.75 pt
     above the page foot (735 twips: where typst sets it, footer-descent 30 %). docx/ncmb-motion-brief.lua writes
     every paragraph's own spacing. Twips: 20 x pt.
     Heading 4 and 5 without the recipe's italics (typst sets the numbered headings bold, upright). One style of its
     own: "Body Text Note", Body Text without widow control, for a paragraph that carries a footnote mark (typst
     keeps a paragraph's last two lines together by their height alone; when the line's footnote does not fit, that
     line moves on and the one before stays behind; with widow control off Word does the same). -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="276" indent="720" heading="276" heading-before="240" heading-after="240" note-after="140" footer="735">
<w:style w:type="paragraph" w:styleId="Heading4"><w:name w:val="heading 4"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:uiPriority w:val="9"/><w:unhideWhenUsed/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="240" w:after="240" w:line="276" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:outlineLvl w:val="3"/></w:pPr><w:rPr><w:rFonts w:ascii="{font}" w:hAnsi="{font}" w:eastAsia="{font}" w:cs="{font}"/><w:b/><w:bCs/><w:color w:val="000000"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
<w:style w:type="paragraph" w:styleId="Heading5"><w:name w:val="heading 5"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:uiPriority w:val="9"/><w:unhideWhenUsed/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="240" w:after="240" w:line="276" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:outlineLvl w:val="4"/></w:pPr><w:rPr><w:rFonts w:ascii="{font}" w:hAnsi="{font}" w:eastAsia="{font}" w:cs="{font}"/><w:b/><w:bCs/><w:color w:val="000000"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:sectPr><w:footerReference w:type="default" r:id="rIdFooter1"/><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="720" w:footer="735" w:gutter="0"/><w:titlePg/></w:sectPr>
</reference>
