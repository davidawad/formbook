// Memorandum supporting a motion, for the U.S. District Court for the Western District of North Carolina (ncwd), on
// the generic FRCP brief with W.D.N.C.'s local rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17.9), set by the shared document model (lib/typst/xdoc.typ; latex/
// and docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced
// breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LCvR 7.1(d) sets a 12-point minimum and names no face: Times New Roman, the house standard (docs/FONTS.md rule 6).
// Vendored in /fonts (Liberation Serif, its metric twin, the fallback).
#let font-family = ("Times New Roman", "Liberation Serif")

#let ncwd-motion-brief(meta, body) = {
  // Fed. R. Civ. P. 11(a): signed, with the date line.
  assert("signature" in meta and "date_line" in meta.signature and "blocks" in meta.signature, message:
    "ncwd-motion-brief: Fed. R. Civ. P. 11(a) needs `signature.date_line` and `signature.blocks`")
  if meta.at("ai_certification", default: false) == true {
    assert("ai_title" in meta, message: "ncwd-motion-brief: the AI certification names the paper (`ai_title`)")
  }
  xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
}
