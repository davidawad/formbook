// Memorandum supporting a motion, for the U.S. District Court for the Eastern District of North Carolina (nced), on
// the generic FRCP brief with E.D.N.C.'s local rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17.9), set by the shared document model (lib/typst/xdoc.typ; latex/
// and docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced
// breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LR 10.1(a) names no face ("at least 11 point"): Times New Roman 12 pt, the house standard (docs/FONTS.md rule 6)
// and the exemplar's face. Vendored in /fonts (Liberation Serif, its metric twin, the fallback).
#let font-family = ("Times New Roman", "Liberation Serif")

#let nced-motion-brief(meta, body) = {
  // LR 10.1(b): the court and the division.
  assert("division" in meta, message: "nced-motion-brief: LR 10.1(b) needs the division (`division`)")
  // LR 10.1(f) to (i): the date, the signer and each attorney's typed name.
  assert("date" in meta, message: "nced-motion-brief: LR 10.1(g) needs the date (`date`)")
  assert("by" in meta.signature and "signers" in meta.signature and "address" in meta.signature, message:
    "nced-motion-brief: LR 10.1(f), (h), (i) need `signature.by`, `signature.signers` and `signature.address`")
  xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
}
