// Memorandum in support of a motion, for the U.S. District Court for the District of Maryland (mdd), on the generic
// FRCP brief with D. Md.'s local rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`,
// fb-595.17.9), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`).
// Content-agnostic: no case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// L.R. 102.2.b: "Times New Roman or larger typeface". Vendored in /fonts (Liberation Serif, its metric twin, the
// fallback; docs/FONTS.md).
#let font-family = ("Times New Roman", "Liberation Serif")

#let mdd-motion-brief(meta, body) = {
  // L.R. 102.2.a: the short title names the first plaintiff and the first defendant only.
  assert(meta.caption.parties.len() == 2, message:
    "mdd-motion-brief: L.R. 102.2.a: the short caption names the first plaintiff and the first defendant only")
  // L.R. 102.1.b.i: counsel's name, bar number, address, telephone, e-mail and fax ("None" is a value).
  for k in ("name", "bar", "firm", "address", "phone", "fax", "email", "role") {
    assert(k in meta.signature, message: "mdd-motion-brief: L.R. 102.1.b.i: the signature block needs `" + k + "`")
  }
  xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
}
