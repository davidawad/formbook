<?xml version="1.0" encoding="UTF-8"?>
<!-- The D. Md. memorandum's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face of the
     typst template ({font}, Times New Roman; LR-102.2.b: Times New Roman 12 pt or larger; size 24 half points); Body
     Text in exact 27.6 pt line boxes (typst pitch-double; LR-102.2.b double-spaced) with a half-inch indent, and the
     headings in them; the court lines, caption, signature and footer lines in 13.8 pt boxes (typst pitch-single);
     footnotes 10 pt (LR-102.2.b; size 20) in 11.5 pt boxes (typst pitch-note), 7 pt apart. Two styles of their own
     for a paragraph pandoc writes because it carries a footnote: "Body Text Note" (Body Text, the note's paragraph) and "List Item Indented" (a list item: the number at 0.5 in,
     the text hanging at 1.125 in). Letter page with 1-inch margins (LR-102.2.b) and a centered page number from
     page two (titlePg: none on page one), its line 36.75 pt above the page foot (735 twips: where typst sets it,
     footer-descent 30 %). docx/mdd-motion-brief.lua writes every other paragraph's own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="552" single="276" indent="720" heading="552" heading-before="395" heading-after="0" note="230" note-size="20" note-after="140" footer="735" pandoc-from="markdown+smart-fancy_lists">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="0" w:line="552" w:lineRule="exact"/><w:ind w:firstLine="720"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="ListItemIndented"><w:name w:val="List Item Indented"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="0" w:line="552" w:lineRule="exact"/><w:ind w:left="1620" w:hanging="900"/></w:pPr></w:style>
<w:sectPr><w:footerReference w:type="default" r:id="rIdFooter1"/><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="720" w:footer="735" w:gutter="0"/><w:titlePg/></w:sectPr>
</reference>
