<?xml version="1.0" encoding="UTF-8"?>
<!-- The Federal Circuit brief's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md,
     "Cross-engine gate") in the face of the typst template ({font}, Times New Roman) 14 pt (size 28 half points);
     Body Text in 32.2 pt line boxes with a half-inch indent; List Item with the label in a half-inch box; footnotes
     14 pt in 16.1 pt boxes, 7 pt apart; exact line spacing (typst pitch-double, pitch-single); plus "Body Last": the
     brief's last paragraph, kept with the signature block, and "Body Text Note": a paragraph that anchors a footnote,
     without widow control (typst's widow and orphan rules do not see the note). The cover, headings, tables, signature
     and certificates carry their own paragraph properties (cafc-docx.lua), which also writes the sections, the footers
     (FORMBOOK_FOOTERS) and the last section (FORMBOOK_FINAL). Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="28" body="644" single="322" indent="720" list="720" note="322" note-size="28" note-after="140">
  <w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyLast"><w:name w:val="Body Last"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
  <w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
</reference>
