<!-- The CIT complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md,
     "Cross-engine gate") in the face of the typst template (Times New Roman) at 12 pt (size 24 half points), Body
     Text at the 24 pt body pitch with a 0.5 in first-line indent, single lines at 14 pt, letter paper, 1 in margins,
     a centered page number in a 14 pt line. Same numbers as typst/cit-complaint.typ (pitch, pitch-single,
     para-indent); every paragraph the filter writes carries its own spacing and indents. The footer sits where typst
     puts it: its 14 pt line box 1.2 in + 0.3 x 1 in below the top of the bottom margin, i.e. 36.4 pt (728 twips)
     above the page edge; the page number in a single-pitch line box (typst: text(..edges(pitch-single))).
     Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="280" indent="720" list="576" heading="480" heading-before="240" heading-after="0" footer="728">
  <footer id="rIdFooter1"><w:p><w:pPr><w:spacing w:before="0" w:after="0" w:line="280" w:lineRule="exact"/><w:jc w:val="center"/></w:pPr><w:r><w:fldChar w:fldCharType="begin" /></w:r><w:r><w:instrText xml:space="preserve"> PAGE </w:instrText></w:r><w:r><w:fldChar w:fldCharType="separate" /></w:r><w:r><w:t>1</w:t></w:r><w:r><w:fldChar w:fldCharType="end" /></w:r></w:p></footer>
</reference>
