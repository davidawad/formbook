<?xml version="1.0" encoding="UTF-8"?>
<!-- The CFC motion brief's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md,
     "Cross-engine gate") in the face of the typst template (Times New Roman) at 12 pt (RCFC 5.5(c)(2); size 24 half
     points); Body Text in exact 27.6 pt line boxes (RCFC 5.5(c)(4), double spaced; typst pitch-double) with a
     half-inch first-line indent; footnotes and block quotations in 13.8 pt boxes (typst pitch-single), a quotation a
     single line off the text; letter page with 1-inch margins (RCFC 5.5(c)(1)(A), (c)(3)) and a centred page-number
     footer (RCFC 5.5(c)(6)). Twips = 20 x the typst points. Headings, cover, tables, signature and certificate carry
     their own paragraph properties (docx/uscfc-motion-brief.lua), which also writes the sections (the body's, arabic
     from 1, the last). Added here: the "Keep With Next" style (the last paragraph before the signature block). -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="552" single="276" indent="720" quote="276" note-after="120">
  <w:style w:type="paragraph" w:customStyle="1" w:styleId="KeepWithNext"><w:name w:val="Keep With Next"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
</reference>
