// Memorandum of law supporting a motion, for the U.S. District Court for the District of Vermont (vtd), on the
// generic FRCP brief with D. Vt.'s local rules overlaid (typst/layout.yaml: `base: /lib/layouts/frcp-motion-brief.yaml`,
// fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and docx/ generated by `fb engines gen`).
// Content-agnostic: no case-specific text, measured coordinates or forced breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// L.R. 10(a)(2), (4): plainly legible, 12 point or more; the rule names no face: Times New Roman, the house standard and
// the exemplar's face (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let vtd-motion-brief(meta, body) = {
  // L.R. 7(a)(1): the court considers no motion whose title lacks the word "motion"; the memorandum names its motion.
  assert(lower(meta.brief_title).contains("motion"), message: "vtd-motion-brief: L.R. 7(a)(1): the title must name the motion (the word \"motion\")")
  xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
}
