<?xml version="1.0" encoding="UTF-8"?>
<!-- The ca2 answering brief's Word styles; fb render builds docx/reference.docx from pandoc's default reference with
     them (tools/fb/src/docxref.rs). Times New Roman 14 pt everywhere (typst/ca2-answering-brief.typ, FRAP
     32(a)(5)(A)); exact 31.4 pt (double) body line spacing with a 0.5 in first-line indent (FRAP 32(a)(4)); exact
     19.9 pt (the typst single-leading pitch) for headings, footnotes, block quotations, the cover, the tables and
     the certificates; letter paper with 1 in margins. Section headings bold capitals at 16 pt (typst 1.15em). The
     footers and the last section are fb render's (rIdFtrNone, rIdFtrPage, rIdFtrAdd; docx/ca2.lua writes
     FORMBOOK_FINAL). -->
