<?xml version="1.0" encoding="UTF-8"?>
<!-- The N.D.N.Y. complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face of the
     typst template ({font}, Times New Roman; L.R. 10.1 names none) at 12 pt (size 24 half points, L.R. 10.1(a)(1));
     Body Text in exact 24 pt line boxes (typst pitch-double, L.R. 10.1(a)(3) double spaced) with a half-inch indent,
     and the headings in them; the court title, caption, quotations and signature in 13.8 pt boxes (typst
     pitch-single); letter page with 1-inch margins on all sides (L.R. 10.1(a)(2)) and a centered page number at the
     bottom, its line 36 pt above the page foot (720 twips: where typst sets it, footer-descent 30 %). The markdown is
     read as CommonMark, as cmarker reads it (a literal "*" stays literal; "<!-- unnumbered -->" is an HTML block).
     docx/nynd-complaint.lua writes every paragraph's own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="276" indent="720" heading="480" heading-before="0" heading-after="0" footer="720" pandoc-from="commonmark+smart+yaml_metadata_block"/>
