// Memorandum of law in support of a motion for the U.S. District Court for the Northern District of New York (nynd),
// on the generic FRCP brief with N.D.N.Y.'s local rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and
// docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced breaks.
// See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// L.R. 10.1(a)(1): 12-point type; the rules name no face: Times New Roman, the house standard and the exemplar's face
// (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

// L.R. 7.1(b)(1): a memorandum of law at most 25 pages, double-spaced, unless the judge grants leave (frontmatter:
// leave.pages).
#let max-pages = 25

#let nynd-motion-brief(meta, body) = {
  // L.R. 7.1(b)(1): the moving party specifies the rule or statute the motion is based on.
  assert(meta.at("motion_basis", default: "") != "",
    message: "nynd-motion-brief: L.R. 7.1(b)(1) requires the rule or statute the motion is based on (frontmatter: motion_basis)")
  // L.R. 10.1(c)(1): the assigned judge's initials in the caption.
  assert(meta.at("judges", default: "") != "",
    message: "nynd-motion-brief: L.R. 10.1(c)(1) requires the assigned judge's initials in the caption (frontmatter: judges)")
  // L.R. 10.1(c)(2): the bar roll number of each signing attorney.
  for s in meta.signature.signers {
    assert(s.at("bar_roll", default: "") != "",
      message: "nynd-motion-brief: L.R. 10.1(c)(2) requires the bar roll number of each signing attorney (frontmatter: signature.signers[].bar_roll)")
  }
  xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
  // The body, numbered from 1 (the cover and contents apart), within the limit.
  context {
    let limit = if "leave" in meta { meta.leave.pages } else { max-pages }
    let n = counter(page).final().first()
    assert(n <= limit,
      message: "nynd-motion-brief: the memorandum body is " + str(n) + " pages; L.R. 7.1(b)(1) allows " + str(limit) + " without leave (frontmatter: leave.pages)")
  }
}
