// Memorandum of law in support of a motion for the U.S. District Court for the Western District of New York (nywd), on
// the generic FRCP brief with W.D.N.Y.'s local rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and
// docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced breaks.
// See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// L. R. Civ. P. 10(a)(1): at least 12-point type; no W.D.N.Y. rule names a face: Times New Roman, the house standard and
// the exemplars' face (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let nywd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
