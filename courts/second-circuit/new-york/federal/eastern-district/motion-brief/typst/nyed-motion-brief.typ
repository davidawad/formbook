// Memorandum of law in support of a motion for the U.S. District Court for the Eastern District of New York (nyed), on
// the generic FRCP brief with the E.D.N.Y. rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and
// docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced breaks.
// See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// NYED-FORM-002: Local Civil Rule 7.1(b)(1) names no typeface (12-point type or larger, 10-point in footnotes): Times
// New Roman, the house standard and the exemplars' face (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let nyed-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
