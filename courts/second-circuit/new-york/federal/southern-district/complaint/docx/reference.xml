<?xml version="1.0" encoding="UTF-8"?>
<!-- The S.D.N.Y. complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face of the
     typst template ({font}, Times New Roman; the joint rules name no face, NYSD-FORM-002) at 12 pt (size 24 half
     points, Local Civ. R. 7.1(b)(1), footnotes included); Body Text in exact 24 pt line boxes (typst pitch-double,
     Local Civ. R. 7.1(b)(3) double spaced) with a half-inch first-line indent; single lines in 13.8 pt boxes (typst
     pitch-single). Pandoc reads the sample as CommonMark, as typst's cmarker reads it. Styles the filter names:
     "Numbered", Body Text with a tab at 1 in (the paragraph number in a half-inch box after the indent); "Body Text
     Note" and "Numbered Note", without widow control, for a paragraph that carries a footnote mark (typst's widow
     rule does not see the note); "Body Text Keep" and "Numbered Keep", the last paragraph kept with the signature
     block. Block Text (quotations): single lines 0.75 in in on the left and 0.5 in on the right, a single line
     above and below (typst quote-left, quote-right). Footnote Text at the text size in 13.8 pt boxes, 7 pt apart
     (typst note-gap), without keepLines, so a long note splits across a page as typst's does. Letter page, 1-inch
     margins (Local Civ. R. 7.1(b)(2)); the page number centered in a 13.8 pt line 36 pt above the page foot (720
     twips: where typst sets it, footer-descent 30 %). docx/complaint.lua writes the cover, caption, headings, lists
     and signature with their own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" pandoc-from="commonmark+smart+footnotes+yaml_metadata_block" size="24" body="480" single="276" indent="720" quote="276" note="276" note-after="140" footer="720">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Numbered"><w:name w:val="Numbered"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="NumberedNote"><w:name w:val="Numbered Note"/><w:basedOn w:val="Numbered"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="NumberedKeep"><w:name w:val="Numbered Keep"/><w:basedOn w:val="Numbered"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextKeep"><w:name w:val="Body Text Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<w:style w:type="paragraph" w:styleId="BlockText"><w:name w:val="Block Text"/><w:basedOn w:val="BodyText"/><w:next w:val="BodyText"/><w:uiPriority w:val="9"/><w:unhideWhenUsed/><w:qFormat/><w:pPr><w:spacing w:before="276" w:after="276" w:line="276" w:lineRule="exact"/><w:ind w:firstLine="0" w:left="1080" w:right="720"/></w:pPr></w:style>
<w:style w:type="paragraph" w:styleId="FootnoteText"><w:name w:val="Footnote Text"/><w:basedOn w:val="Normal"/><w:next w:val="FootnoteText"/><w:uiPriority w:val="9"/><w:unhideWhenUsed/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="140" w:line="276" w:lineRule="exact"/></w:pPr><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
</reference>
