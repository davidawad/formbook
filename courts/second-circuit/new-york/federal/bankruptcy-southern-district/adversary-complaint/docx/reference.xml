<?xml version="1.0" encoding="UTF-8"?>
<!-- The nysb adversary complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md,
     "Cross-engine gate") in the face of the typst template ({font}, Times New Roman, as both exemplars are set; no
     S.D.N.Y. bankruptcy rule names a face) at 12 pt (size 24 half points, the exemplar's size); Body Text in exact
     27.6 pt line boxes (typst pitch-body, the exemplar's double spacing) with a half-inch first-line indent (typst
     para-indent); the headings in them with no space of their own; footnotes at the type size in exact 13.8 pt boxes
     (typst pitch-single, as the exemplar sets them), 7 pt after each (typst note-gap); letter page with 1-inch margins
     (the exemplar's) and the page number centered, its line 36.75 pt above the page foot (735 twips: where typst
     sets it, footer-descent 30 %). Added here: "Body Number", a numbered paragraph (Fed. R. Civ. P. 10(b)): the
     number at the indent, a tab 1 in from the margin (typst number-box); "Body Keep", the last paragraph before the
     signature block, kept with it and a double line above it (typst sig-above); "Lettered" and "Lettered Keep", a
     prayer item: the label at the indent, the text hanging at 1 in (typst letter-box). docx/nysb-adversary-complaint.lua
     writes the cover, the caption table, the headings and the signature with their own spacing, and the sections
     (the cover without a page number, its note in its footer; the body from 1). The sample is read as CommonMark, as
     typst's cmarker reads it. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" pandoc-from="commonmark+smart+footnotes+yaml_metadata_block" size="24" body="552" single="276" indent="720" heading="552" heading-before="0" heading-after="0" note="276" note-size="24" note-after="140" footer="735">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyNumber"><w:name w:val="Body Number"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="552" w:lineRule="exact"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyKeep"><w:name w:val="Body Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="552" w:line="552" w:lineRule="exact"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="Lettered"><w:name w:val="Lettered"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="552" w:lineRule="exact"/><w:ind w:left="1440" w:hanging="720"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="LetteredKeep"><w:name w:val="Lettered Keep"/><w:basedOn w:val="Lettered"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="0" w:after="552" w:line="552" w:lineRule="exact"/></w:pPr></w:style>
</reference>
