// Memorandum of law in support of a motion for the U.S. District Court for the District of Connecticut (ctd), on the
// generic FRCP brief with D. Conn.'s local rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and
// docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced breaks.
// See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// CTD-FORM-006: the rules name no font (L. Civ. R. 7(a)(5): at least 12 point, footnotes 10): Times New Roman, the
// house standard and the exemplar's face (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let ctd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
