<?xml version="1.0" encoding="UTF-8"?>
<!-- The ctd motion-brief Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md,
     "Cross-engine gate") in the face of the typst template ({font}, Times New Roman; no rule names a face, CTD-FORM-006)
     at 12 pt (size 24 half points; L. Civ. R. 7(a)(5): "at least 12 point font"); Body Text in exact 27.6 pt line
     boxes (552 twips, typst pitch-body; L. Civ. R. 7(a)(5): "double-spaced") with a half-inch first-line indent (typst
     para-indent); single lines in 13.8 pt boxes (276 twips, typst pitch-single); footnotes at 10 pt (note-size 20 half
     points; L. Civ. R. 7(a)(5): "at least 10 point") in 11.5 pt single lines (230 twips, typst pitch-note), 4 pt apart
     (80 twips, typst note-gap). Added or replaced here, as the typst template sets them: "Body Text Keep" (a paragraph
     of the conclusion, kept with the next and so with the signature block; typst: one unbreakable block), "Brief Item"
     (a list item: the "1)" label half an inch in, a tab 0.9 in from the margin, the text hanging there; typst list-left,
     list-label), "Brief Quote" and "Brief Quote First" (a block quotation single-spaced, half an inch in on both sides,
     a blank single line above; L. Civ. R. 7(a)(5) exempts block quotes), Footnote Text without keepLines (typst
     splits a long note across pages). docx/motion-brief.lua writes the cover, the headings, the tables, the signature
     block, the certification and the sections (letter page, 1 in margins; the page number 0.5 in above the bottom
     edge, footer distance 720, typst footer-descent 22.2 pt). Twips: 20 x pt. pandoc-from: CommonMark with smart
     punctuation and footnotes, as typst's cmarker reads the body. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="552" single="276" indent="720" note="230" note-size="20" note-after="80" footer="720" pandoc-from="commonmark+smart+footnotes+yaml_metadata_block">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextKeep"><w:name w:val="Body Text Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BriefItem"><w:name w:val="Brief Item"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1296"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="552" w:lineRule="exact"/><w:ind w:left="1296" w:hanging="576"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BriefQuote"><w:name w:val="Brief Quote"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="0" w:line="276" w:lineRule="exact"/><w:ind w:left="720" w:right="720" w:firstLine="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BriefQuoteFirst"><w:name w:val="Brief Quote First"/><w:basedOn w:val="BriefQuote"/><w:qFormat/><w:pPr><w:spacing w:before="276" w:after="0" w:line="276" w:lineRule="exact"/></w:pPr></w:style>
<w:style w:type="paragraph" w:styleId="FootnoteText"><w:name w:val="Footnote Text"/><w:basedOn w:val="Normal"/><w:next w:val="FootnoteText"/><w:uiPriority w:val="9"/><w:unhideWhenUsed/><w:qFormat/><w:pPr><w:widowControl/><w:spacing w:before="0" w:after="80" w:line="230" w:lineRule="exact"/></w:pPr><w:rPr><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr></w:style>
</reference>
