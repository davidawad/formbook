<?xml version="1.0" encoding="UTF-8"?>
<!-- The ctd complaint Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md,
     "Cross-engine gate") in the face of the typst template ({font}, Times New Roman; no rule names a face, CTD-FORM-006)
     at 12 pt (size 24 half points; CTD-FORM-010, L. Civ. R. 7(a)(5)); Body Text in exact 27.6 pt line boxes (552
     twips, typst pitch-body; L. Civ. R. 10: "double-spaced") with a half-inch first-line indent (typst para-indent);
     single lines in 13.8 pt boxes (276 twips, typst pitch-single); letter page, 1 in margins (L. Civ. R. 10). Added
     here, as the typst template sets them: "Numbered Paragraph" (Fed. R. Civ. P. 10(b): the number half an inch in, a
     tab 1 in from the margin, the text; typst number-box) and "Pleading Item" (a list item's label half an inch in,
     the text hanging 1 in from the margin; typst list-indent, label-box). docx/complaint.lua writes the court title,
     the caption, the headings and the signature block with their own spacing, and the last section: no number on
     page 1, then the page number centred in a 13.8 pt line box 0.5 in above the bottom edge (footer distance 720;
     typst footer-descent 22.2 pt; L. Civ. R. 10). Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="552" single="276" indent="720" footer="720">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="NumberedParagraph"><w:name w:val="Numbered Paragraph"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="552" w:lineRule="exact"/><w:ind w:firstLine="720"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="PleadingItem"><w:name w:val="Pleading Item"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="552" w:lineRule="exact"/><w:ind w:left="1440" w:hanging="720"/></w:pPr></w:style>
</reference>
