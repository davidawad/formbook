// Memorandum of law in support of a motion for the U.S. District Court for the District of Minnesota (mnd), on the
// generic FRCP brief with D. Minn.'s local rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and
// docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced
// breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LR 7.1(h)(1) sets the size (13 point) and names no face; LR 7.1(f)(1)(A) distinguishes only proportional from
// monospaced faces: Times New Roman, the house standard and the exemplar's face (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let mnd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
