<!-- The Nebraska Bankruptcy adversary complaint's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in
     the face of the typst template ({font}, Times New Roman) at 12 pt (size 24 half points); Body Text and the headings
     in exact 27.6 pt line boxes (typst pitch-double, the exemplar's double spacing) with a half-inch first-line indent;
     footnotes 11 pt (22 half points) in exact 12.65 pt boxes (253 twips, typst pitch-note), 7 pt after each (typst
     footnote.entry gap); letter page with 1-inch margins and a centered page number, its line 36.75 pt above the page
     foot (735 twips: where typst sets it, footer-descent 30 %). The caption, title, signature and the lettered prayer
     items are written by docx/nebraskab-adversary-complaint.lua with their own spacing.
     "Body Text Last": the body paragraph before the signature, with the double line above the signature block after it (typst drops that space at the top of a page; Word keeps a table's space before there). Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="552" single="276" indent="720" heading="552" heading-before="0" heading-after="0" note="253" note-size="22" note-after="140" footer="735">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextLast"><w:name w:val="Body Text Last"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="552" w:line="552" w:lineRule="exact"/></w:pPr></w:style>
</reference>
