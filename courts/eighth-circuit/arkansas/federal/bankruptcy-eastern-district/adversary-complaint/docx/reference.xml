<?xml version="1.0" encoding="UTF-8"?>
<!-- The areb Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md, "Cross-engine
     gate") in the face of the typst template (Times New Roman) at 12 pt (size 24 half points; AREB-FORM-004,
     convention); Body Text in exact 22.2 pt line boxes (typst pitch-body, about double spaced) with a half-inch
     first-line indent (typst paragraph-indent); footnotes and quotations in 13.2 pt boxes (typst pitch-single);
     letter page, 1 in margins (AREB-FORM-003)
     and a centred page-number footer. Added here: "Numbered Paragraph" (FRCP 10(b): a half-inch first-line indent and
     7.2 pt below, typst numbered-below), "Body Text Note" (Body Text without widow control, for a paragraph that
     anchors a footnote: typst moves the line with the mark to the next page alone when its note does not fit), and
     the three heading levels as the typst template sets them (printed as written, no capitals; h1 centred bold,
     h2 bold, h3 italic; a 22.2 pt line, the space above and below of typst heading-space). Caption, signature and
     certificate carry their own spacing (docx/areb.lua). Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="444" single="264" indent="720" quote="240" note-after="120">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="NumberedParagraph"><w:name w:val="Numbered Paragraph"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="144" w:line="444" w:lineRule="exact"/><w:ind w:firstLine="720"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyTextNote"><w:name w:val="Body Text Note"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:widowControl w:val="0"/></w:pPr></w:style>
<w:style w:type="paragraph" w:styleId="Heading1"><w:name w:val="heading 1"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="288" w:after="240" w:line="444" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:jc w:val="center"/><w:outlineLvl w:val="0"/></w:pPr><w:rPr><w:b/><w:bCs/><w:color w:val="000000"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
<w:style w:type="paragraph" w:styleId="Heading2"><w:name w:val="heading 2"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="264" w:after="216" w:line="444" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:outlineLvl w:val="1"/></w:pPr><w:rPr><w:b/><w:bCs/><w:color w:val="000000"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
<w:style w:type="paragraph" w:styleId="Heading3"><w:name w:val="heading 3"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="240" w:after="192" w:line="444" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:outlineLvl w:val="2"/></w:pPr><w:rPr><w:i/><w:iCs/><w:color w:val="000000"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
</reference>
