// Brief in support of a motion (to dismiss) for the U.S. District Court for the District of South Dakota (sdd), on
// the generic FRCP brief with D.S.D.'s local rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and
// docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced
// breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// LR 83.4 sets only a minimum ("Fonts must be at least 12-point") and names no face: Times New Roman, the house
// standard (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let sdd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
