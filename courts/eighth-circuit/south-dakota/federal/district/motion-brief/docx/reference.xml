<?xml version="1.0" encoding="UTF-8"?>
<!-- The D.S.D. motion brief's Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs) in the face of the
     typst template ({font}, Times New Roman) at 12 pt (D.S.D. Civ. LR 83.4: at least 12 point, footnotes too; size 24
     half points); Body Text in exact 27.6 pt line boxes (typst pitch-double, LR 83.4 double-spaced) with a half-inch
     indent; headings, footnotes, caption, signature and footer lines in 13.8 pt boxes (typst pitch-single; LR 83.4:
     headings and footnotes single-spaced), 12 pt above and below a heading (typst heading-space), 7 pt after each
     footnote (typst note-gap); letter page with 1-inch margins (LR 83.4) and a centered page number, its line
     36.75 pt above the page foot (735 twips: where typst sets it, footer-descent 30 %). One style is added: Body Keep,
     the last paragraph before the signature block, kept with it and a double line above it (typst signature-block
     above). docx/sdd-motion-brief.lua writes the other paragraphs' own spacing. Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="552" single="276" indent="720" heading="276" heading-before="240" heading-after="240" note-after="140" footer="735">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="BodyKeep"><w:name w:val="Body Keep"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="0" w:after="552" w:line="552" w:lineRule="exact"/></w:pPr></w:style>
</reference>
