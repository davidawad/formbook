<?xml version="1.0" encoding="UTF-8"?>
<!-- The ianb adversary-complaint Word styles: the cross-engine recipe (tools/fb/src/docxxengine.rs; docs/EVAL-LOOP.md,
     "Cross-engine gate") in the face of the typst template ({font}) at 12 pt (size 24 half points; README, gap 2);
     Body Text in exact 24 pt line boxes (typst pitch-body, double spaced) with a half-inch first-line indent (typst
     para-indent); single lines 13.8 pt (typst pitch-single). Added here: "Plain Paragraph" (an unnumbered body
     paragraph, 7.2 pt below, typst plain-below), "Numbered Paragraph" (FRCP 10(b): the number at the half-inch indent,
     a tab to 1200 twips, typst num-box), "Prayer Item" (the letter at the half-inch indent, the text hanging at 1 in,
     7.2 pt below, typst item-below), and the two heading levels as the typst template sets them (printed as written,
     no capitals; centred bold in a 24 pt line, 12 pt above and 8.4 pt below, typst heading-above/heading-below).
     The page: letter, 1 in margins and 1 in + 4 pt at the top (typst page-margin), a centred "Page X of Y" footer at
     10 pt in a 12 pt line whose foot is 38.4 pt above the page edge (where typst footer-descent 30 % sets it). Caption and signature carry their own
     spacing (docx/ianb-adversary-complaint.lua). Twips: 20 x pt. -->
<reference xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" base="xengine" size="24" body="480" single="276" indent="720" heading="480" heading-before="240" heading-after="168">
<w:style w:type="paragraph" w:customStyle="1" w:styleId="PlainParagraph"><w:name w:val="Plain Paragraph"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:spacing w:before="0" w:after="144" w:line="480" w:lineRule="exact"/><w:ind w:firstLine="720"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="NumberedParagraph"><w:name w:val="Numbered Paragraph"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1200"/></w:tabs><w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="exact"/><w:ind w:firstLine="720"/></w:pPr></w:style>
<w:style w:type="paragraph" w:customStyle="1" w:styleId="PrayerItem"><w:name w:val="Prayer Item"/><w:basedOn w:val="BodyText"/><w:qFormat/><w:pPr><w:tabs><w:tab w:val="left" w:pos="1440"/></w:tabs><w:spacing w:before="0" w:after="144" w:line="480" w:lineRule="exact"/><w:ind w:left="1440" w:hanging="720"/></w:pPr></w:style>
<w:style w:type="paragraph" w:styleId="Heading1"><w:name w:val="heading 1"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="240" w:after="168" w:line="480" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:jc w:val="center"/><w:outlineLvl w:val="0"/></w:pPr><w:rPr><w:b/><w:bCs/><w:color w:val="000000"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
<w:style w:type="paragraph" w:styleId="Heading2"><w:name w:val="heading 2"/><w:basedOn w:val="Normal"/><w:next w:val="BodyText"/><w:qFormat/><w:pPr><w:keepNext/><w:keepLines/><w:spacing w:before="240" w:after="168" w:line="480" w:lineRule="exact"/><w:ind w:firstLine="0"/><w:jc w:val="center"/><w:outlineLvl w:val="1"/></w:pPr><w:rPr><w:b/><w:bCs/><w:color w:val="000000"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:style>
