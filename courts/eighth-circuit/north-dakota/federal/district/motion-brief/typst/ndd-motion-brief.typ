// Memorandum in support of a motion (to dismiss) for the U.S. District Court for the District of North Dakota (ndd),
// on the generic FRCP brief with D.N.D.'s local rules overlaid (typst/layout.yaml: `base:
// /lib/layouts/frcp-motion-brief.yaml`, fb-595.17), set by the shared document model (lib/typst/xdoc.typ; latex/ and
// docx/ generated by `fb engines gen`). Content-agnostic: no case-specific text, measured coordinates or forced
// breaks. See ../README.md.
#import "/lib/typst/xdoc.typ": xdoc, split-frontmatter

// Civil Rule 5.1(B)(2) sets a size ("12-point font or larger"), not a face: Times New Roman, the house standard and
// the exemplars' face (docs/FONTS.md). Vendored in /fonts.
#let font-family = ("Times New Roman", "Liberation Serif")

#let ndd-motion-brief(meta, body) = xdoc(yaml("layout.yaml") + (font: font-family), meta, body)
