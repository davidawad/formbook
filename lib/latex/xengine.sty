% lib/latex/xengine.sty: the cross-engine layout model for pdfLaTeX (docs/EVAL-LOOP.md, "Cross-engine gate";
% fb-595.54, fb-595.54.1). The typst render (lib/typst/xengine.typ) is the reference; with this preamble a LaTeX
% template breaks every line and page where typst and Word (lib/docx/xengine.lua) break them.
%
% A template loads it with `\usepackage{xengine}` after its font and other packages. fb render (tools/fb,
% engines.rs) inlines this file into the generated doc.tex in place of that line, so the .tex still compiles alone
% with stock pdflatex (the interop rule: no repo-local file). Stock pdfTeX and LaTeX kernel commands only.
%
% What it sets:
%   * the same glyph widths: no kerning and no ligatures (\pdfnoligatures turns both off; typst and Word set
%     neither); give every size in bp (14 bp = typst's 14 pt: \xe@lines does);
%   * first-fit line breaking: a fil right skip makes every line equally good, interword spaces neither stretch nor
%     shrink, and every break costs nothing, so TeX's optimum is the greedy one (of the breakings with the fewest
%     lines it keeps the one whose lines come latest); no hyphenation; a break after an explicit hyphen is free
%     (lib/latex/xengine.lua keeps a hyphen before a digit unbreakable, as Unicode line breaking does);
%   * fixed line boxes: every line is \pdfeachlineheight + \pdfeachlinedepth high, the baseline at 0.8 of its pitch
%     (Word's exact line spacing); boxes touch (\lineskip 0, \baselineskip 0); the first box of a page starts at the
%     top of the text block and the last must end inside it (\topskip 0, \maxdepth 0); the template spaces blocks
%     with \addvspace (the larger of the space below one and above the next, dropped at the top of a page);
%   * no widows or orphans, in the text and in footnotes (LaTeX resets the line-box settings inside a footnote,
%     \@parboxrestore: they are set back here).
% What it provides:
%   \xe@lines{<size>}{<pitch>}   select the type size and the line box of a pitch, both numbers in bp;
%   \xe@footnotemarks{<size>}     footnote marks at 58 % of type size <size> (bp), raised 29 % (typst super,
%                                 LibreOffice's superscript): defines \xe@mark{<text>} and \@makefnmark;
%   \xe@lists{<width>}            list labels in a box of <width> at the margin, the text hanging after it, no space
%                                 of their own (needs enumitem);
%   \xe@natural                   a line that holds boxes (columns of minipages, as on a cover) keeps its natural
%                                 height: \pdfeachlineheight and \pdfeachlinedepth unset; the boxes set their own
%                                 lines (call \xe@lines inside them again);
%   \xe@row{<above>}{<hang>}{<text>}{<page>}   one row of a table of contents or authorities: the text wraps before
%                                 a column of width \xe@col kept for the page, a dot leader (\xe@leader, at least
%                                 three spaces, tied to the text) runs to the page on the last line; not split;
%   \xe@portionsinit, \xeportions{true|false}   Word's text portions: each \emph and \textbf end floored to a twip,
%                                 as LibreOffice measures its runs (below; fb-595.54.10).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{xengine}[2026/10/21 cross-engine layout model]

% No kerning, no ligatures, interword spaces of fixed width in every font as it is selected.
\AddToHook{selectfont}[xengine]{\pdfnoligatures\font\fontdimen3\font=0pt\fontdimen4\font=0pt\fontdimen7\font=0pt}
\frenchspacing
% First-fit breaking: no hyphenation; a break after an explicit hyphen costs nothing; no demerits that would make one
% breaking better than another.
\lefthyphenmin=100
\righthyphenmin=100
\hyphenpenalty=10000
\exhyphenpenalty=0
\pretolerance=10000
\tolerance=10000
\adjdemerits=0
\doublehyphendemerits=0
\finalhyphendemerits=0
\hbadness=10000
\vbadness=10000
\emergencystretch=0pt
% Fixed line boxes, touching.
\baselineskip=0pt
\lineskip=0pt
\lineskiplimit=\maxdimen
\setlength{\topskip}{0pt}
\setlength{\maxdepth}{0pt}
\raggedbottom
% No widows or orphans (Word's widow control; typst's default).
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000
\interlinepenalty=0
\brokenpenalty=0
\raggedright
\setlength{\parskip}{0pt}
% Footnotes: the same line boxes (\@parboxrestore sets \lineskip and \baselineskip from these), no widows.
\setlength{\footnotesep}{0pt}
\normallineskip=0pt
\normalbaselineskip=0pt
\interfootnotelinepenalty=10000

\newcommand\xe@lines[2]{%
  \fontsize{#1bp}{0bp}\selectfont\pdfeachlineheight=\fpeval{0.8*(#2)}bp\relax\pdfeachlinedepth=\fpeval{0.2*(#2)}bp\relax}

% pdfTeX's "unset" is -2^30 sp, which no dimension can spell: it is kept from the start, before \xe@lines sets any.
\newdimen\xe@unset \xe@unset=\pdfeachlineheight
\newcommand\xe@natural{\pdfeachlineheight=\xe@unset\pdfeachlinedepth=\xe@unset}

\newcommand\xe@footnotemarks[1]{%
  \edef\xe@mark##1{\noexpand\raisebox{\fpeval{0.29*(#1)}bp}{\noexpand\fontsize{\fpeval{0.58*(#1)}bp}{0bp}%
    \noexpand\selectfont ##1}}%
  \renewcommand\@makefnmark{\hbox{\normalfont\xe@mark{\@thefnmark}}}}

\newcommand\xe@lists[1]{%
  \setlist{itemsep=0pt, parsep=0pt, topsep=0pt, partopsep=0pt, leftmargin=#1, labelwidth=#1, labelsep=0pt,
    align=left, listparindent=0pt, itemindent=0pt}%
  \setlist[itemize]{label=\textbullet}}

\newlength\xe@col
\newcommand\xe@leader{\nobreak\hskip0.75em\leaders\hbox{.}\hskip 0pt plus 1fill}
\newcommand\xe@row[4]{%
  \par\addvspace{#1}%
  \begingroup\interlinepenalty=10000\relax
  \noindent\hangindent=#2\relax\hangafter=1\relax
  \rightskip=\dimexpr\xe@col\relax plus 1fil\relax\parfillskip=-\dimexpr\xe@col\relax\relax
  #3\xe@leader\hbox to \xe@col{\hss#4}\par\endgroup}

% Word's text portions (fb-595.54.10; lib/typst/xengine.typ, docx-portions, where the measurement is): LibreOffice
% sets a run of like formatting it lays out whole in whole twips, rounded down, so the text after the run starts at
% its end floored to a twip, and a line fits iff those floored widths and the unrounded width of its last run sum to
% no more than the measure. Under \xeportions{true} each \emph and \textbf does the same at both its ends: it saves
% its position there (\pdfsavepos, written to the .aux), and on the next pass a box of a negative kern moves what
% follows left by what the position lay past a whole twip (the line starts on one: the margins and indents are whole
% twips). A box adds no break point, and the kern is a box's, so a break after it keeps it. The shifts of a line are
% recomputed together from the positions and shifts of the last pass (the boundaries of a line: those on the same
% page at the same baseline), so they settle a pass after the line breaks do; fb render runs pdflatex until the .aux
% settles. \xeportions{false} turns it off again (the template scopes it to the text its typst template scopes it to).
\newif\ifxe@portions
\newcommand\xeportions[1]{\csname xe@portions#1\endcsname}
\newcount\xe@twn
\def\xe@twip{3289.088}% one twip, 1/20 bp, in sp
\gdef\xe@twline{}\gdef\xe@twold{0}\gdef\xe@twnew{0}
% \xe@twpos{<n>}{<page>}{<x>}{<y>}{<shift>}: boundary n as the last pass shipped it (positions and shift in sp),
% read from the .aux in order; it sets \xe@tw@<n>, the shift of boundary n on this pass.
\def\xe@twpos#1#2#3#4#5{%
  \def\xe@tmp{#2:#4}%
  \ifx\xe@tmp\xe@twline\else\global\let\xe@twline\xe@tmp\gdef\xe@twold{0}\gdef\xe@twnew{0}\fi
  \edef\xe@tmp{\fpeval{#3+\xe@twold-\xe@twnew}}%
  \edef\xe@tmp{\fpeval{max(0, round(\xe@tmp-floor(\xe@tmp/\xe@twip+0.001)*\xe@twip))}}%
  \expandafter\xdef\csname xe@tw@#1\endcsname{\xe@tmp}%
  \xdef\xe@twold{\fpeval{\xe@twold+#5}}\xdef\xe@twnew{\fpeval{\xe@twnew+\xe@tmp}}}
\AtEndDocument{\gdef\xe@twpos#1#2#3#4#5{}}
\def\xe@tw{\ifxe@portions\ifhmode
  \global\advance\xe@twn\@ne
  \edef\xe@s{\ifcsname xe@tw@\the\xe@twn\endcsname\csname xe@tw@\the\xe@twn\endcsname\else 0\fi}%
  \pdfsavepos
  \edef\xe@tmp{\write\@auxout{\string\xe@twpos{\the\xe@twn}{\noexpand\the\noexpand\ReadonlyShipoutCounter}%
    {\noexpand\the\pdflastxpos}{\noexpand\the\pdflastypos}{\xe@s}}}\xe@tmp
  \hbox{\kern-\xe@s sp}%
\fi\fi}
% \xe@portionsinit, in the preamble of a template that uses \xeportions: \emph and \textbf as the document begins
% with them, their boundaries inside the argument (so the italic correction still sees the token after it).
\newcommand\xe@portionsinit{\AtBeginDocument{%
  \NewCommandCopy\xe@emph\emph\DeclareRobustCommand\emph[1]{\xe@emph{\xe@tw##1\xe@tw}}%
  \NewCommandCopy\xe@textbf\textbf\DeclareRobustCommand\textbf[1]{\xe@textbf{\xe@tw##1\xe@tw}}}}
