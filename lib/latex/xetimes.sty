% lib/latex/xetimes.sty: newtx's Times at Times New Roman's advance widths, for a template on the cross-engine layout
% model (docs/EVAL-LOOP.md, "Cross-engine gate"; lib/latex/xengine.sty) that sets Times with newtxtext (T1).
% typst and Word set Times New Roman 2.82 (the pinned install, data/render-pin.json), whose advances are whole
% 2048ths of an em; TeXGyreTermesX's are whole 1000ths, so nearly every glyph is a few ten-thousandths of an em wider
% or narrower (a: 909/2048 = 443.85/1000 em, newtx 444), and a line of them moves by up to about 0.07 pt at 14 pt.
% That is enough to end a line a word earlier or later than typst does, and to move the end of an italic run across
% the twip LibreOffice floors it to (xengine.sty, \xeportions; fb-595.54.84).
% Here every character of a newtx text face (ntxtlf, T1; upright or italic, medium or bold) gets the difference as a
% kern after it (pdfTeX \pdfappendkern, \knaccode; \knbccode for a difference past the after-kern's range), so each
% glyph advances as far as Times New Roman's, the line breaks and every position on the line with it. The PDF keeps
% newtx's glyphs and text. pdfTeX gives such a kern in thousandths of the font's quad (\fontdimen6), read as each
% character is set, so the quad of each adjusted font is set to a hundredth of an em: a step of 1/100000 em, at most
% 0.01 em a kern. The design em stays in \xe@em (a dimen, set as each font is selected): a template writes a
% space in em as a multiple of \xe@em, never `em`. Characters whose newtx and Times New Roman advances differ by more
% than 0.02 em (d, l and t with caron, Eng, the IJ ligature, the italic inverted exclamation mark) keep newtx's
% advance.
% The table is Times New Roman's advance of each T1 slot, in 2048ths of an em, for the regular, italic, bold and
% bold italic faces; tools/gen-xetimes.sh writes it from the pinned fonts (the slot's character from newtx's own
% ToUnicode map). fb render inlines this file in place of \usepackage{xetimes}.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{xetimes}[2026/10/29 newtx at Times New Roman advances]

\pdfappendkern=1
\pdfprependkern=1
\newdimen\xe@em
\newcount\xe@k
\def\xe@ntx{T1/ntxtlf}
% \xe@tnr@col: the table's column for the face selected (2 regular, 3 italic, 4 bold, 5 bold italic), empty if none.
\def\xe@tnr@col{%
  \edef\xe@tmp{\f@series/\f@shape}%
  \def\xe@col@{}%
  \def\xe@a{m/n}\ifx\xe@tmp\xe@a\def\xe@col@{2}\fi
  \def\xe@a{m/it}\ifx\xe@tmp\xe@a\def\xe@col@{3}\fi
  \def\xe@a{b/n}\ifx\xe@tmp\xe@a\def\xe@col@{4}\fi
  \def\xe@a{bx/n}\ifx\xe@tmp\xe@a\def\xe@col@{4}\fi
  \def\xe@a{b/it}\ifx\xe@tmp\xe@a\def\xe@col@{5}\fi
  \def\xe@a{bx/it}\ifx\xe@tmp\xe@a\def\xe@col@{5}\fi}
% \xe@tnr@set{<slot>}{<advance>}: the kerns that take the slot's newtx advance to <advance>/2048 em.
\def\xe@tnr@set#1#2{%
  \xe@k=\fpeval{round((#2/2048-\the\fontcharwd\font#1/\the\fontdimen6\font)*100000)}\relax
  \ifnum\xe@k>2000 \else\ifnum\xe@k<-2000 \else
    \ifnum\xe@k>1000 \knbccode\font#1=\numexpr\xe@k-1000\relax\xe@k=1000 \fi
    \ifnum\xe@k<-1000 \knbccode\font#1=\numexpr\xe@k+1000\relax\xe@k=-1000 \fi
    \knaccode\font#1=\xe@k
  \fi\fi}
\def\xe@tnr@select{%
  \ifcsname xe@em@\fontname\font\endcsname
    \xe@em=\csname xe@em@\fontname\font\endcsname\relax
  \else
    \xe@em=\fontdimen6\font
    \expandafter\xdef\csname xe@em@\fontname\font\endcsname{\the\xe@em}%
    \edef\xe@tmp{\f@encoding/\f@family}%
    \ifx\xe@tmp\xe@ntx\xe@tnr@col\ifx\xe@col@\@empty\else
      \def\xe@do##1##2##3##4##5{\xe@tnr@set{##1}{\ifcase\xe@col@\or\or##2\or##3\or##4\or##5\fi}}%
      \xe@tnr@table
      \fontdimen6\font=0.01\fontdimen6\font
    \fi\fi
  \fi}
\AddToHook{selectfont}[xetimes]{\xe@tnr@select}
% xengine.sty's leader, its 0.75 em in the design em.
\renewcommand\xe@leader{\nobreak\hskip0.75\xe@em\leaders\hbox{.}\hskip 0pt plus 1fill}

